import OAI.ThreeFlat.RAM.GeneratedContraction
import OAI.ThreeFlat.RAM.ExpressionScan

namespace OAI
/-! # Native generation and contraction from a word expression -/

namespace ThreeFlat.RAM.GeneratedContraction

open Computability.VPVNP.BurstRAM BitLayout DescriptorExpr DescriptorScan Contraction Fin.CommRing

variable {w k : ℕ} {F : Type*} [Fintype F] [Field F] {p : ℕ}

def scratch (n : ℕ) : Fin n ↪ Fin (4+(10+n)) :=
  ⟨fun i => Fin.natAdd 4 (Fin.natAdd 10 i), fun i j h => by simpa using h⟩

private theorem scratch_fresh (n : ℕ) (i : Fin 4) (j : Fin n) :
    driverRegs (10+n) i ≠ scratch n j := by
  intro h
  have hval := congrArg Fin.val h
  change i.val = 4+(10+j.val) at hval
  omega

def expressionRows (e : Term w (2+(5+k)) 1) : Fin e.labels → Row w e.labels e.binds k :=
  let R := driverRegs (10+e.binds)
  e.emit (descriptorPc 35) (fun _ => R 0) (scratch e.binds) (R 2) (driverPc e.labels 35 4)

/-- Each local descriptor let costs two instructions, including conditional
selection. The array is generated by the expression from its absolute word
address. Words beyond the evaluator footprint may contain live source tables. -/
theorem value_eq_expression (N : BitNetwork F p) (fit : Fits N w)
    (e : Term w (2+(5+k)) 1) (pub : Fin k → Word w) (pin : Fin p → Bool)
    (hidden : Fin N.internal → Bool) (input : Memory w) (s : Word w) (extra : ℕ)
    (descriptor :
      let params := (machine N fit e.first (expressionRows e) pub).publicData
      ∀ (a : Word w) (m : Memory w), cellsBase p N.internal ≤ a.val →
        a.val < mulBase p N.internal N.cells →
        agreesOutside (cellsBase p N.internal) (mulBase p N.internal N.cells) m input →
        e.eval params m (fun _ => a) = memory N (codec N fit) pin hidden a.val)
    (outside : ∀ a < footprint N, a < cellsBase p N.internal ∨ mulBase p N.internal N.cells ≤ a →
      input a = memory N (codec N fit) pin hidden a) :
    value (codec N fit) (machine N fit e.first (expressionRows e) pub)
      (extra+13+5*N.internal+22*N.cells+(11*N.cells)*(2*e.binds+4)) s input = N.eval pin := by
  let M := machine N fit e.first (expressionRows e) pub
  let R := driverRegs (10+e.binds)
  let L := driverLabels e.first (0 : Fin 35)
  let lo := cellsBase p N.internal
  let hi := mulBase p N.internal N.cells
  let valid := scanInvariant (p:=e.labels+(6+35)) R lo hi input
  have check : Describes M R L e.steps (memory N (codec N fit) pin hidden) valid :=
    describes_expression M R L e (descriptorPc 35) (scratch e.binds) (scratch_fresh e.binds)
      rfl (fun i => assembled_descriptor e.first 0 (expressionRows e) evalRow _ _ _ i)
      lo hi input _ descriptor
  have hwlo : lo < 2^w := by simpa [lo,cellAddr] using cellAddr_lt N fit (Nat.zero_le N.cells)
  have hwhi : hi < 2^w := mulBase_lt N fit
  have ok : valid (initialized (d:=e.labels) (r:=e.binds) N s) input := by
    refine ⟨rfl, ?_, ?_, fun _ _ => rfl⟩
    · change lo ≤ ((lo : Word w) : ℕ)
      rw [Fin.val_cast_of_lt hwlo]
    · change ((hi : Word w) : ℕ) = hi
      exact Fin.val_cast_of_lt hwhi
  have h := value_eq N fit e.first (expressionRows e) pub e.steps pin hidden s input extra
    valid ok check outside
  simpa only [e.steps_eq, Nat.add_assoc] using h

end ThreeFlat.RAM.GeneratedContraction

end OAI
