import OAI.Computability.IntegerMultiplication.Strip.Narrow
import OAI.Computability.NearSquareRoot.InterchangeCalls
import OAI.Computability.NearSquareRoot.InterchangeTable

/-!
# Fixed finite banks of routed rows

Each backing row is a whole stream on a common address layout. Duplicating a
row, selecting a row, or combining aligned streams by a finite symbol table
takes P192 scans. Independent address programs charge the sum of their actual
pivot counts. The parent descriptor is made available at each successive
operation.
-/

namespace OAI
namespace Computability
namespace NearSquareRoot

namespace InterchangeBank

open IntegerMultiplication IntegerMultiplication.Code IntegerMultiplication.Strip
  IntegerMultiplication.Strip.Dims IntegerMultiplication.Port IntegerMultiplication.Adic
  IntegerMultiplication.Loom NearSquareRoot.InterchangeAddress

variable {I J A B F H : Type} {X : I → Type} {r : Regime I} {l : I → ℕ}

/-- A stripe of rows, each a stripe of encoded symbols in address order. -/
def bank (points : (i : I) → Series (X i)) (rows : Series A) (src : F → Tree)
    (x : (i : I) → A → X i → F) (i : I) : Tree :=
  stripe rows fun a => stripe (points i) fun k => src (x i a k)

theorem finite_manifest [Finite F] (enc : F → Tree) (x : (i : I) → X i → F) :
    Manifest X l (fun i k => enc (x i k)) := by
  obtain ⟨u, hu⟩ := (Set.finite_range (fun z => (enc z).count)).bddAbove
  refine ⟨u, fun i k => (hu (Set.mem_range_self (x i k))).trans ?_⟩
  simpa using Nat.mul_le_mul_left u (Nat.succ_le_succ (Nat.zero_le (l i)))

theorem bank_alive [Finite F] (points : (i : I) → Series (X i)) (hs : Station r points)
    (rows : Series A) (src : F → Tree) (x : (i : I) → A → X i → F) :
    Alive r (fun i => (points i).count) l (bank points rows src x) :=
  Fatigue.entire rows _ hs.1 fun a => (finite_manifest src (fun i => x i a)).lives hs

private theorem linear_rip {s t : I → Tree} (N : I → ℕ) (hN : ∀ i, 1 ≤ N i)
    (h : Carries (fun i => (N i : ℝ) + 1) s t) : Rip r N l s t := by
  refine ⟨0, h.times (unit_mass hN 0) 2 fun i => ?_⟩
  have hn : (1 : ℝ) ≤ N i := by exact_mod_cast hN i
  simp only [mass, pow_zero, Nat.cast_ofNat]
  nlinarith [Nat.cast_nonneg (α := ℝ) (l i), mul_nonneg (Nat.cast_nonneg (α := ℝ) (N i)) (Nat.cast_nonneg (α := ℝ) (l i))]

/-- A finite table acting across aligned rows. The empty-input table is
generated by reading the point count in the descriptor. -/
theorem table [Finite A] [Finite F] (points : (i : I) → Series (X i)) (hs : Station r points)
    (rows : Series A) (out : Series B) (src : F → Tree) (dst : H → Tree)
    (hinj : Function.Injective src) (x : (i : I) → A → X i → F) (τ : (A → F) → B → H) :
    Drive r (fun i => (points i).count) l (bank points rows src x)
      (bank points out dst (fun i b k => τ (fun a => x i a k) b)) := by
  classical
  have alive := bank_alive (l:=l) points hs rows src x
  by_cases hA : Nonempty A
  · exact (Drive.self hs.1 alive).chain (linear_rip _ hs.1
      (interchange_aligned_table points rows out x src dst hinj τ))
  · let z : A → F := fun a => (hA ⟨a⟩).elim
    have hz (i : I) (k : X i) : (fun a => x i a k) = z := funext fun a => (hA ⟨a⟩).elim
    simp_rw [hz]
    have make : Drive r (fun i => (points i).count) l (bank points rows src x)
        (stackRun points fun _ _ => Tree.atom false) := by
      obtain ⟨u, hu⟩ := hs.supply (l:=l) fun _ => le_rfl
      exact (Drive.fetch hs.1 alive).chain ⟨u, seeds points hu⟩
    apply Fatigue.dry out _ (Rip.alivePair (Drive.started hs.1) alive)
    intro b
    have run := interchange_record_table (F:=Unit) points (fun _ _ => ()) (fun _ => Tree.atom false)
      (fun _ => dst (τ z b)) (by intro u v _; exact Subsingleton.elim u v)
    exact make.chain (linear_rip _ hs.1 run)

/-- Preserve the descriptor when two charged programs are run in sequence. -/
theorem sequence {Y : Type} {job : Job Y} {N : I → ℕ} {zone : I → Y → Prop}
    {p q s : I → Tree} {u v : ℤ} (pos : ∀ i, 1 ≤ N i)
    (hp : Alive r N l p) (hq : Alive r N l q)
    (h : Hopto job r N l zone u (together r.header p) q)
    (g : Hopto job r N l zone v (together r.header q) s) :
    Hopto job r N l zone (u+v) (together r.header p) s := by
  have hh := Drive.started (r:=r) (l:=l) pos
  have all := (Hopto.tarry (Drive.fetch pos hp)).doubleg h (Rip.alivePair hh hp) hh hq
  simpa only [Int.zero_add] using all.chain g

/-- Compute each output from a selected whole input stream, paying the sum of
the row programs. Selection may duplicate rows. The per-row programs have
access to the common descriptor. -/
theorem collect [Fintype B] {Y : Type} {job : Job Y} {N : I → ℕ} {zone : I → Y → Prop}
    (pos : ∀ i, 1 ≤ N i) (rows : Series A) (out : Series B)
    (x : I → A → Tree) (y : I → B → Tree) (sel : B → A) (cost : B → ℕ)
    (hx : ∀ a, Alive r N l (fun i => x i a)) (hy : ∀ b, Alive r N l (fun i => y i b))
    (hr : ∀ b, Hopto job r N l zone (cost b) (together r.header (fun i => x i (sel b)))
      (fun i => y i b)) :
    Hopto job r N l zone (∑ b, (cost b : ℤ)) (together r.header (stackRun (fun _ => rows) x))
      (stackRun (fun _ => out) y) := by
  have ha := Fatigue.entire rows x pos hx
  have hh := Drive.started (r:=r) (l:=l) pos
  apply Hopto.finite out _ (fun b => Int.natCast_nonneg _) _ _ (Rip.alivePair hh ha) hy pos
  intro b
  exact (hr b).preceded ((Fatigue.drill rows x ha (sel b)).right hh)

variable [DecidableEq J] {n p : ℕ} [NeZero p] (ord : J ≃ Fin n)
    (P G S : I → Dims.Tape) (f : I → ℕ)

/-- Execute separately routed rows in a bank. Each charged interchange
request retains the same stream volume and current field width. -/
theorem route [Fintype B] [Finite F] (hb : 2 ≤ p) (hf : r.Has (tally ∘ f))
    (hp : Told r P) (hg : Told r G) (hs : Told r S)
    (rows : Series A) (out : Series B) (src : F → Tree)
    (x : (i : I) → A → domain (J:=J) (b:=p) P G S f i → F)
    (sel : B → A) (ops : B → List (Lag J p))
    (legal : ∀ b u, u ∈ ops b → u.legal (ranking ord)) :
    Charged (r:=r) (b:=p) (l:=l) ord P G S f (∑ b, ((ops b).map Lag.prices).sum)
      (bank (layoutRows ord P G S f) rows src x)
      (bank (layoutRows ord P G S f) out src (fun i b k => x i (sel b)
        ((recreation ord (P i) (G i) (S i) (f i) (ops b) (legal b)).symm k))) := by
  let points := layoutRows (b:=p) ord P G S f
  have st := layoutRows_station ord P G S f hb hf hp hg hs
  let perm i b := recreation ord (P i) (G i) (S i) (f i) (ops b) (legal b)
  let y i b := x i (sel b) ∘ (perm i b).symm
  let source i a := stripe (points i) (src ∘ x i a)
  let target i b := stripe (points i) (src ∘ y i b)
  have hx a := (finite_manifest (l:=l) src (fun i => x i a)).lives st
  have hy b := (finite_manifest (l:=l) src (fun i => y i b)).lives st
  have h := collect st.1 rows out source target sel (fun b => ((ops b).map Lag.prices).sum)
    hx hy (fun b => execute_charged ord P G S f hb hf hp hg hs (ops b) (legal b)
      (fun i => src ∘ x i (sel b)) (finite_manifest _ _))
  unfold Charged
  simp only [Nat.cast_sum]
  exact h

end InterchangeBank

