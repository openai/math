import OAI.Computability.NearSquareRoot.PhysicalWalshChecked
import Mathlib.Basic.Real.Basic
import Mathlib.Tactic.Positivity
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.GCongr

/-! # Guarded forward-error propagation through an arbitrary physical plan

The two operations interpret exactly the same syntax on record rows and ideal
rows. Serial evaluation checks the next guard on the actual rounded bank.
Parallel evaluation splits and concatenates banks in the compiler's order.
The factor depends only on the frozen template and its primitive gains.
-/

namespace OAI
namespace Computability
namespace NearSquareRoot

namespace PhysicalWalsh

open KernelPass

variable {A : ℕ} {U H R H' R' : Type}
variable {l : Layout U H R} {v : Layout U H' R'}

abbrev LeafFactor (A : ℕ) := ∀ {i o}, Plan A i o → ℕ

/-- A strictly positive, dimension-independent numerical budget for the plan. -/
def numericalFactor (cost : LeafFactor A) : ∀ {i o}, Plan A i o → ℕ
  | _, _, .seq p q => numericalFactor cost p * (numericalFactor cost q + 1)
  | _, _, .parallel p q => max (numericalFactor cost p) (numericalFactor cost q)
  | _, _, p => cost p + 1

theorem numericalFactor_pos (cost : LeafFactor A) {i o} (p : Plan A i o) :
    0 < numericalFactor cost p := by
  induction p with
  | mix | xor | scale | child => exact Nat.zero_lt_succ _
  | seq _ _ hp _ => exact Nat.mul_pos hp (Nat.zero_lt_succ _)
  | parallel _ _ hp _ => exact hp.trans_le (le_max_left _ _)

variable (f : Ops A l) (g : Ops A v) (guards : Guards A l) (u : U)
    (rowSize : v.Row u → ℝ) (gap : l.Row u → v.Row u → ℝ)

def BankBall {n : ℕ} (x : Rows l u n) (y : Rows v u n) (B e : ℝ) : Prop :=
  ∀ j, rowSize (y j) ≤ B ∧ gap (x j) (y j) ≤ e

/-- The available headroom covers intermediates generated by this particular
program. Both the output norm and the distance from the ideal output are tracked. -/
def NumericalStep {i o} (p : Plan A i o) (K cap δ : ℝ) : Prop :=
  ∀ (x : Rows l u i) (y : Rows v u i) (B e : ℝ), 0 ≤ B → 0 ≤ e →
    K * (B + e + δ) ≤ cap → BankBall u rowSize gap x y B e →
    Ready f guards p u x ∧ BankBall u rowSize gap (f.applyPlan p u x)
      (g.applyPlan p u y) (K * B) (K * (e+δ))

/-- Local bounds at the leaves suffice for every reached record bank and
every output lane of the physical plan, including nested parallel branches. -/
theorem planNumericalStep (cost : LeafFactor A) {cap δ : ℝ} (hδ : 0 ≤ δ)
    (leaves : ∀ {i o} (p : Plan A i o), isLeaf p = true →
      NumericalStep f g guards u rowSize gap p (numericalFactor cost p) cap δ)
    {i o} (p : Plan A i o) :
    NumericalStep f g guards u rowSize gap p (numericalFactor cost p) cap δ := by
  induction p with
  | mix c => exact leaves _ rfl
  | xor c => exact leaves _ rfl
  | scale q t c => exact leaves _ rfl
  | child a => exact leaves _ rfl
  | seq p q ihp ihq =>
    intro x y B e hB he capBound bank
    let P : ℝ := numericalFactor cost p
    let Q : ℝ := numericalFactor cost q
    have hp : 1 ≤ P := by
      dsimp only [P]
      exact_mod_cast (show 1 ≤ numericalFactor cost p from numericalFactor_pos cost p)
    have hq : 1 ≤ Q := by
      dsimp only [Q]
      exact_mod_cast (show 1 ≤ numericalFactor cost q from numericalFactor_pos cost q)
    have pf : (numericalFactor cost (.seq p q) : ℝ) = P*(Q+1) := by simp [P,Q,numericalFactor]
    rw [pf] at capBound ⊢
    have ht : 0 ≤ B + e + δ := by linarith
    have hfac : Q ≤ P*(Q+1) := by nlinarith
    obtain ⟨rq,bq⟩ := ihq x y B e hB he ((mul_le_mul_of_nonneg_right hfac ht).trans capBound) bank
    have hnew : P*(Q*B + Q*(e+δ) + δ) ≤ cap := by
      calc
        _ ≤ P*((Q+1)*(B+e+δ)) := by gcongr; nlinarith
        _ = _ := (mul_assoc ..).symm
        _ ≤ _ := capBound
    obtain ⟨rp,bp⟩ := ihp _ _ _ _ (mul_nonneg (by linarith : 0 ≤ Q) hB)
      (mul_nonneg (by linarith : 0 ≤ Q) (by linarith : 0 ≤ e+δ)) hnew bq
    refine ⟨⟨rq,rp⟩,fun j => ⟨(bp j).1.trans ?_,(bp j).2.trans ?_⟩⟩
    · change P*(Q*B) ≤ P*(Q+1)*B
      rw [mul_assoc]
      gcongr
      nlinarith
    · change P*(Q*(e+δ)+δ) ≤ P*(Q+1)*(e+δ)
      rw [mul_assoc]
      gcongr
      nlinarith
  | @parallel i j o b p q ihp ihq =>
    intro x y B e hB he capBound bank
    let K : ℝ := numericalFactor cost (.parallel p q)
    have hp : (numericalFactor cost p : ℝ) ≤ K := by
      dsimp only [K,numericalFactor]
      exact_mod_cast (le_max_left (numericalFactor cost p) (numericalFactor cost q))
    have hq : (numericalFactor cost q : ℝ) ≤ K := by
      dsimp only [K,numericalFactor]
      exact_mod_cast (le_max_right (numericalFactor cost p) (numericalFactor cost q))
    have ht : 0 ≤ B + e + δ := by linarith
    obtain ⟨rp,bp⟩ := ihp (fun t => x (t.castAdd j)) (fun t => y (t.castAdd j)) B e hB he
      ((mul_le_mul_of_nonneg_right hp ht).trans capBound) (fun t => bank _)
    obtain ⟨rq,bq⟩ := ihq (fun t => x (t.natAdd i)) (fun t => y (t.natAdd i)) B e hB he
      ((mul_le_mul_of_nonneg_right hq ht).trans capBound) (fun t => bank _)
    refine ⟨⟨rp,rq⟩,Fin.addCases (fun t => ?_) (fun t => ?_)⟩
    · simp only [Ops.applyPlan, Fin.append_left]
      exact ⟨(bp t).1.trans (mul_le_mul_of_nonneg_right hp hB),
        (bp t).2.trans (mul_le_mul_of_nonneg_right hp (by linarith : 0 ≤ e+δ))⟩
    · simp only [Ops.applyPlan, Fin.append_right]
      exact ⟨(bq t).1.trans (mul_le_mul_of_nonneg_right hq hB),
        (bq t).2.trans (mul_le_mul_of_nonneg_right hq (by linarith : 0 ≤ e+δ))⟩

end PhysicalWalsh

end NearSquareRoot
end Computability
end OAI
