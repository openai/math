import OAI.Computability.NearSquareRoot.FixedLayerWalshTemplate
import OAI.Computability.NearSquareRoot.FixedLayerEffectiveWalshAt

/-! # Resource profiles for one emitted selected-Walsh program

The source depends on the parsed dimensions and the two physical subprograms.
A proof of its resource bounds may use different estimates for different
controller parameters. The command, its actual schedule mask and its rounded
output are independent of those estimates.
-/

namespace OAI
namespace Computability
namespace NearSquareRoot

set_option maxHeartbeats 1800000
noncomputable section
namespace FixedLayer

open IntegerMultiplication Code Space FixedPoint FixedCandidate DigitPacking
open FixedLayerTickets ShortFourier.BatchWord
open PhysicalWalsh PhysicalWalsh.GatherProgram PhysicalWalshNode
open KernelPass KernelPass.ComputableSyntax PhysicalWalshCompile.Dispatch
open EffectiveBoundedTask CommonRegisters GeneratorSyntax

theorem selectedFactor {num den : ℕ} {r : Raw} (sel : Selected num den r) :
    recursionFactor sel.plan ≤ rawFactor r := by
  simpa only [rawFactor] using recursionFactor_le_rawFactor r.2 sel.plan sel.decode

/-- For a searched template the precision threshold already includes the
schedule-size threshold for masks generated by the real stage directory. -/
theorem walshTemplateCut_eq {num den router : ℕ} {r : Raw} (sel : Selected num den r) :
    walshTemplateCut router r = max router (rawPrecisionCutoff r) := by
  have hW := (width_le_recursionFactor sel.plan).trans (selectedFactor sel)
  have bound : SparseCutoff.threshold 0 (dimensions r).2 ≤ precisionCutoff (rawFactor r) := by
    change 2^(2*(((dimensions r).2+1)*(0+1))) ≤ 2^(4*(rawFactor r+1))
    apply Nat.pow_le_pow_right (by decide)
    omega
  exact congrArg (max router) (max_eq_right bound)

variable {P : Type} [Primcodable P] {I : P → Type}
  (r : P → Raw) {num den : P → ℕ} (sel : ∀ j, Selected (num j) (den j) (r j))
  (router piece : P → Cmd) (n : ∀ j,I j → ℕ) (hv : ∀ j i,Directory (n j i))
  (dir : ∀ j,I j → Bool)

def walshSource (j : P) : Cmd :=
  planCmd ((dimensions (r j)).1+1) (dimensions (r j)).2 (router j) (piece j)

def walshRawArgument (j : P) (e : WalshRowInput n hv dir j) : Tree :=
  send (flags (walshBits (hv j e.val.instanceIndex) (dir j e.val.instanceIndex)
    e.val.position.val e.val.position.isLt), Odd.words e.val.payload)

def walshRawReply (j : P) (e : WalshRowInput n hv dir j) : Tree :=
  send (Odd.words (walshRowOutput ((show 0<2 by decide).trans_le (sel j).wide)
    (sel j).plan (hv j e.val.instanceIndex) (dir j e.val.instanceIndex)
    e.val.position.val e.val.position.isLt e.val.payload))

theorem effectiveWalshAt_from_command (hs : Computable r)
    (er : Effective ltr router) (ep : Effective ltr piece) (R : ℕ)
    (wr : ∀ j,Within R (router j)) (wp : ∀ j,Within R (piece j))
    (hd : ∀ j i,4 ≤ (box (n j i)).length) (hn : ∀ j i,2 ≤ n j i)
    (arena clock : P → ℕ → ℕ) (lin : ∀ j i,n j i ≤ arena j (n j i))
    (large : ∀ j i,arena j (n j i) ≤ clock j (n j i))
    (hk : ∀ j i,rawPrecisionCutoff (r j) ≤ addressBits (n j i))
    (exec : ∀ j, Runs (walshSource r router piece j)
      (fun e : WalshRowInput n hv dir j => clock j (n j e.val.instanceIndex))
      (fun e => arena j (n j e.val.instanceIndex))
      (walshRawArgument n hv dir j) (walshRawReply r sel n hv dir j)) :
    EffectiveImplementsAt n hv dir hd arena clock .walsh := by
  let hw j := (show 0<2 by decide).trans_le (sel j).wide
  apply effectiveWalsh_of_selectedFamilyAt n hv dir hd hn arena clock lin large hw
    (fun j => (sel j).plan) (fun j => (show 1<5 by decide).trans_le (sel j).large)
    (fun j => (sel j).correct) (fun j => selectedFactor (sel j)) hk
  apply planCmd_family (A:=fun j => (dimensions (r j)).1+1) (W:=fun j => (dimensions (r j)).2)
    (Primrec.nat_add.to_comp.comp ((Primrec.fst.comp primrec_dimensions).to_comp.comp hs) (Computable.const 1))
    ((Primrec.snd.comp primrec_dimensions).to_comp.comp hs) er ep R wr wp exec

end FixedLayer

end

end NearSquareRoot
end Computability
end OAI
