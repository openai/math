import OAI.Computability.NearSquareRoot.FixedLayerEffectiveDiagonal
import OAI.Computability.NearSquareRoot.FixedLayerEffectiveSweep
import OAI.Computability.NearSquareRoot.FixedLayerPhysical
import OAI.Computability.NearSquareRoot.FixedCandidateEffective

/-! # Effective full Fourier and adjoint words

The arithmetic input header is generated by one fixed command. Each candidate
has a computably emitted row dispatcher, repeated over the actual chronological
ticket tape by a fixed finite loop. The numerical programs use the outputs of
precisely these executions throughout their admitted domain.
-/

namespace OAI
namespace Computability
namespace NearSquareRoot

namespace FixedLayer

open IntegerMultiplication Code FixedCandidate FixedPoint Space FixedLayerTickets
  DigitPacking ShortFourier.BatchWord SynchronizedLayers SynchronizedLayers.ScheduleProgram
open EffectiveBoundedTask CommonRegisters GeneratorSyntax

noncomputable section

variable {P : Type} [Primcodable P] {I : P → Type}

abbrev EffectivePassAt (n : ∀ p, I p → ℕ) (hv : ∀ p i, Directory (n p i))
    (arena clock : P → ℕ → ℕ) (op : ∀ p (i : I p), Array (n p i) → Array (n p i)) :=
  Family (fun p (e : Admitted (n p) (hv p)) => clock p (n p e.val.1))
    (fun p e => arena p (n p e.val.1)) (fun _ e => framed e.val.2) (fun p e => framed (op p e.val.1 e.val.2))

abbrev EffectivePass (n : ∀ p, I p → ℕ) (hv : ∀ p i, Directory (n p i))
    (clock : P → ℕ → ℕ) (op : ∀ p (i : I p), Array (n p i) → Array (n p i)) :=
  EffectivePassAt n hv (fun _ m => m) clock op

def wordClock (clock : ℕ → ℕ) (n : ℕ) := 3*boxDepth (addressBits n)*clock n + n

set_option maxHeartbeats 1800000 in
/-- The emitted forward or adjoint, with the concrete finite program and
its Fourier accuracy certificate chosen together. -/
theorem effectiveTransformAt (n : ∀ p : P, I p → ℕ) (hv : ∀ p i, Directory (n p i)) (dir : Bool)
    (hd : ∀ p i, 4 ≤ (box (n p i)).length) (hn : ∀ p i, 2 ≤ n p i)
    (hk : ∀ p i, 1024 ≤ addressBits (n p i)) (arena clock : P → ℕ → ℕ)
    (fit : ∀ p i, n p i ≤ arena p (n p i)) (lin : ∀ p i, arena p (n p i) ≤ clock p (n p i))
    (hl : ∀ p i, phaseClock (n p i) ≤ clock p (n p i))
    (perm : EffectiveImplementsAt n hv (fun _ _ => dir) hd arena clock .permutation)
    (walsh : EffectiveImplementsAt n hv (fun _ _ => dir) hd arena clock .walsh) :
    ∃ F : ∀ p i, Program (hv p i),
      (∀ p i, if dir then InverseOK (hv p i) (F p i) else ForwardOK (hv p i) (F p i)) ∧
      EffectivePassAt n hv arena (fun p => wordClock (clock p)) (fun p i => eval (hv p i) (F p i)) := by
  classical
  let d (p : P) (_ : I p) := dir
  obtain ⟨y,run,err⟩ := effectiveDispatchAt n hv d hd hn arena clock fit lin (fun kind => by
    cases kind
    · exact perm
    · exact effectiveDiagonalAt n hv d hd hn arena clock fit hl
    · exact walsh)
  let out p (i : I p) (j : Fin (tickets (n p i) dir).length) (x : Array (n p i)) : Array (n p i) :=
    if h : working (hv p i) x then y p ⟨i,j,x,h⟩ else x
  have action p (e : RowInput (n p) (hv p) (d p)) : out p e.instanceIndex e.position e.payload = y p e := by
    cases e with
    | mk i j x h => simp only [out,dite_eq_left h]
  have num p i : TicketError (hv p i) (hd p i) dir (out p i) := by
    intro j x hx
    let e : RowInput (n p) (hv p) (d p) := ⟨i,j,x,hx⟩
    exact (action p e) ▸ err p e
  let F p i := programOfRows (hv p i) (hd p i) dir (out p i)
  have valid p i := programOfRows_correct (hv p i) (hd p i) (hk p i) dir (out p i) (num p i)
  refine ⟨F,valid,?_⟩
  let E (v : Tally) := chronological (dir,v)
  have hp : Poly E := ((IntegerMultiplication.Code.Poly.const dir).pair IntegerMultiplication.Code.Poly.identity).compose chronological_poly
  obtain ⟨K,hK⟩ := headerVolume (fun q : Sigma I => n q.1 q.2) (fun q => hn q.1 q.2) E hp
  let Adm p := Admitted (n p) (hv p)
  have boot : Family (fun p (e : Adm p) => n p e.val.1) (fun p e => n p e.val.1)
      (fun _ e => framed e.val.2) (fun p e => .fork (send (chronological (rowKey (n p) (d p) e.val.1))) (framed e.val.2)) := by
    apply Family.joint
    exact prepareHeader (fun q : Sigma Adm => n q.1 q.2.val.1) (fun q => hn q.1 q.2.val.1)
      E hp (fun q => q.2.val.2)
  have localPrograms := run.conform (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    (fun p e => congrArg framed (action p e).symm)
  obtain ⟨row,R,er,_,rows⟩ := localPrograms
  obtain ⟨pre,S,ep,_,pres⟩ := boot
  let B := max 3 (max R S)
  have b₃ : 3 ≤ B := le_max_left ..
  have rB : R ≤ B := (le_max_left R S).trans (le_max_right ..)
  have sB : S ≤ B := (le_max_right R S).trans (le_max_right ..)
  refine ⟨fun p => (pre p).join (sweepCmd (row p)),B,ep.join (effective_sweepCmd er),by omega,fun p => ?_⟩
  refine ⟨⟨RegisterSelect.within_mono sB _ (pres p).1,
    within_sweepCmd b₃ (RegisterSelect.within_mono rB _ (rows p).1)⟩,?_⟩
  apply namedProgramAt (n p) (hv p) (d p) (arena p ∘ n p) (fit p) (hn p) (fun i => by have := hk p i; omega) (F p)
    (fun i => programOfRows_steps ..) _ (out p)
    (fun i j x => programOfRows_nextArray (hv p i) (hd p i) dir (out p i) j.val j.isLt x)
    (clock p) (row p) (pre p) (rows p).2 (pres p).2 K (fun i => hK ⟨p,i⟩)
  intro i
  cases eq : dir with
  | false => exact Or.inl (by simpa only [eq,Bool.false_eq_true,ite_false] using valid p i)
  | true => exact Or.inr (by simpa only [eq,ite_true] using valid p i)

/-- With a linear row workspace the same emitted chronological loop
has linear workspace for the entire transform. -/
theorem effectiveTransform (n : ∀ p : P, I p → ℕ) (hv : ∀ p i, Directory (n p i)) (dir : Bool)
    (hd : ∀ p i, 4 ≤ (box (n p i)).length) (hn : ∀ p i, 2 ≤ n p i)
    (hk : ∀ p i, 1024 ≤ addressBits (n p i)) (clock : P → ℕ → ℕ)
    (hl : ∀ p i, phaseClock (n p i) ≤ clock p (n p i))
    (perm : EffectiveImplements n hv (fun _ _ => dir) hd clock .permutation)
    (walsh : EffectiveImplements n hv (fun _ _ => dir) hd clock .walsh) :
    ∃ F : ∀ p i, Program (hv p i),
      (∀ p i, if dir then InverseOK (hv p i) (F p i) else ForwardOK (hv p i) (F p i)) ∧
      EffectivePass n hv (fun p => wordClock (clock p)) (fun p i => eval (hv p i) (F p i)) :=
  effectiveTransformAt n hv dir hd hn hk (fun _ m => m) clock (fun _ _ => le_rfl)
    (fun p i => (Nat.le_mul_of_pos_right _ (Nat.zero_lt_succ _)).trans (hl p i))
    hl perm walsh

end
end FixedLayer

