import OAI.Computability.NearSquareRoot.InterchangeROMStageComputeLeg

/-! # Effective generation of the eleven-step interchange stage -/

namespace OAI
namespace Computability
namespace NearSquareRoot

namespace InterchangeROMStage.Frame

variable {X : Type} [Primcodable X] {g : X → Frame} {lanes : X → ℕ}

theorem primrec_route (hg : Primrec g) (hl : Primrec lanes) (n : ℕ) :
    Primrec fun x => route (g x) (lanes x) n := by
  have he := primrec_leg (hg.comp (Primrec.fst (β:=Role))) n Primrec.snd
  apply Primrec.list_flatMap (primrec_bank hg (n+1))
  unfold Primrec₂
  dsimp only
  apply Primrec.list_map (Primrec.list_range.comp (hl.comp Primrec.fst))
  have ix : Primrec₂ (fun (a : Role) (l : List Role) => l.idxOf a) := by
    have e : (instBEqOfDecidableEq : BEq Role) = instBEqProd := lawful_beq_subsingleton _ _
    exact (congrArg (fun i : BEq Role => Primrec₂ (@List.idxOf Role i)) e).mp
      (Primrec.list_idxOf (α:=Role))
  have step := ix.comp (Primrec.fst.comp he)
    (primrec_bank (hg.comp (Primrec.fst (β:=Role))) n)
  have lane := Primrec.nat_mul.comp step (hl.comp Primrec.fst)
  exact ((Primrec.nat_add.comp (lane.comp Primrec.fst) Primrec.snd).pair
    ((Primrec.snd.comp he).comp Primrec.fst)).to₂

theorem primrec_gate (hg : Primrec g) (tag n : ℕ) :
    Primrec fun x => gate (g x) tag n :=
  (Primrec.const tag).pair ((primrec_bank hg n).pair (primrec_bank hg (n+1)))

/-- The complete numerical stage code, including its incidence enumerations,
matrix gate descriptions, move-chart slots, source-row ranks and ground lanes,
is generated by primitive recursion on the template and row count. -/
theorem primrec_script : Primrec₂ script := by
  have rt (n : ℕ) : Primrec fun x : Frame × ℕ =>
      (Sum.inr (route x.1 x.2 n) : InterchangeROM.Instruction Table Move) :=
    Primrec.sumInr.comp (primrec_route Primrec.fst Primrec.snd n)
  have gt (k n : ℕ) : Primrec fun x : Frame × ℕ =>
      (Sum.inl (gate x.1 k n) : InterchangeROM.Instruction Table Move) :=
    Primrec.sumInl.comp (primrec_gate Primrec.fst k n)
  refine Primrec.list_cons.comp (rt 0) ?_
  refine Primrec.list_cons.comp (rt 1) ?_
  refine Primrec.list_cons.comp (gt 0 2) ?_
  refine Primrec.list_cons.comp (rt 3) ?_
  refine Primrec.list_cons.comp (gt 1 4) ?_
  refine Primrec.list_cons.comp (rt 5) ?_
  refine Primrec.list_cons.comp (gt 2 6) ?_
  refine Primrec.list_cons.comp (rt 7) ?_
  refine Primrec.list_cons.comp (gt 3 8) ?_
  refine Primrec.list_cons.comp (rt 9) ?_
  refine Primrec.list_cons.comp (gt 4 10) ?_
  exact Primrec.const []

end InterchangeROMStage.Frame

end NearSquareRoot
end Computability
end OAI
