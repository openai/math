import OAI.Computability.NearSquareRoot.ScheduleRegisterLookup
import OAI.Computability.IntegerMultiplication.Strip.Encode

/-! # Literal truth tables for an interchange bank instruction

The bank order, alphabet and table operation are inputs to the compiler. An
entry is a pair of raw P192 forests in the specified input and output orders.
The code reads the same literal table that is generated by enumerating all
input tuples. This includes nullary tables and empty output banks.
-/

namespace OAI
namespace Computability
namespace NearSquareRoot

namespace InterchangeROMTable

open IntegerMultiplication IntegerMultiplication.Code IntegerMultiplication.Strip

/-- Lists spelling every word of the given length, in lexicographic order. -/
def words {A : Type*} (alphabet : List A) : ℕ → List (List A)
  | 0 => [[]]
  | n+1 => alphabet.flatMap fun a => (words alphabet n).map (a :: ·)

theorem word_mem {A : Type*} (alphabet : List A) (w : List A) (h : ∀ a ∈ w, a ∈ alphabet) :
    w ∈ words alphabet w.length := by
  induction w with
  | nil => simp [words]
  | cons a w ih =>
    exact List.mem_flatMap.mpr ⟨a,h _ List.mem_cons_self,
      List.mem_map.mpr ⟨w,ih (fun a ha => h a (List.mem_cons_of_mem _ ha)),rfl⟩⟩

/-- Recover a bank register from a word written in the input series' order. -/
def registers {K A : Type} [DecidableEq K] (rows : Series K) (fallback : A)
    (w : List A) (k : K) : A := (w[rows.explore.idxOf k]?).getD fallback

theorem registers_tab {K A : Type} [DecidableEq K] (rows : Series K) (fallback : A)
    (u : K → A) : registers rows fallback (rows.tab u) = u := by
  funext k
  simp [registers, Series.tab, List.getElem?_map, List.getElem?_idxOf (rows.complete k)]

/-- The output column of the truth table is calculated from its input word. -/
def literal {A : Type*} (alphabet : List A) (arity : ℕ) (enc : A → Tree)
    (result : List A → Tree) : List (Tree × Tree) :=
  (words alphabet arity).map fun w => (Task.forest enc w,result w)

private theorem forest_inj {A : Type*} {enc : A → Tree} (h : Function.Injective enc) :
    Function.Injective (Task.forest enc) := by
  intro x
  induction x with
  | nil =>
    intro y e
    cases y with
    | nil => rfl
    | cons => contradiction
  | cons a w ih =>
    intro y e
    cases y with
    | nil => contradiction
    | cons b z =>
      exact congrArg₂ List.cons (h (Tree.fork.inj e).1) (ih (Tree.fork.inj e).2)

private theorem first_result {A : Type*} {enc : A → Tree} (h : Function.Injective enc)
    (out : List A → Tree) {w : List A} (t : List (List A)) (hw : w ∈ t) :
    RegisterLookup.read (t.map fun v => (Task.forest enc v,out v)) (Task.forest enc w) = out w := by
  induction t with
  | nil => cases hw
  | cons v t ih =>
    simp only [List.map_cons,RegisterLookup.read]
    by_cases he : v = w
    · simp [he]
    · rw [ite_eq_right ((forest_inj h).ne he)]
      exact ih ((List.mem_cons.mp hw).resolve_left (Ne.symm he))

theorem literal_correct {A : Type*} (alphabet : List A) (arity : ℕ) (enc : A → Tree)
    (henc : Function.Injective enc) (result : List A → Tree) (w : List A)
    (len : w.length = arity) (hw : ∀ a ∈ w, a ∈ alphabet) :
    RegisterLookup.read (literal alphabet arity enc result) (Task.forest enc w) = result w ∧
    (Task.forest enc w,result w) ∈ literal alphabet arity enc result := by
  have hm : w ∈ words alphabet arity := len ▸ word_mem alphabet w hw
  exact ⟨first_result henc result _ hm, List.mem_map.mpr ⟨w,hm,rfl⟩⟩

/-- Compile the given operation on finite register sets, using their actual
serialized order. The code uses only the supplied spelling of each letter. -/
def bank {A B K L : Type} [DecidableEq K] (alphabet : List A) (fallback : A)
    (input : Series K) (output : Series L) (src : A → Tree) (dst : B → Tree)
    (op : (K → A) → L → B) : List (Tree × Tree) :=
  literal alphabet input.count src fun w => stripe output (dst ∘ op (registers input fallback w))

theorem bank_correct {A B K L : Type} [DecidableEq K] (alphabet : List A) (fallback : A)
    (input : Series K) (output : Series L) (src : A → Tree) (dst : B → Tree)
    (op : (K → A) → L → B) (u : K → A) (hs : Function.Injective src)
    (all : ∀ a, a ∈ alphabet) :
    let t := bank alphabet fallback input output src dst op
    let x := stripe input (src ∘ u)
    let y := stripe output (dst ∘ op u)
    RegisterLookup.read t x = y ∧ (x,y) ∈ t := by
  have H := literal_correct alphabet input.count src hs
    (fun w => stripe output (dst ∘ op (registers input fallback w))) (input.tab u)
    (input.card u) (fun a _ => all a)
  simp only [registers_tab] at H
  simpa only [bank, stripe_simple,Series.tab,Task.forest_map,Function.comp_def] using H

end InterchangeROMTable

end NearSquareRoot
end Computability
end OAI
