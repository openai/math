import OAI.Computability.VPVNP.PairSimulationTerminalCall

/-!
# Exact call sequences of the terminal controller

The same list of private branch strings is used by the terminal image and
the individual workers. Each continuing report determines the stage and local
state of the next genuine call. After the last stage accepts the sequence
cannot contain any further calls.
-/

namespace OAI
namespace Computability
namespace VPVNP

namespace PairSimulation.TerminalLink

open BurstRAM PrivateRAM LiveProgram
open scoped Fin.CommRing

variable {w : ℕ}

/-- The worker entry together with its original report. -/
abbrev Log (w : ℕ) := Entry w × Report w

/-- The chronological physical reports generated by the logged worker calls. -/
def reports (addr : Word w) (ls : List (Log w)) : List (Report w) :=
  ls.map fun (e,r) => report addr e r

/-- Persistent host marker for an entry, or termination after the final worker. -/
def hostState (q : Option (Entry w)) := q.map Entry.marker

/-- Every pending entry is consistent with the two controller cells. -/
def StateValid (addr : Word w) (m : Memory w) (q : Option (Entry w)) := ∀ e ∈ q, e.Valid addr m

variable (workers : Stage → PairTable) (pub : Fin 11 → Word w) (cap : ℕ)

/-- Fuel remaining for the worker and its exit after the entry instructions. -/
def rawFuel (e : Entry w) := cap-(e.prefixEvents (header pub)).length

/-- One derivation step is a successful call of the original component.
The source clock includes the space needed for its selected native exit. -/
inductive Visits : Option (Entry w) → Memory w → List (List Bool) → List (Log w) → Prop
  | nil (q m) : Visits q m [] []
  | cons {e m bs more raw tail}
      (called : execute (source workers e.stage pub) (rawFuel pub cap e)
        ((source workers e.stage pub).start e.state) m bs = some raw)
      (room : (exitReport (header pub) e.stage raw).events.length < rawFuel pub cap e)
      (later : Visits (e.follow raw) (after m (report (header pub) e raw).events) more tail) :
      Visits (some e) m (bs::more) ((e,raw)::tail)

private theorem next_state_valid (e : Entry w) (raw : Report w) (m : Memory w) (fit : 32 ≤ 2^w) :
    StateValid (header pub) (after m (report (header pub) e raw).events) (e.follow raw) := by
  intro j hj
  exact next_valid _ e j raw m fit hj

theorem Visits.native {q m bs ls} (h : Visits workers pub cap q m bs ls)
    (fit : 32 ≤ 2^w) (hcap : 26 ≤ cap) (valid : StateValid (header pub) m q) :
    runSegment (program workers pub) cap (hostState q) m bs = some (reports (header pub) ls) := by
  induction h with
  | nil => rfl
  | @cons e m bs more raw tail call room _ ih =>
    have head := call_ok workers pub cap e m bs (by omega) hcap (valid e rfl) raw call room
    change (match execute (program workers pub) cap ((program workers pub).start e.marker) m bs with
      | none => none | some v => (runSegment (program workers pub) cap v.result (after m v.events) more).map (v::·)) = _
    rw [head]
    dsimp only
    rw [report_result,← hostState]
    rw [ih (next_state_valid pub e raw m fit)]
    rfl

/-- Inverse at every finite prefix, recovering exactly the worker call and
its actual branch stream. In particular an additional call after final
acceptance has no derivation. -/
theorem recover_visits (q : Option (Entry w)) (m : Memory w) (bs : List (List Bool))
    (out : List (Report w)) (fit : 32 ≤ 2^w) (hcap : 26 ≤ cap)
    (valid : StateValid (header pub) m q)
    (run : runSegment (program workers pub) cap (hostState q) m bs = some out) :
    ∃ ls, Visits workers pub cap q m bs ls ∧ out = reports (header pub) ls := by
  induction bs generalizing q m out with
  | nil =>
    exact ⟨[],.nil _ _,(Option.some.inj run).symm⟩
  | cons bs more ih =>
    cases q with
    | none => contradiction
    | some e =>
      change (match execute (program workers pub) cap ((program workers pub).start e.marker) m bs with
        | none => none | some v => (runSegment (program workers pub) cap v.result (after m v.events) more).map (v::·)) =
          some out at run
      cases head : execute (program workers pub) cap ((program workers pub).start e.marker) m bs with
      | none => simp [head] at run
      | some v =>
        obtain ⟨raw,call,room,hv⟩ := (recover_call workers pub cap e m bs (by omega) hcap (valid e rfl) v).mp head
        subst v
        rw [head,Option.map_eq_some_iff] at run
        obtain ⟨rest,continued,rfl⟩ := run
        rw [report_result] at continued
        obtain ⟨tail,visits,rfl⟩ := ih (e.follow raw) _ rest (next_state_valid pub e raw m fit) continued
        exact ⟨(e,raw)::tail,.cons call room visits,rfl⟩

theorem visits_iff (q : Option (Entry w)) (m : Memory w) (bs : List (List Bool)) (out : List (Report w))
    (fit : 32 ≤ 2^w) (hcap : 26 ≤ cap) (valid : StateValid (header pub) m q) :
    runSegment (program workers pub) cap (hostState q) m bs = some out ↔
      ∃ ls, Visits workers pub cap q m bs ls ∧ out = reports (header pub) ls :=
  ⟨recover_visits workers pub cap q m bs out fit hcap valid,
   fun ⟨_,h,e⟩ => e ▸ Visits.native workers pub cap h fit hcap valid⟩

theorem Visits.length {q m bs ls} (h : Visits workers pub cap q m bs ls) : ls.length = bs.length := by
  induction h with | nil => rfl | cons _ _ _ ih => simp [ih]

theorem Visits.branch_strings {q m bs ls} (h : Visits workers pub cap q m bs ls) :
    branchPaths (reports (header pub) ls) = bs := by
  induction h with
  | nil => rfl
  | cons call _ _ ih =>
    simpa only [reports,List.map_cons,branchPaths,report_bits,(execute_spec call).2.2] using
      congrArg (fun x => _ :: x) ih

/-- A closed visit sequence ending at a worker halt has exactly the host
terminal marker specified by that final call. -/
def finish : Option (Entry w) → List (Log w) → Option (Entry w)
  | q, [] => q
  | _, (e,raw)::more => finish (e.follow raw) more

theorem finish_host (addr : Word w) (q : Option (Entry w)) (ls : List (Log w)) :
    endState (hostState q) (reports addr ls) = hostState (finish q ls) := by
  induction ls generalizing q with
  | nil => rfl
  | cons p ls ih =>
    obtain ⟨e,r⟩ := p
    simp only [reports,List.map_cons,endState,finish,report_result]
    exact ih (e.follow r)

theorem Visits.unique {q m bs l₁ l₂}
    (h₁ : Visits workers pub cap q m bs l₁) (h₂ : Visits workers pub cap q m bs l₂) : l₁ = l₂ := by
  induction h₁ generalizing l₂ with
  | nil => cases h₂; rfl
  | cons hc _ _ ih =>
    cases h₂ with
    | cons hc' _ ht =>
      obtain rfl := Option.some.inj (hc.symm.trans hc')
      rw [ih ht]

/-- Exactly the complete genuine call strings, preserving any caller cap
on physical reports. The proof works in both directions on the same input. -/
theorem actual_iff (m : Memory w) (bs : List (List Bool)) (ok : List (Report w) → Prop)
    (fit : 32 ≤ 2^w) (hcap : 26 ≤ cap) :
    (∃ out, runSegment (program workers pub) cap (some 0) m bs = some out ∧ endState (some 0) out = none ∧ ok out) ↔
      ∃ ls, Visits workers pub cap (some .initial) m bs ls ∧ finish (some .initial) ls = none ∧ ok (reports (header pub) ls) := by
  have valid : StateValid (header pub) m (some (.initial : Entry w)) := by
    intro e he; cases he; trivial
  have term (ls : List (Log w)) :
      endState (some (0 : Word w)) (reports (header pub) ls) = none ↔ finish (some .initial) ls = none := by
    change endState (hostState (some .initial)) _ = none ↔ _
    rw [finish_host]; simp [hostState]
  constructor
  · rintro ⟨out,hr,ht,hv⟩
    obtain ⟨ls,h,rfl⟩ := recover_visits workers pub cap (some .initial) m bs out fit hcap valid hr
    exact ⟨ls,h,(term ls).mp ht,hv⟩
  · rintro ⟨ls,h,ht,hv⟩
    exact ⟨_,Visits.native workers pub cap h fit hcap valid,(term ls).mpr ht,hv⟩

end PairSimulation.TerminalLink

end VPVNP
end Computability
end OAI
