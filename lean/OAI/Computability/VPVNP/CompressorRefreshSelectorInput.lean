import OAI.Computability.VPVNP.CompressorRefreshBeforeSelector
import OAI.Computability.VPVNP.CompressorRefreshBlockPlan
import OAI.Computability.VPVNP.CompressorSelectedTermWorker

/-!
# The actual term-worker input at a refresh boundary

The native preparation fills one demand row for each old base and residual lane.
Its physical order and term addresses give the input of the local-history
selector before any of its term bits are read.
-/

namespace OAI
namespace Computability
namespace VPVNP

noncomputable section
namespace CompressorRecords.RefreshSelector

open BurstRAM Compression Compression.Refresh Compression.DegreeRefresh PairSimulation.LocalHistory
open PortRefresh PortRefresh.LevelRecipe SelectedTerms NewSlots
open scoped Fin.CommRing
open private termInputs from OAI.Computability.VPVNP.CompressorRecordRefreshAdmitted

variable {k : Type*} [_root_.Field k] {S : BlockSchedule k} (B : S.Templates)
variable {A : Type*} [CommRing A] (f : B.Entry → A) (hf : B.IsSolution f)
variable {g w : ℕ} (X : State S.portExponent (S.portExponent+g))
local notation "O" => PassOrigin.refresh (B := B) (f := f) (hf := hf) X
local notation "sh" => RefreshBlockPlan.shape B
local notation "ord" => RefreshBlockPlan.order B
local notation "n" => Fintype.card X.Base * 2^g
local notation "d" => Shape.ties sh
local notation "stride" => Shape.stride sh
local notation "e" => (Shape.ports sh)*(Shape.dH sh)
local notation "demand" => blockDemandWidths (splitSlots X) (bitWordFinEquiv S.portExponent) (splitWidths X)

private theorem demand_order (i : Fin n) : (PairSimulation.LocalHistory.termRows O).demand i = demand ((DemandScan.blocks X).symm i) := rfl

/-- The two allocations and the dense demand readback generated by `prepare_verified`
supply all machine inputs of the physical selector. The instruction budget may
be any supplied cap at least as large as the motif worker's checked budget. -/
def workerInput (source dest : BurstRAM.Word w) (sep : source.val+n*d ≤ dest.val) (room : dest.val+n*stride < 2^w)
    (width : SelectedTermWorker.fitConstant B+4*Nat.clog 2 (X.maxWireWidth+1) ≤ w)
    (cap : ℕ) (clock : TermWorker.budget B.refresh d e w X.maxWireWidth ≤ cap) (m : Memory w)
    (data : ∀ s, DemandPreparation.demandAt ord (DemandScan.rowBase X d source s) m = demand s) :
    WorkerInput O w := by
  let layout := PortRefresh.termRows X source dest stride le_rfl sep room
  let addr := PortRefresh.termAddresses source dest stride d
  have hin := termInputs ord X source dest stride le_rfl sep room m data
  have hi : TermRecordScan.Inputs (grid O).demandOrder.entries layout (PairSimulation.LocalHistory.termRows O).demand m := by
    intro i
    exact (hin i).trans (demand_order B f hf X i).symm
  let W := SelectedTermWorker.input O width layout addr
    (TermWorker.addresses_strided source.val dest.val d stride le_rfl le_rfl sep room) m hi
  exact {W with fuel := cap, clock := clock}

/-- Both the physical input and output of every block live above the current
controller area, even when the rows have different strides. -/
theorem workerRows {source dest : BurstRAM.Word w} (sep : source.val+n*d ≤ dest.val) (room : dest.val+n*stride < 2^w)
    (width : SelectedTermWorker.fitConstant B+4*Nat.clog 2 (X.maxWireWidth+1) ≤ w)
    (cap : ℕ) (clock : TermWorker.budget B.refresh d e w X.maxWireWidth ≤ cap) (m : Memory w)
    (data : ∀ s, DemandPreparation.demandAt ord (DemandScan.rowBase X d source s) m = demand s) :
    let W := workerInput B f hf X source dest sep room width cap clock m data
    ∀ i : Fin n, source.val ≤ (W.layout.source i).val ∧ dest.val ≤ (W.layout.base i).val := by
  intro W i
  have a := Nat.mul_le_mul_right d (Nat.le_of_lt i.isLt)
  have b := Nat.mul_le_mul_right stride (Nat.le_of_lt i.isLt)
  change source.val ≤ (source.val+i.val*d)%(2^w) ∧ dest.val ≤ (dest.val+i.val*stride)%(2^w)
  rw [Nat.mod_eq_of_lt (by omega : source.val+i.val*d<2^w),Nat.mod_eq_of_lt (by omega : dest.val+i.val*stride<2^w)]
  exact ⟨Nat.le_add_right ..,Nat.le_add_right ..⟩

end CompressorRecords.RefreshSelector

end

end VPVNP
end Computability
end OAI
