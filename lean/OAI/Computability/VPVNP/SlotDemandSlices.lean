import OAI.Computability.VPVNP.SlotDemandKernel

/-!
# Copy descriptors for the packed demand words

Appendix E constructs the fields of a kernel before choosing wire bits. For
an AB demand, intersecting the old and new intervals in the concatenated
bundle gives three integers: a source offset, a destination offset and a
length. The results below identify these descriptors with the exact bit
bijection used in the coefficient identity.
-/

namespace OAI
namespace Computability
namespace VPVNP

namespace Compression.PackingData

/-- Starting position of a field in an ordered concatenation. -/
def fieldStart {A : Type*} {n : ℕ} (order : A ≃ Fin n) (w : A → ℕ) (a : A) : ℕ :=
  ∑ i : Fin (order a), w (order.symm (Fin.castLE (order a).isLt.le i))

/-- Ordered concatenation preserves the position within each field. -/
theorem orderedBits_offset {A : Type*} [Fintype A] {n : ℕ} (order : A ≃ Fin n)
    (w : A → ℕ) (a : A) (i : Fin (w a)) :
    (orderedBits order w ⟨a,i⟩ : ℕ) = fieldStart order w a + i := by
  simp [orderedBits,fieldStart,Equiv.sigmaCongr]

/-- The contiguous piece copied from one old field into one demand field. -/
structure CopySlice where
  /-- Starting bit offset within the source field for this copy. -/
  sourceOffset : ℕ
  /-- Starting bit offset within the target field for the same copied interval. -/
  targetOffset : ℕ
  /-- Number of consecutive bits copied from the source offset to the target offset. -/
  length : ℕ

/-- The shared interval starts at the larger start and ends at the smaller
end. Truncated subtraction gives length zero for disjoint or empty fields. -/
def copySlice (s ns t nt : ℕ) : CopySlice where
  sourceOffset := max s t - s
  targetOffset := max s t - t
  length := min (s + ns) (t + nt) - max s t

private theorem copySlice_spec (s ns t nt : ℕ) (i : Fin ns) (j : Fin nt) :
    s + i = t + j ↔ ∃ k < (copySlice s ns t nt).length,
      (i : ℕ) = (copySlice s ns t nt).sourceOffset + k ∧
      (j : ℕ) = (copySlice s ns t nt).targetOffset + k := by
  have hi := i.isLt
  have hj := j.isLt
  simp only [copySlice]
  constructor
  · intro he
    exact ⟨s + i - max s t, by omega, by omega, by omega⟩
  · rintro ⟨k,_,h₁,h₂⟩
    omega

variable {V H Tag L : Type} {d c : ℕ} [AddCommGroup H] [AddCommGroup Tag] [AddCommGroup L]
variable (P : PackingData V H Tag L d c)
variable [Fintype V] [Fintype H] [Fintype Tag] [Fintype L]
variable [DecidableEq V] [DecidableEq Tag] [DecidableEq L]
variable (number : P.BundleNumbering) (order : P.ThickNumbering) (w : Arc V H Tag L d c → ℕ)
variable (b : Site V Tag L × Fin d)

/-- Descriptor generated by one old field and one new piece of a bundle.
It depends only on the two lists of widths and their combinatorial orders. -/
def demandSlice (a : P.ThickFiber b) (m : P.MotifFiber b) : CopySlice :=
  copySlice (fieldStart (order b) (fun x ↦ w x.1.1) a) (w a.1.1)
    (fieldStart (number b) (fun y ↦ P.abWidth number w y.1) m) (P.abWidth number w m.1)

/-- The bit bijection sends a new bit to an old bit precisely when the single
copy descriptor for that pair of fields contains both local positions. -/
theorem demandBitEquiv_eq_iff_slice (hc : 2 ≤ c) (hd : 0 < d) (a : P.ThickFiber b)
    (m : P.MotifFiber b) (i : Fin (w a.1.1)) (j : Fin (P.abWidth number w m.1)) :
    P.demandBitEquiv hc hd number order w b ⟨m,j⟩ = ⟨a,i⟩ ↔
      let slice := P.demandSlice number order w b a m
      ∃ k < slice.length, (i : ℕ) = slice.sourceOffset + k ∧
        (j : ℕ) = slice.targetOffset + k := by
  let source := orderedBits (order b) (fun x ↦ w x.1.1)
  let dest := orderedBits (number b) (fun y ↦ P.abWidth number w y.1)
  have h : source (P.demandBitEquiv hc hd number order w b ⟨m,j⟩) =
      finCongr (P.sum_abWidth hc hd number w b) (dest ⟨m,j⟩) := source.apply_symm_apply _
  rw [← source.injective.eq_iff, ← Fin.val_inj, h, finCongr_apply_coe]
  simp only [source, dest, orderedBits_offset, demandSlice]
  exact eq_comm.trans (copySlice_spec _ _ _ _ i j)

end Compression.PackingData

end VPVNP
end Computability
end OAI
