import OAI.Computability.VPVNP.PairSimulationStackNativeCalls
import OAI.Computability.VPVNP.RAMRecords

/-!
# Exact private writes of a stack nomination

Popping a bit moves the top pointer and leaves its private cell intact. A
later push can overwrite that same cell. The virtual leaf therefore keeps
the entire ordered list of private writes, even when the final logical
stack is empty. This list and the native tick/choice trace depend only on
the source stack execution.
-/

namespace OAI
namespace Computability
namespace VPVNP

namespace PairSimulation.StackMachine

open RAMTape BurstRAM BurstRAM.PrivateRAM PrimedInputRAM PrimedCounter.GuessWord
open StackCompiler (Reach)

variable {w : ℕ}

/-- A stack execution's chronological native events and private cell writes, including pushes
whose cells may subsequently be popped or overwritten. -/
structure Footprint (w : ℕ) where
  /-- The native ticks and choice events generated by the bounded stack execution, in execution
  order. -/
  events : List (Event w)
  /-- The sequence of private address and value pairs written by pushes, in the order they
  update memory. -/
  writes : List (Word w × Word w)

/-- The machine's private cells after all pushes, in chronological order. -/
def Footprint.applyWrites (f : Footprint w) (m : Word w → Word w) : Word w → Word w :=
  f.writes.foldl (fun mem write => Function.update mem write.1 write.2) m

/-- The updated cell depends only on the same input cell and the sequence
of pushes. In particular a caller can apply the footprint to its scratch
subarray without looking at the memory below it. -/
theorem Footprint.applyWrites_congr (f : Footprint w) {m m' : Word w → Word w}
    (a : Word w) (agree : m a = m' a) : f.applyWrites m a = f.applyWrites m' a := by
  obtain ⟨es, writes⟩ := f
  unfold applyWrites
  dsimp only
  induction writes generalizing m m' with
  | nil => exact agree
  | cons write writes ih =>
    simp only [List.foldl_cons]
    apply ih
    by_cases h : a = write.1 <;> simp [h, agree]

/-- Prefix the tail footprint with the earlier instruction's events and writes, preserving
chronological order in both lists. -/
def Footprint.prepend (tail : Footprint w) (events : List (Event w)) (writes : List (Word w × Word w)) :
    Footprint w := ⟨events ++ tail.events, writes ++ tail.writes⟩

variable {K Q : Type} [DecidableEq K]

/-- Compute the native trace and private write list during bounded source
interpretation. On a short choice stream the three padding ticks precede
the missing choice. -/
def footprint (L : Layout K w) (code : StackCode K Q) : ℕ → Q → Stacks K → List Bool → Footprint w
  | 0, _, _, _ => ⟨[], []⟩
  | fuel + 1, q, s, bits =>
    match code q with
    | .push k b next =>
      (footprint L code fuel next (Function.update s k (b :: s k)) bits).prepend
        (List.replicate 4 .tick) [(L.address k (s k).length, encodeBit w b)]
    | .pop k next =>
      (footprint L code fuel (next (s k).head?) (Function.update s k (s k).tail) bits).prepend
        (List.replicate 4 .tick) []
    | .goto next => (footprint L code fuel next s bits).prepend (List.replicate 4 .tick) []
    | .choose low high =>
      match bits with
      | [] => ⟨List.replicate 3 .tick, []⟩
      | b :: more => (footprint L code fuel (if b then high else low) s more).prepend
        [.tick, .tick, .tick, .choice b] []
    | .halt b => ⟨if b then [.tick] else [], []⟩

/-- The stack instructions only touch private cells on every execution,
including unfinished and rejected prefixes. -/
theorem footprint_probes (L : Layout K w) (code : StackCode K Q) (fuel : ℕ)
    (q : Q) (s : Stacks K) (bits : List Bool) :
    countProbes (footprint L code fuel q s bits).events = 0 := by
  have ticks (es : List (Event w)) : countProbes (List.replicate 4 .tick ++ es) = countProbes es := rfl
  have choose (b : Bool) (es : List (Event w)) :
      countProbes ([.tick, .tick, .tick, .choice b] ++ es) = countProbes es := rfl
  induction fuel generalizing q s bits with
  | zero => rfl
  | succ fuel ih =>
    cases hop : code q with
    | push | pop | goto => simpa only [footprint, hop, Footprint.prepend, ticks] using ih _ _ _
    | choose low high =>
      cases bits with
      | nil => simp only [footprint, hop]; rfl
      | cons b more => simpa only [footprint, hop, Footprint.prepend, choose] using ih _ s more
    | halt b => cases b <;> simp [footprint, hop, countProbes]

/-- The native choice events are exactly the consumed prefix, and every
continuing instruction has four transitions, followed by the halt jump. -/
theorem footprint_parse (L : Layout K w) {code : StackCode K Q} {fuel : ℕ} {q : Q} {s : Stacks K}
    {bits : List Bool} {x : Exit K Q} (h : parse code fuel q s bits = some x) (ok : x.accept = true) :
    bits = choiceBits (footprint L code fuel q s bits).events ++ x.rest ∧
      (footprint L code fuel q s bits).events.length + 4 * x.unused + 3 = 4 * fuel := by
  induction fuel generalizing q s bits with
  | zero => simp [parse] at h
  | succ fuel ih =>
    cases hop : code q with
    | push | pop | goto =>
      simp only [parse, hop] at h
      obtain ⟨words, time⟩ := ih h
      simp only [footprint, hop, Footprint.prepend, Flow.choiceBits_append, List.length_append,
        List.length_replicate, show choiceBits (List.replicate 4 (.tick : Event w)) = [] from rfl, List.nil_append]
      exact ⟨words, by omega⟩
    | choose low high =>
      cases bits with
      | nil => simp [parse, hop] at h
      | cons b more =>
        simp only [parse, hop] at h
        obtain ⟨words, time⟩ := ih h
        simp only [footprint, hop, Footprint.prepend, choiceBits,
          List.cons_append, List.nil_append, List.length_cons]
        exact ⟨congrArg (b :: ·) words, by omega⟩
    | halt status =>
      simp only [parse, hop, Option.some.injEq] at h
      subst x
      change status = true at ok
      subst status
      simp [footprint, hop, choiceBits, Nat.mul_succ]
      omega

/-- The native code does not inspect extra source bits after an accepted
halt. The chronological writes also stay fixed under extension. -/
theorem footprint_append (L : Layout K w) {code : StackCode K Q} {fuel : ℕ} {q : Q} {s : Stacks K}
    {bits : List Bool} {x : Exit K Q} (h : parse code fuel q s bits = some x) (more : List Bool) :
    footprint L code fuel q s (bits ++ more) = footprint L code fuel q s bits := by
  induction fuel generalizing q s bits with
  | zero => simp [parse] at h
  | succ fuel ih =>
    cases hop : code q with
    | push | pop | goto =>
      simp only [parse, hop] at h
      simp only [footprint, hop, ih h]
    | choose low high =>
      cases bits with
      | nil => simp [parse, hop] at h
      | cons b bs =>
        simp only [parse, hop] at h
        simp only [List.cons_append, footprint, hop, ih h]
    | halt status => simp only [footprint, hop]

variable {p r k : ℕ} {M : Machine w p r k} {code : StackCode K Q} {pc : Q → Fin 7 → Fin p}
  {reg : Register K ↪ Fin r} {done : Fin p} {L : Layout K w}

private theorem realized_from {start q : Q} {initial s : Stacks K}
    (linked : Linked M code pc reg done) (hw : 0 < w)
    (space : ∀ ⦃v u⦄, Reach code start initial v u → ∀ j, (u j).length ≤ L.capacity)
    (reach : Reach code start initial q s) {fuel : ℕ} {bits : List Bool} {x : Exit K Q}
    (parsed : parse code fuel q s bits = some x) (ok : x.accept = true)
    (c : Config w p r) (atPC : c.pc = pc q 0) (rep : Represents L reg c s) :
    let f := footprint L code fuel q s bits
    ∃ out, Prefix M c f.events out ∧ out.pc = done ∧ Represents L reg out x.bank ∧
      out.privateMem = f.applyWrites c.privateMem ∧ Frame L reg c out := by
  induction fuel generalizing q s c bits with
  | zero => simp [parse] at parsed
  | succ fuel ih =>
    have cont {next : Q} {st : Stacks K} {more : List Bool} {d : Config w p r}
        {ev : List (Event w)} {writes : List (Word w × Word w)}
        (reached : Reach code start initial next st) (hparse : parse code fuel next st more = some x)
        (pref : Prefix M c ev d) (label : d.pc = pc next 0) (hr : Represents L reg d st)
        (mem : d.privateMem = (Footprint.mk ev writes).applyWrites c.privateMem) (fr : Frame L reg c d) :
        let f := (footprint L code fuel next st more).prepend ev writes
        ∃ out, Prefix M c f.events out ∧ out.pc = done ∧ Represents L reg out x.bank ∧
          out.privateMem = f.applyWrites c.privateMem ∧ Frame L reg c out := by
      obtain ⟨out, run, endPC, hbank, last, frame⟩ := ih reached hparse d label hr
      refine ⟨out, pref.append run, endPC, hbank, ?_, fr.trans frame⟩
      rw [last, mem]
      simp [Footprint.applyWrites, Footprint.prepend]
    cases hop : code q with
    | push a b next =>
      have reached := reach.step (.push hop)
      have room := space reached a
      simp only [Function.update_self, List.length_cons] at room
      obtain ⟨d, run, label, hr, mem, frame⟩ :=
        push_prefix_memory linked hop atPC rep (space reach) (by omega)
      simp only [parse, hop] at parsed
      simp only [footprint, hop]
      exact cont reached parsed run label hr mem frame
    | pop a next =>
      obtain ⟨d, run, label, hr, mem, frame⟩ := pop_prefix_memory linked hop atPC rep hw (space reach a)
      simp only [parse, hop] at parsed
      simp only [footprint, hop]
      exact cont (reach.step (.pop hop)) parsed run label hr mem frame
    | goto next =>
      obtain ⟨d, run, label, hr, mem, frame⟩ := goto_prefix_memory linked hop atPC rep
      simp only [parse, hop] at parsed
      simp only [footprint, hop]
      exact cont (reach.step (.goto hop)) parsed run label hr mem frame
    | choose low high =>
      cases bits with
      | nil => simp [parse, hop] at parsed
      | cons b more =>
        obtain ⟨d, run, label, hr, mem, frame⟩ := choose_prefix_memory linked hop atPC rep b
        have reached : Reach code start initial (if b then high else low) s := by
          cases b with
          | false => exact .low reach hop
          | true => exact .high reach hop
        simp only [parse, hop] at parsed
        simp only [footprint, hop]
        exact cont reached parsed run label hr mem frame
    | halt b =>
      simp only [parse, hop, Option.some.injEq] at parsed
      subst x
      change b = true at ok
      subst b
      simpa only [footprint, hop, ↓reduceIte, Footprint.applyWrites, List.foldl_nil] using
        halt_prefix_memory linked hop atPC rep

/-- Realize the computed tick/choice trace and the entire final private
memory, including overwritten or stale cells. The prefix theorem allows
any continuation and external memory. -/
theorem footprint_native {q : Q} {s : Stacks K} (linked : Linked M code pc reg done)
    (hw : 0 < w) (space : ∀ ⦃v u⦄, Reach code q s v u → ∀ j, (u j).length ≤ L.capacity)
    {fuel : ℕ} {bits : List Bool} {x : Exit K Q} (parsed : parse code fuel q s bits = some x)
    (ok : x.accept = true) (c : Config w p r) (atPC : c.pc = pc q 0) (rep : Represents L reg c s) :
    let f := footprint L code fuel q s bits
    ∃ out, Prefix M c f.events out ∧ out.pc = done ∧ Represents L reg out x.bank ∧
      out.privateMem = f.applyWrites c.privateMem ∧ Frame L reg c out :=
  realized_from linked hw space .initial parsed ok c atPC rep

