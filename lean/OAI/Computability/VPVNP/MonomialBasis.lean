import OAI.Computability.VPVNP.GreedyBasis
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.LinearAlgebra.Basis.VectorSpace
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Bounded monomials in the reduced coordinate algebra

Appendix D.1 enumerates monomials up to a dimension bound to select a basis
of the finite slice algebra. Multiplying the span through degree `d` by
one generator lands in the span through degree `d+1`. Equal consecutive
spans contain every product of generators. Before that occurs, the dimension
increases strictly.
-/

namespace OAI
namespace Computability
namespace VPVNP

namespace MonomialBasis

variable {K A Label : Type*} [Field K] [CommRing A] [Algebra K A] [Fintype Label]

/-- Values of label monomials of total degree at most `d`. -/
def monomials (X : Label → A) (d : ℕ) : Set A :=
  {v | ∃ e : Label → ℕ, (∑ i, e i) ≤ d ∧ ∏ i, X i ^ e i = v}

/-- The subspace generated by the bounded monomials. -/
def degreeSpan (K : Type*) [Field K] [Algebra K A] (X : Label → A) (d : ℕ) : Submodule K A :=
  Submodule.span K (monomials X d)

private theorem one_mem_monomials (X : Label → A) (d : ℕ) : (1 : A) ∈ monomials X d :=
  ⟨fun _ => 0, by simp, by simp⟩

theorem degreeSpan_mono (X : Label → A) : Monotone (degreeSpan K X) := by
  intro d d' h
  apply Submodule.span_mono
  rintro v ⟨e, hdeg, he⟩
  exact ⟨e, hdeg.trans h, he⟩

private theorem generator_mul_mem (X : Label → A) (i : Label) (d : ℕ) {v : A}
    (hv : v ∈ degreeSpan K X d) : X i * v ∈ degreeSpan K X (d + 1) := by
  classical
  apply Submodule.span_induction (p := fun v _ => X i * v ∈ degreeSpan K X (d + 1)) _ _ _ _ hv
  · rintro _ ⟨e, hdeg, rfl⟩
    apply Submodule.subset_span
    refine ⟨fun j => (if i = j then 1 else 0) + e j, ?_, ?_⟩
    · simpa [Finset.sum_add_distrib, Nat.add_comm] using Nat.add_le_add_left hdeg 1
    · simp_rw [pow_add]
      rw [Finset.prod_mul_distrib]
      simp [apply_ite]
  · simp
  · intro x y _ _ hx hy
    simpa [mul_add] using (degreeSpan K X (d + 1)).add_mem hx hy
  · intro k x _ hx
    simpa [mul_smul_comm] using (degreeSpan K X (d + 1)).smul_mem k hx

/-- Once successive spans agree, closure under each label forces them to
contain the algebra generated by those labels. -/
theorem stable_eq_top (X : Label → A) (d : ℕ) (hgen : Algebra.adjoin K (Set.range X) = ⊤)
    (hstable : degreeSpan K X d = degreeSpan K X (d + 1)) : degreeSpan K X d = ⊤ := by
  apply eq_top_iff.mpr
  rw [← Algebra.top_toSubmodule, ← hgen, Algebra.adjoin_toSubmodule_le]
  intro v hv
  apply Submonoid.closure_induction_left (motive := fun v _ => v ∈ degreeSpan K X d) _ _ hv
  · exact Submodule.subset_span (one_mem_monomials X d)
  · rintro _ ⟨i, rfl⟩ y _ hy
    exact hstable.symm ▸ generator_mul_mem X i d hy

/-- Monomials through any upper bound on the dimension span the whole algebra. -/
theorem degreeSpan_eq_top [FiniteDimensional K A] (X : Label → A) (N : ℕ)
    (hgen : Algebra.adjoin K (Set.range X) = ⊤) (hdim : Module.finrank K A ≤ N) :
    degreeSpan K X N = ⊤ := by
  have hgrowth (d : ℕ) : d ≤ Module.finrank K (degreeSpan K X d) ∨ degreeSpan K X d = ⊤ := by
    induction d with
    | zero => exact Or.inl (Nat.zero_le _)
    | succ d ih =>
      have hle := degreeSpan_mono (K := K) X (Nat.le_succ d)
      by_cases h : degreeSpan K X d = ⊤
      · exact Or.inr (top_le_iff.mp (h ▸ hle))
      · have hne : degreeSpan K X d ≠ degreeSpan K X (d + 1) :=
          fun hs => h (stable_eq_top X d hgen hs)
        exact Or.inl ((ih.resolve_right h).trans_lt
          (Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne hle hne)))
  rcases hgrowth N with h | h
  · exact Submodule.eq_top_of_finrank_eq ((degreeSpan K X N).finrank_le.antisymm (hdim.trans h))
  · exact h

/-- The dimension-bounded monomials admit a basis containing the constant
monomial. The chosen indices themselves are values of bounded monomials. -/
theorem exists_basis_containing_one [FiniteDimensional K A] [Nontrivial A]
    (X : Label → A) (N : ℕ) (hgen : Algebra.adjoin K (Set.range X) = ⊤)
    (hdim : Module.finrank K A ≤ N) :
    ∃ S : Set A, ∃ b : Module.Basis S K A,
      (∃ u : S, b u = 1) ∧ Set.range b ⊆ monomials X N := by
  have hone : LinearIndepOn K id ({1} : Set A) := (linearIndepOn_singleton_iff K).mpr one_ne_zero
  have hsub : ({1} : Set A) ⊆ monomials X N := Set.singleton_subset_iff.mpr (one_mem_monomials X N)
  have hspan : ⊤ ≤ Submodule.span K (monomials X N) := (degreeSpan_eq_top X N hgen hdim).ge
  let b := Module.Basis.extendLe hone hsub hspan
  refine ⟨_, b, Module.Basis.subset_extendLe hone hsub hspan (Set.mem_singleton 1),
    Module.Basis.extendLe_subset hone hsub hspan⟩

/-- In any listing of the bounded monomials beginning with the constant,
the basis selected by the prefix-rank tests in Appendix D.1 consists of the
retained entries and begins with `1`. This applies also when distinct
exponents give the same value in the slice algebra. -/
theorem prefix_basis [FiniteDimensional K A] [Nontrivial A] {m : ℕ}
    (X : Label → A) (N : ℕ) (hgen : Algebra.adjoin K (Set.range X) = ⊤)
    (hdim : Module.finrank K A ≤ N) (listing : Fin (m + 1) → A)
    (hlisting : Set.range listing = monomials X N) (hfirst : listing 0 = 1) :
    ∃ b : Module.Basis (RankQuery.greedyIndices K listing) K A,
      (∀ i, b i = listing i.val) ∧ ∃ u, u.val = 0 ∧ b u = 1 := by
  have hwhole := RankQuery.greedyIndices_span_prefix K listing (m + 1)
  have hspan : Submodule.span K (listing '' (RankQuery.greedyIndices K listing : Set _)) = ⊤ := by
    have hall : {i : Fin (m + 1) | i.val < m + 1} = Set.univ :=
      Set.eq_univ_of_forall (fun i => i.isLt)
    rw [hall, Set.inter_univ, Set.image_univ, hlisting] at hwhole
    exact hwhole.trans (degreeSpan_eq_top X N hgen hdim)
  have heq : Set.range (fun i : RankQuery.greedyIndices K listing => listing i.val) =
      listing '' (RankQuery.greedyIndices K listing : Set _) := by
    ext a
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i.val, i.property, rfl⟩
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, hi⟩, rfl⟩
  have hzero : (0 : Fin (m + 1)) ∈ RankQuery.greedyIndices K listing := by
    rw [RankQuery.mem_greedyIndices, hfirst, show Set.Iio (0 : Fin (m + 1)) = ∅ from Set.Iio_bot]
    simp
  let b := Module.Basis.mk (v := fun i : RankQuery.greedyIndices K listing => listing i.val)
    (RankQuery.greedyIndices_linearIndepOn K listing) (by rw [heq, hspan])
  exact ⟨b, fun _ => Module.Basis.mk_apply .., ⟨0, hzero⟩, rfl,
    (Module.Basis.mk_apply ..).trans hfirst⟩

end MonomialBasis

end VPVNP
end Computability
end OAI
