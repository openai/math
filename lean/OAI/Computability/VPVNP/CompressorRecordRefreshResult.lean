import OAI.Computability.VPVNP.CompressorRecordRefreshDeterminism

/-!
# Correctness of all native degree-refresh branches

Determinism transfers the verified memory contents and resource bound to every complete
execution. Starting from the old incidence directory, an arbitrary family of block tapes
passes the physical preparation and term checks exactly when it encodes a unique admitted
branch that extends to a complete native refresh.
-/

namespace OAI
namespace Computability
namespace VPVNP

namespace CompressorRecords.PortRefresh.Build

open BurstRAM PrimedStackRAM Compression Compression.Refresh Compression.DegreeRefresh SpectralGeometry
open MotifConversion NewSlots RefreshRAM Allocation

variable {bits a a₀ g dH t : ℕ} {k : Type*} [_root_.Field k] {K K' : ℝ}
variable (X : State a (a+g)) (E : RegularArcGraph (Fin (2^a)) dH) (hdH : 0 < dH)
  (conn : (arcSupportGraph E.multiplicity).Connected)
  (F : RefreshBlock k (expanderSupply E hdH conn) (2^a₀) K K')
  (hD : 1 < 2^a) (hd : dH+1 ≤ 2^a₀) (choice : DyadicRefreshChoice X E hdH conn F)
  (ties : Fin t ≃ Tie (2^a)) (T : IncidenceDirectory bits) (start stride : ℕ)

local notation "P" => plan X a₀ dH t stride start
local notation "Q" => Plan.scratch P bits
local notation "N" => Fintype.card X.Base * 2^a * 2^g
local notation "B" => Fintype.card X.Base * 2^g
local notation "S" => N*2^a
local notation "sourceBase" => word (bits := bits) (Plan.demand P)
local notation "termBase" => word (bits := bits) (Plan.term P)
local notation "demand" => blockDemandWidths (splitSlots X) (bitWordFinEquiv a) (splitWidths X)
local notation "Y" => dyadicRefreshNext X E hdH conn F hD hd choice

/-- Every successful full execution has the selected incidence columns, local-history
fields, interval frame and a linear bound on its total calls plus probes. -/
theorem Run.result {L : PrepareLayout X T a₀ dH t stride start} {m : Memory bits} {rs : List (Report bits)} {cap : ℕ}
    (execution : Run X E hdH conn F hD hd choice ties T start stride cap L m rs)
    (old : T.Represents X m) (before : ∀ c : Fin 6, (T.column c).val+S ≤ start)
    (wide : 2+2^a*dH ≤ stride) (room : (P).stop < 2^bits)
    (termBits : termConstant E hdH conn F ties + 4*Nat.clog 2 (X.maxWireWidth+1) ≤ bits)
    (nextWidth : (Y).maxWireWidth < 2^bits)
    (capFit : TermWorker.budget F t (2^a*dH) bits X.maxWireWidth ≤ cap) :
    ((P).output bits).Represents Y (after m (eventLog rs)) ∧
      Stored X E hdH conn F choice ties start stride L.regions.fits (after m (eventLog rs)) ∧
      (∀ addr, addr < start ∨ (P).stop ≤ addr → after m (eventLog rs) addr = m addr) ∧
      RAMBuckets.cost Report.probes rs ≤ chargeFactor E hdH conn F t * X.positions := by
  obtain ⟨checked,run,rep,stored,frame,cost⟩ := build X E hdH conn F hD hd choice ties T start stride m old
    before wide room termBits nextWidth cap capFit
  obtain rfl := Run.deterministic execution run
  exact ⟨rep,stored,frame,cost.trans (charge_le_positions X E hdH conn F hD hd choice)⟩

/-- Each bundle contains one old width for every port, even when several widths vanish. -/
theorem bundle_total_le_max (b : (X.Base × BitWord g) × Fin (2^a)) :
    (∑ j, bundleWidths (bitWordFinEquiv a) (splitWidths X) b j) ≤ 2^a*X.maxWireWidth := by
  calc
    _ ≤ ∑ _j : Fin (2^a), X.maxWireWidth := Finset.sum_le_sum fun _ _ => X.width_le_maxWireWidth _
    _ = _ := by simp

/-- Equivalence between acceptance of arbitrary physical block tapes and unique complete
branch realizability. The prepared demand memory is generated by executing the prefix. -/
theorem branches_iff (m : Memory bits) (old : T.Represents X m)
    (before : ∀ c : Fin 6, (T.column c).val+S ≤ start) (wide : 2+2^a*dH ≤ stride) (room : (P).stop < 2^bits)
    (totalFit : 2^a*X.maxWireWidth < 2^bits)
    (termBits : termConstant E hdH conn F ties + 4*Nat.clog 2 (X.maxWireWidth+1) ≤ bits)
    (nextWidth : ∀ c, (dyadicRefreshNext X E hdH conn F hD hd c).maxWireWidth < 2^bits)
    (cap : ℕ) (capFit : TermWorker.budget F t (2^a*dH) bits X.maxWireWidth ≤ cap) (tapes : Fin B → List Bool) :
    let L := prepare_layout X T a₀ dH t stride start before room
    (∃ pre m₁ terms, PrepareRun X T Q sourceBase ties (word (2^g)) L.regions.fits m m₁ pre ∧
        termRun E hdH conn F ties X sourceBase termBase stride cap tapes m₁ = some terms) ↔
      ∃! c : DyadicRefreshChoice X E hdH conn F, tapes = blockTapes E hdH conn F X c bits ∧
        ∃ rs, Run X E hdH conn F hD hd c ties T start stride cap L m rs := by
  let L := prepare_layout X T a₀ dH t stride start before room
  constructor
  · rintro ⟨pre,prepared,terms,hr,ht⟩
    obtain ⟨_,canonical,hc,_,demands,_,_⟩ := prepare_demands X T Q sourceBase ties m old (word (2^g))
      L.degree L.lanes L.regions L.directory L.gather L.baseApart
      (fun b => (bundle_total_le_max X b).trans_lt totalFit) L.demandRoom L.demandApart
    have same := (PrepareRun.deterministic hr hc).2
    subst prepared
    have hw (s) (e) : demand s e ≤ X.maxWireWidth := by
      unfold blockDemandWidths internalWidth
      split <;> exact X.width_le_maxWireWidth _
    have stream := term_stream_iff E hdH conn F ties X sourceBase termBase stride wide L.demandTerm L.termRoom
      canonical X.maxWireWidth termBits hw demands cap capFit tapes
    obtain ⟨c,encoded,unique⟩ := stream.mp (by rw [ht]; rfl)
    obtain ⟨rs,run,_⟩ := build X E hdH conn F hD hd c ties T start stride m old before wide room termBits
      (nextWidth c) cap capFit
    exact ⟨c,⟨encoded,rs,run⟩,fun c' h => unique c' h.1⟩
  · rintro ⟨c,⟨encoded,rs,run⟩,_⟩
    obtain ⟨pre,terms,_,_,hr,ht,_⟩ := run
    refine ⟨pre,after m (eventLog pre),terms,hr,?_⟩
    rw [encoded]; exact ht

end CompressorRecords.PortRefresh.Build

end VPVNP
end Computability
end OAI
