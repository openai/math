import OAI.Computability.BorderVNP.ResidueChartFormula
import Mathlib.LinearAlgebra.Matrix.Nondegenerate
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

/-!
# Nonvanishing of the branch parameter differential

The chart equations express all parameter derivatives in terms of the time
derivative. If the latter vanished, every element of the function field
generated by the chart would have zero derivative. The uniformizer has
derivative one in its own Laurent expansion.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace Residue

open BranchJet MvPolynomial JetRing
open scoped BranchJet Matrix

variable {κ : Type*} [Field κ] (p : ℕ) [Fact p.Prime] [CharP κ p] [PerfectRing κ p]

omit [Fact p.Prime] [CharP κ p] [PerfectRing κ p] in
private theorem jet_eq_coeff {f h : Polynomial (LaurentSeries κ)} (i : ℕ) (hi : i < p)
    (he : AdjoinRoot.mk (Polynomial.X ^ p) f = AdjoinRoot.mk (Polynomial.X ^ p) h) :
    f.coeff i = h.coeff i := by
  obtain ⟨k, hk⟩ := AdjoinRoot.mk_eq_mk.mp he
  have hd := congrArg (fun a : Polynomial (LaurentSeries κ) => a.coeff i) hk
  simpa only [Polynomial.coeff_sub, Polynomial.coeff_X_pow_mul', ite_eq_right hi.not_ge, sub_eq_zero]
    using hd

private theorem jet_constant (A : LaurentSeries κ) : (jetPolynomial p 1 A).coeff 0 = A := by
  have h := eval_jetPolynomial p 1 (RingHom.id (LaurentSeries κ)) 0
    (by simp [zero_pow (Fact.out : p.Prime).ne_zero]) A
  rw [taylorJet_zero] at h
  rw [Polynomial.coeff_zero_eq_eval_zero]
  exact h

include p in
/-- The ordinary product rule on Laurent series follows from the first coefficient
of their multiplicative Taylor jets, including in characteristic two. -/
theorem branch_derivative_mul (A B : LaurentSeries κ) :
    LaurentSeries.derivative κ (A*B) =
      A * LaurentSeries.derivative κ B + LaurentSeries.derivative κ A * B := by
  have hp := (Fact.out : p.Prime).one_lt
  have h := jet_eq_coeff p 1 hp (show AdjoinRoot.mk (Polynomial.X ^ p) (jetPolynomial p 1 (A*B)) =
      AdjoinRoot.mk _ (jetPolynomial p 1 A * jetPolynomial p 1 B) by
    rw [← jet_eq_mk, map_mul, map_mul, ← jet_eq_mk, ← jet_eq_mk])
  rw [Polynomial.coeff_mul, Finset.Nat.antidiagonal_eq_map] at h
  simp only [Finset.sum_map, Finset.sum_range_succ, Finset.sum_range_zero, zero_add] at h
  change (jetPolynomial p 1 (A*B)).coeff 1 = (jetPolynomial p 1 A).coeff 0 *
    (jetPolynomial p 1 B).coeff 1 + (jetPolynomial p 1 A).coeff 1 *
    (jetPolynomial p 1 B).coeff 0 at h
  simpa only [jet_constant, jetPolynomial_coeff_one p 1 (by decide)] using h

omit [PerfectRing κ p] in
/-- The Laurent derivative annihilates scalars from every perfect coefficient field. -/
theorem branch_derivative_scalar {E : Type*} [Field E] [ExpChar E p] [PerfectRing E p]
    (φ : E →+* LaurentSeries κ) (c : E) : LaurentSeries.derivative κ (φ c) = 0 := by
  obtain ⟨b, hb⟩ := surjective_frobenius E p c
  change b ^ p = c at hb
  rw [← hb, map_pow]
  simpa using laurentDerivative_term (K := κ) p 1 (by decide) 0 (φ b)

variable {E σ : Type*} [Field E] [CharP E p] [PerfectRing E p] [Fintype σ]

include p in
private theorem chart_chain_rule (φ : E →+* LaurentSeries κ) (a : σ → LaurentSeries κ)
    (g : MvPolynomial σ E) :
    LaurentSeries.derivative κ (eval₂Hom φ a g) =
      ∑ i, eval₂Hom φ a (pderiv i g) * LaurentSeries.derivative κ (a i) := by
  classical
  have hX (j : σ) : (∑ i, eval₂Hom φ a (pderiv i (X j)) * LaurentSeries.derivative κ (a i)) =
      LaurentSeries.derivative κ (a j) := by
    rw [Finset.sum_eq_single j]
    · simp
    · intro i _ hi
      simp [pderiv_X_of_ne hi.symm]
    · simp
  induction g using MvPolynomial.induction_on with
  | C c => simp only [eval₂Hom_C, branch_derivative_scalar p, pderiv_C, map_zero, zero_mul,
      Finset.sum_const_zero]
  | add f g hf hg => simp only [map_add, hf, hg, add_mul, Finset.sum_add_distrib]
  | mul_X f j hf =>
    simp only [pderiv_mul, map_add, map_mul, eval₂Hom_X', branch_derivative_mul p, hf,
      add_mul, Finset.sum_add_distrib]
    have hleft : (∑ i, (eval₂Hom φ a (pderiv i f) * a j) * LaurentSeries.derivative κ (a i)) =
        (∑ i, eval₂Hom φ a (pderiv i f) * LaurentSeries.derivative κ (a i)) * a j := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i _
      ring
    rw [hleft, show (∑ i, ((eval₂Hom φ a) f * (eval₂Hom φ a) ((pderiv i) (X j))) *
        LaurentSeries.derivative κ (a i)) = (eval₂Hom φ a) f *
        (∑ i, (eval₂Hom φ a) ((pderiv i) (X j)) * LaurentSeries.derivative κ (a i)) by
      simp only [mul_assoc, Finset.mul_sum], hX, add_comm]

include p in
/-- In a function field generated by the chart coordinates, a nonsingular parameter
Jacobian forces the time derivative to be nonzero in the completion. -/
theorem branch_parameter_derivative_ne_zero {K : Type*} [Field K] [Algebra E K]
    [DecidableEq σ] (ρ : K →+* LaurentSeries κ) (x : σ → K) (t : K)
    (hgen : IntermediateField.adjoin E (insert t (Set.range x)) = ⊤)
    (hπ : parameter κ ∈ Set.range ρ) (g : σ → MvPolynomial (Option σ) E)
    (hg : ∀ i, eval₂Hom (ρ.comp (algebraMap E K)) (fun j => j.elim (ρ t) (ρ ∘ x)) (g i) = 0)
    (hJ : (chartJacobian (ρ.comp (algebraMap E K)) (fun j => j.elim (ρ t) (ρ ∘ x)) g).det ≠ 0) :
    LaurentSeries.derivative κ (ρ t) ≠ 0 := by
  intro hzero
  let D := LaurentSeries.derivative κ (V := κ)
  let φ := ρ.comp (algebraMap E K)
  let a (j : Option σ) := j.elim (ρ t) (ρ ∘ x)
  let M := chartJacobian φ a g
  have hM : M *ᵥ (fun i => D (ρ (x i))) = 0 := by
    funext i
    have h := chart_chain_rule p φ a (g i)
    rw [hg, map_zero, Fintype.sum_option] at h
    simpa [M, a, chartJacobian, Matrix.mulVec, dotProduct, D, hzero] using h.symm
  have hdx : ∀ i, D (ρ (x i)) = 0 := by
    have h := Matrix.mulVec_injective_of_det_ne_zero hJ (hM.trans (Matrix.mulVec_zero M).symm)
    exact fun i => congrFun h i
  have hall (w : K) : D (ρ w) = 0 := by
    have hw : w ∈ IntermediateField.adjoin E (insert t (Set.range x)) := by simp [hgen]
    induction hw using IntermediateField.adjoin_induction with
    | mem w hw => rcases hw with rfl | ⟨i, rfl⟩ <;> first | exact hzero | exact hdx _
    | algebraMap c => exact branch_derivative_scalar p φ c
    | add v w _ _ hv hw => rw [map_add, map_add, hv, hw, zero_add]
    | inv w _ hw =>
      by_cases hw0 : w = 0
      · simp [hw0]
      have h := branch_derivative_mul p (ρ w) (ρ w⁻¹)
      rw [← map_mul, mul_inv_cancel₀ hw0, map_one,
        show D 1 = 0 from by simpa [D] using branch_derivative_scalar p φ 1, hw, zero_mul, add_zero]
        at h
      exact (mul_eq_zero.mp h.symm).resolve_left ((map_ne_zero ρ).mpr hw0)
    | mul v w _ _ hv hw => rw [map_mul, branch_derivative_mul p, hv, hw, zero_mul, mul_zero, add_zero]
  obtain ⟨π, hπ⟩ := hπ
  have h := hall π
  rw [hπ] at h
  simp [D, parameter, LaurentSeries.derivative_apply] at h

end Residue

end BorderVNP
end Computability
end OAI
