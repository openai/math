/-- The two sort depths that fix the native output arity also define the
physical directories stored in the same public gate table. The descriptor
sort reserves its spare receiving cell and its original chunk list. -/
theorem SignedCalendarAt.locatedGateTable_finishShape (initial : StartupArena) :
    let cells := CoverScale.sites (Cube D) (EnrichedOuter.depth S ((d₁)+1) T₁)
    let cables := (boundaryShape S ((d₁)+1) T₁).edges+4*(R₁+1)*tiles
    let live := (R₁+1)*tiles
    let marked := BottomReports.BundleSort.markedDepth cells J₁
    let t := cal.locatedGateTable grid qpos position initial
    let dest := Allocation.dest (initial.next+7*(dir₁).candidates) cap₁ ceiling₁ t.outputs w₁
    let ctl := controlsBase dest cables cells J₁ live
    let start := Retained.packetBase dest cables cells J₁ live 37
    ∃ wp wd chunks, t.outputs=signedGridOutputCount cables cells J₁ live 37 (Total wp wd)+(2^marked+2^marked) ∧
      t.directories=GeometryDirectories.published start wp wd (cells+1) chunks ctl (Total wp wd) marked ∧
      Total wp wd ≤ t.outputs := by
  intro cells cables live marked t dest ctl start
  refine ⟨_,_,_,rfl,rfl,?_⟩
  exact ((((Nat.le_add_left _ 37).trans (Nat.le_add_left ..)).trans (Nat.le_add_left ..)).trans
    (Nat.le_add_left ..)).trans (Nat.le_add_right ..)

