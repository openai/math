/-- The selected task's typed original descriptor interval and the private-word
bound for every one of this team's true report candidates. The available bank
capacity can be supplied in the owner-quantified form of the joint calibration. -/
theorem signedReportIntervals (v : Routed (b:=cube.b) (s:=cube.width) (B).owners) (u : Fin (R+1))
    {J : Type} [Fintype J] (ix : J ↪ (net).Site) (boxes : J → Packing.BottomReports.Bundle) (ids : Fin cells → List J)
    (owner : Fin (B).siteRows → ℕ) {privateMax exteriorMax z high boundTable boundRows digits w : ℕ}
    (bound : ReceivedBounds (received v) net (B).cell (B).siteID owner (B).programs ix boxes ids
       privateMax exteriorMax z high boundTable boundRows digits)
    (hr : 1≤r) (hm : privateMax ≤ TeamScales.width (k+1) (1/5)) (he : exteriorMax ≤ TeamScales.width (k+1) (1/4))
    (word : 60*logWidth r (k+1) ≤ w) (reportGap : parameters.privateGap=(k+1)^2)
    (capacity : ℕ) (supplyLimit : ∀ c : Fin cells,suppliedSize net (B).cell c≤capacity)
    (storage : ∀ (f : Fin (deliveries).entries → Fin cells) (c : Fin cells) (g x : ℕ), g≤(k+1)^2 → x≤capacity →
      x+g+(∑ j, if f j=c then (deliveries).description else 0)≤3*(r*(k+1))^2+1) :
    SiteIntervals ((received v).cells u) (deliveries).description (arena).cellStride ∧
      ∀ c∈(received v).cells u, c.privateWires+c.supplied+c.tailWidth<2^w := by
  let rr := received v
  have wordAt (i : Fin (rr.cells u).length) :
      ((rr.cells u).get i).tailWidth ≤ parameters.privateGap ∧
      ((rr.cells u).get i).privateWires+((rr.cells u).get i).supplied+((rr.cells u).get i).tailWidth<2^w := by
    have sizes := plan.signedReceivedRows_widths p fit W position code sites edges ports table words good seeds free
      count pos num hp q cube α ξ calibrated lit hd number parameters arenaBase profileBits frame origin v u i
    rw [reportGap]
    exact bound.reportGap_word rr net (B).cell (B).siteID owner (B).programs ix boxes ids u i (Nat.succ_pos _) hr
      hm he word sizes.1 sizes.2
  have tail (c : ReportCell (charts u)) (h : c∈rr.cells u) : c.tailWidth≤parameters.privateGap := by
    obtain ⟨i,rfl⟩ := List.mem_iff_get.mp h
    exact (wordAt i).1
  constructor
  · apply source_description_intervals net (B).cell edge port deliveries original live parameters.privateGap (arena).cellBank
      (arena).cellStride (charts u) bundle (fun v => ((B).programs v).program) u.val
      (routedOwnerWord arena (B).owners (packed).label v) wire (fun _ _ _ => false) (fun _ => rfl) _ tail
    intro c
    have room := storage (fun _ => c) c parameters.privateGap (suppliedSize net (B).cell c) reportGap.le (supplyLimit c)
    change suppliedSize net (B).cell c+parameters.privateGap+(deliveries).entries*(deliveries).description ≤ 3*(r*(k+1))^2+1
    refine le_trans (Nat.add_le_add_left ?_ _) room
    apply le_of_eq
    calc
      _ = ∑ _j : Fin (deliveries).entries, (deliveries).description := by simp
      _ = _ := Finset.sum_congr rfl (fun _ _ => (ite_eq_left rfl).symm)
  · intro c hc
    obtain ⟨i,rfl⟩ := List.mem_iff_get.mp hc
    exact (wordAt i).2

