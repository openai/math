/-- A returning parsed prefix on the installed calendar has passed the native
range and capacity checks on its own raw declaration. The raw publication
runs from its sampled lead pin before these checks. -/
theorem SignedCalendarAt.frozenCheckedBroadcast
    (routing : LocatedFrozenRoutingAt cube b φ q adv c charge (l+1))
    (values : (seedBundle (tape₁) axes d₁ (order₁) position copies₁).Tables F)
    (h : Index (Fin (Module.finrank (ZMod common.p) chart.E)) (Fin (pairedTableParameters (l+1) size₁))
      (chart.pinRadius (R₁+1) r₁))
    (i : Fin pins₁ → Bool) (hist : history(values)) (claim : Fin ((R₁+1)*(qdim)*w₁) → Bool) :
    CheckedRouteInputs.BroadcastChecks (cal.frozenRoutedAt grid qpos position chart reader chargeFit values h i hist claim
      ((selectedTask).lookupFrame 0) (cal.frozenFrameEntries grid qpos position chart reader chargeFit values hist)) := by
  intro raw parsed
  let p : PositiveFields cap₁ (selectedTask).cube.n (selectedTask).cube.header.d
      (selectedTask).cube.header.cap (R₁+1) (selectedTask).dim (b.physical.tally (l+1)) :=
    ⟨(codec(values)) hist,raw,claim⟩
  let wired := CellEntries.SewnTape.wiring prog₁ (geo₁).fits free₁ pins₁
  let nodes := (boots₁).2.choose (fullPin h)
  have wordPos : 0<w₁ := grid.word_eq.symm ▸ Nat.pow_pos grid.log_pos
  refine checkedParsedLead (w:=w₁) wired (selectedTask).cube (cube.cubeID paid) addresses (fullPin h) layout₁ hold₁
    wordPos (fun _ => rfl) (fun u => ((selectedSites).publicWords u 0).val)
    (fun u => ((boots₁).1 u).1.physical) (cal.frozenLayout_fields chart reader chargeFit).1 nodes i p _ ?_ parsed
  intro e ex code pinMatches
  let g := (wired.jointGuess (fun u => (addresses u).ibase) (fun u => (addresses u).hbase)
    (fun u => (addresses u).starbase)).symm i 0
  let ret := cal.frozenSites_published_pin grid qpos position chart reader chargeFit routing values hist p rfl hold₁ (fullPin h) e
  let node := nodes ⟨e.val,ret.choose⟩ 0
  let pin := ret.choose_spec 0 g
  have nativeChecked := (cal.frozenPinReturnChecks grid qpos position chart reader chargeFit routing values hist p
    (fullPin h) e 0 node g pin code pinMatches).2
  have eligible := cal.frozenWriter_broadcastAllowed grid qpos position chart reader chargeFit values hist
    (cal.frozenWriterDestinations grid qpos position chart reader chargeFit routing) raw
  close_registered_eligibility nativeChecked eligible

