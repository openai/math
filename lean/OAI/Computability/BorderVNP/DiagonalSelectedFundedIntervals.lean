/-- Before opening any report directory the selected rows already obey their original site
intervals and aggregate bit-width. The same grid funds every received team. -/
theorem signedReceived_funded_intervals (v : Routed (b:=cube.b) (s:=cube.width) (B).owners)
    (u : Fin (R+1)) {w exponent : ℕ} (positive : 0 < m) (loads : plan.SewnCellLoads count link)
    (privateRoom : FrozenIntervalBudget S (k+1) r d T copies header link w exponent parameters)
    (dictionary : ∀ z, num (pos z) ≤ parameters.report.gadgets-1) :
    SiteIntervals ((received v).cells u) (deliveries).description (arena).cellStride ∧
      ∀ c∈(received v).cells u, c.privateWires+c.supplied+c.tailWidth < 2^w := by
  let owner := fun i : Fin (B).siteRows => if h : ∃ a, (B).siteID a=i then ((B).cell h.choose).val else 0
  have agrees (a) : owner ((B).siteID a)=((B).cell a).val := by
    have present : ∃ z, (B).siteID z=(B).siteID a := ⟨a,rfl⟩
    rw [show owner ((B).siteID a)=((B).cell present.choose).val by dsimp only [owner]; rw [dite_eq_left present]]
    exact congrArg (fun z => ((B).cell z).val) ((B).siteID.injective present.choose_spec)
  have bound := plan.signedReceivedRows_bounds p fit W position code sites edges ports table words
    good seeds free count pos num hp q cube α ξ calibrated lit hd number parameters arenaBase profileBits frame origin
    positive privateRoom.batch privateRoom.short privateRoom.gadgets dictionary v owner agrees privateRoom.scale
  have supplied := plan.supplied_width_on_source_words p fit W position code sites edges ports table words good
    free count loads q number
  exact plan.signedReportIntervals p fit W position code sites edges ports table words good seeds free count pos num
    hp q cube α ξ calibrated lit hd number parameters arenaBase profileBits frame origin v u original coreBundles
    (fun c => BundleDirectory.sourceRows home c.val) owner bound privateRoom.batch le_rfl le_rfl privateRoom.word privateRoom.gap
    (TeamScales.width (k+1) (1/5)) supplied (fun f c g x hg hx => privateRoom.storage f c g x hg hx)

