import OAI.Computability.BorderVNP.ShortenPhysicalEpoch
import OAI.Computability.BorderVNP.ShortenEpochRoundHistory
import OAI.Computability.BorderVNP.ShortenEpochRoundCatalog
import OAI.Computability.BorderVNP.ShortenEpochRoundPlacedInitial

/-!
# Closing the one-epoch site estimate on actual physical histories

A fixed site budget and length-to-site coefficient are chosen before the
round count. A finite terminal template set, and the preparation constants
of those rounds, determine the common final motion list, site weight and
fan-in threshold. The resulting site potential is bounded on each attained
profile by half the largest of the original flat leaf potentials, plus the
tile-count term in (6.1). The exact tensor identity is on these same physical
layouts, with the original flat port ordering.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace Epoch.Round

open BorderVNP.Shortening BorderVNP.Shortening.Adaptive BorderVNP.Shortening.PlacedStep
open BorderVNP.Packing BorderVNP.Shortening.Catalog BorderVNP.Crossing BorderVNP.Cover Filter Topology Finset
open scoped Classical

universe u

/-- Finiteness of the actual recursively nested port list. -/
@[instance_reducible] noncomputable def portFintype {k b : ℕ} {P : Type} [Fintype P] : Fintype (Port k P b) :=
  Fintype.ofEquiv (Fin (k^b) × P) (portEquiv k P b).symm

attribute [local instance] portFintype

/-- A physical starting state generated by exact subdivision of an input site pack. -/
structure InitialSites {I : Type} [Fintype I] {D d : ℕ} {P : Type} {bits : P → ℕ} {R : Type*} [CommSemiring R]
    (p : PlacedPack D P bits R I d) (L : ℝ) {δ : ℝ} (hδ : 0 < δ) where
  /-- Original input algebraic pack. -/
  pack : Pack D P bits R
  /-- Site names and allowed moves of every active cable. -/
  routes : SiteRoutes pack I d L
  /-- The stored initial state is exactly its tensor-preserving subdivision. -/
  realizes : p = routes.initialPlacedPack hδ

/-- The flat tensor of all actual routed inputs agrees with the flat tensor of
their initial geodesic equality subdivisions. -/
theorem input_tensor {I : Type} [Fintype I] {D k b l : ℕ} {P : Type} {bits : P → ℕ} {K : Type*} [CommSemiring K]
    {L δ : ℝ} {hδ : 0 < δ} (state : Fin (k^b) → PlacedPack D P bits K I l)
    (sites : ∀ a, InitialSites (state a) L hδ)
    (x : Ports (fun z : Fin (k^b) × P => bits z.2)) :
    (parallelPacks (fun i => (sites i).pack)).tensor x =
      (parallelPacks (fun i => (state i).pack)).tensor x := by
  calc
    _ = ∏ i, (sites i).pack.tensor (fun p => x (i,p)) := Network.parallel_value _ _ x
    _ = ∏ i, (state i).pack.tensor (fun p => x (i,p)) := by
      apply prod_congr rfl
      intro i _
      have hs := congrArg (fun z : PlacedPack D P bits K I l => z.pack.tensor) (sites i).realizes
      exact congrFun (((sites i).routes.tensor_subdivided δ).symm.trans hs.symm) _
    _ = _ := (Network.parallel_value _ _ x).symm

/-- The site conclusion of (6.1) on all concrete histograms. The remaining inputs are the
physical measurement witnesses of each prepared combining step and the finite terminal
segment catalog established on those very steps. -/
theorem actual_site_epoch {I : Type} [Fintype I] {D m : ℕ} [NeZero D] {K : Type*} [Field K] (e : PaidIdentity K D m)
    (hm : 0 < m) :
    ∃ L > (0:ℝ), (∀ s : I → gamma 1, s ≠ 1 → (∀ i, s i = 1 ∨ (s i).val ∈ routingGenerators) →
      s ∈ allowedMoves I L) ∧
    ∃ ν > (0:ℝ), ∃ h > (0:ℝ), ∃ b : ℕ, 0 < b ∧
    ∀ {δ : ℝ} (hδ : 0 < δ) (templates : Set (SegmentType I)), templates.Finite →
    ∃ (a H : ℕ) (A Cout : ℝ),
    ∀ (B : Fin b → Type) [∀ i, Fintype (B i)] (u v : Fin b → ℝ), (∀ i, 0 ≤ u i) → (∀ i, 0 ≤ v i) →
    ∃ weight > (0:ℝ), ∃ E > (0:ℝ), ∀ᶠ k : ℕ in atTop, ∃ hk : 0 < k,
    ∀ {P : Type} [Fintype P] {bits : P → ℕ} {states : ℕ → Type u} (depth : ℕ → ℕ)
      (view : ∀ j, states j → PlacedPack D (Port k P j) (width bits k j) K I (depth j))
      (F : Program (B := B) e view)
      (V : ℝ), 0 ≤ V → (∀ i : Fin b, (Fintype.card (I → Deck (depth (i.val+1)+1)) : ℝ) ≤ V) →
      (∀ i c, Nonempty (Measurements (F.step i c) hk h ν (u i) (v i))) →
      ∀ (d : ℕ), depth b+1 = d+2+2*a → ∀ (flat : Fin (k^b) → states 0) (sites : ∀ i, InitialSites (view 0 (flat i)) L hδ),
      (∀ i : F.Hist flat, FitsCatalog (F.terminal flat i) templates (1/4)) →
      ∃ output : ∀ i : F.Hist flat, SiteOutput (F.terminal flat i) (d+1) L A Cout H,
        (∀ i, (output i).routes.potential weight / (k : ℝ)^b ≤
          maximumLeaf hk id (fun z => (sites z).routes.potential weight) / 2 + E*V) ∧
        ∀ x : Ports (fun z : Fin (k^b) × P => bits z.2),
          (parallelPacks (fun i => (sites i).pack)).tensor x =
            ∑ i : F.Hist flat, (flattenPack b (F.terminal flat i).pack).tensor x := by
  classical
  obtain ⟨C,hC,prepare⟩ := terminal_catalog_rounding
  obtain ⟨L,hL,hgen,final⟩ := prepare I (1/4) (by norm_num)
  obtain ⟨ν,hν,h,hh,scale⟩ := exists_physical_epoch (I := I) e hm
  obtain ⟨b,hb,epoch⟩ := scale L (Fintype.card I*C) hL.le (mul_nonneg (Nat.cast_nonneg (Fintype.card I)) hC)
  refine ⟨L,hL,hgen,ν,hν,h,hh,b,hb,?_⟩
  intro δ hδ templates hT
  obtain ⟨a,H,Cout,hout,finish⟩ := final templates hT
  refine ⟨a,H,Fintype.card I*C,Cout,?_⟩
  intro B _ u v hu hv
  obtain ⟨weight,hw,E,hE,event⟩ := epoch B u v (Fintype.card (Hop I L δ)) Cout hu hv (Nat.cast_nonneg _) hout
  refine ⟨weight,hw,E,hE,?_⟩
  filter_upwards [event] with k ek
  obtain ⟨hk,bound⟩ := ek
  refine ⟨hk,?_⟩
  intro P _ bits states depth view F V hV htiles hrows d hd flat sites fits
  let M := maximumLeaf hk id (fun z => (sites z).routes.potential weight)
  have hM : 0 ≤ M := by
    let i : Fin (k^b) := ⟨0,pow_pos hk _⟩
    obtain ⟨hn,hx⟩ := (sites i).routes.nonneg_width_concentration
    exact (add_nonneg hn (mul_nonneg hw.le hx)).trans (leaf_le_maximum hk id (fun z => (sites z).routes.potential weight) i)
  have start (i : Fin (k^b)) : (view 0 (flat i)).length ≤ M*L ∧ (view 0 (flat i)).concentration ≤
      M*(Fintype.card (Hop I L δ)/weight) := by
    rw [(sites i).realizes]
    exact ((sites i).routes.initial_placed_bounds hδ hL.le hw (leaf_le_maximum hk id (fun z => (sites z).routes.potential weight) i)).2
  let leaf := leavesEquiv k (states 0) b flat
  have est := bound depth view F M V hM hV htiles hrows leaf (allLeaves_of_flat _ b flat start)
  let output (i : F.Hist flat) : SiteOutput (F.terminal flat i) (d+1) L (Fintype.card I*C) Cout H := (finish hd (F.terminal flat i)
    (F.executed_canonical hb _) (fits i)).some
  refine ⟨output,?_,fun x => (input_tensor (fun j => view 0 (flat j)) sites x).trans (F.terminal_tensor flat x)⟩
  intro i
  obtain ⟨_,hW,hX⟩ := F.executed_coordinates b ((F.system.histories b le_rfl leaf).term i)
  apply le_trans _ (est i)
  apply div_le_div_of_nonneg_right _ (by positivity)
  unfold SiteRoutes.potential
  exact (add_le_add (output i).width_le (mul_le_mul_of_nonneg_left (output i).concentration_le hw.le)).trans_eq
    (by
      change Fintype.card I*C*(F.executed b _).length + weight*(Cout*(F.executed b _).concentration) = _
      rw [hW,hX]; ring)

end Epoch.Round

end BorderVNP
end Computability
end OAI
