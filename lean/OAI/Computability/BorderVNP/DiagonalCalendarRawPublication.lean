private def joinedWriterEvidence (scan metadata : PSigma (fun claim : Prop => claim)) :
    PLift (scan.1 ∧ metadata.1) :=
  ⟨⟨scan.2,metadata.2⟩⟩

set_option cleanup.letToHave false in
set_option maxHeartbeats 8000000 in
/-- The chronological directory scan of a particular issued pin, retaining
its geometry return, pin spelling, published placement and packet image. -/
noncomputable def SignedCalendarAt.frozenRawWriterAt
    (routing : LocatedFrozenRoutingAt cube b φ q adv c charge (l+1))
    (values : (seedBundle tape₁ axes d₁ order₁ position copies₁).Tables F)
    (h : (packHistory (seed₁ values) (plan₁).compiled.machine.epoch T₁).Index)
    (p : headers₁) (pin : Fin pins₁ → Bool) (wire : HeaderExterior layout₁ p.bits) (u : Fin (R₁+1))
    (node : BootedPinStart SparseExterior.driver wired₁ (physical₁).publicWords registers₁ address₁ pin wire.val u)
    (g : Fin node.start.guessWidth → Bool)
    (proof : cal.PublishedSiteAt grid qpos position chart reader chargeFit values h p pin wire u node g) :=
  joinedWriterEvidence
    (cal.frozenRawWriterScanAt grid qpos position chart reader chargeFit routing values h p pin wire u node g proof)
    (cal.frozenRawWriterMetadata grid qpos position chart reader chargeFit values h p pin wire u node g proof)

set_option cleanup.letToHave false in
set_option maxHeartbeats 10000000 in
/-- The signed calendar's genuine raw directory scan and its physical
packet image on every pin, including declarations outside the cube range. -/
noncomputable def SignedCalendarAt.frozenRawPublication
    (routing : LocatedFrozenRoutingAt cube b φ q adv c charge (l+1))
    (values : (seedBundle tape₁ axes d₁ order₁ position copies₁).Tables F)
    (h : (packHistory (seed₁ values) (plan₁).compiled.machine.epoch T₁).Index)
    (p : headers₁) (encoded : ((code₁ values) h).val=p.profile)
    (fixed : Routing.Block (R₁+1)) (pin : Fin pins₁ → Bool) (wire : HeaderExterior layout₁ p.bits) :=
  let returned := cal.frozenSites_published_pin grid qpos position chart reader chargeFit routing values h p encoded fixed pin wire
  let chosen := cal.frozenSites_boots grid qpos position chart reader chargeFit fixed
  let nodes := chosen.2.choose pin ⟨wire.val,returned.choose⟩
  fun (u : Fin (R₁+1)) (g : Fin (nodes u).start.guessWidth → Bool) =>
    cal.frozenRawWriterAt grid qpos position chart reader chargeFit routing values h p pin wire u (nodes u) g
      (returned.choose_spec u g)

