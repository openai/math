/-- Install the entire returned-row construction on this selected network, its native slot
injection, its received report chart and its actual slotted directory. A physical report
and its own fragment emission suffice for every proposal. -/
noncomputable abbrev issuedSparseFieldsBeforeArguments :=
  routedSparseFieldsBeforeArguments (r:=r) («literalW»:=literalW) (link:=link) (entries:=(deliveries).entries)
    («desc»:=desc) (pred:=k) (w:=rw) (task) net (B).cell (B).edgeID (B).owners (B).slot (packed).label
    charts home bundle supply wire pp lp
    (live_pair_slots (r:=r) (w:=literalW) (link:=link) («desc»:=desc) net (B).cell (B).edgeID port original gap)
    (fun out base counts j => (Nat.le_add_right _ _).trans
      (private_after_returned_supply net (B).cell (B).edgeID port deliveries original live gap out base counts j))
    (fun c => (FinalReports.bank_sizes net (B).cell (fun s => ((B).programs s).program) c).2.2)

