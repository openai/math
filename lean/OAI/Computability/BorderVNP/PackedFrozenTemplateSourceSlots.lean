include pw room hook in
/-- Every public template reference reads the signed original absolute pointer on this
chosen seed and native code. The owner, edge and port order and prefix displacement
all come from that history's sewn network. -/
theorem frozen_template_sourceSlots
    (sizes : ∀ c, guessedSize finalN cells₁ c+
      siteSize finalN cells₁ c (fun v => (rawState v).program.size)+suppliedSize finalN cells₁ c<2^packetWidth)
    (fits : arena+cells*stride<2^packetWidth)
    (extents : ∀ c, suppliedSize finalN cells₁ c+gap+J₁*desc ≤ stride) (j : Fin J₁) :
    (tpl₁).arguments args₁ field₁ (ptr₁ j) = arena+(cells₁ (hosts j)).val*stride+
      (NativeDemands.destination finalN cells₁ edge₁ port₁ actualDir hosts live gap (.inl j)).2 := by
  have physical := (plan.frozen_signed_packet_geometry G order position W tag sites edges ports table x wr hm
    seeds number widths ord fit actual count cellNumber vf cf hg short pw extend room hook q).2.1
  have selected := plan.frozen_original_pins G order position W tag sites edges ports table x q actualDir sitePos
  exact SignedFields.template_native_destination (s:=actualShape) actualDir F₂ occupied₁ (fun _ => true) boxes₁ hist₁
    old₁ arena stride gap gadgets digits (.inr true) ((source₂).eval input₁) saved₁ (tpl₁) field₁
    finalN cells₁ (fun v => (rawState v).program) (s₁).rows.site edge₁ port₁ physical sizes hosts live
    (fun i => congrFun selected i) fits extents j

include pw room hook in
/-- On the equal enriched terminal host assignment these same issued reference words
are the addresses of the selected report sources, using the genuine enriched
cell and port order for every prefix. -/
theorem frozen_template_enrichedSourceSlots
    (installed : (seed₀).val.pack.layout = (wiredGrid actual axes d order position).groupedRepeat
      (fun _ : Fin tiles => g₁) order copies) :
    let N := enrichedSewnLayout actual axes d order position count (compiled).machine seed₀ installed q
    let ps := enrichedSewnPrograms actual axes d order position count (compiled).machine seed₀ installed oldPort hp₁ q prior₁
    (∀ c, guessedSize N cells₁ c+siteSize N cells₁ c (fun v => (ps v).program.size)+suppliedSize N cells₁ c<2^packetWidth) →
    arena+cells*stride<2^packetWidth → (∀ c : Fin cells, Nat.le (suppliedSize N cells₁ c+gap+J₁*desc) stride) → ∀ j : Fin J₁,
      (tpl₁).arguments args₁ field₁ (ptr₁ j) = arena+(cells₁ (hosts j)).val*stride+
        (NativeDemands.destination N cells₁ edge₁ port₁ actualDir hosts live gap (.inl j)).2 := by
  intro N ps sizes fits extents j
  have physical := plan.frozen_issued_enriched_rep G order position W tag sites edges ports table x wr hm seeds
    number widths ord fit actual count cellNumber vf cf hg short pw extend room hook q installed
  have selected := plan.frozen_original_pins G order position W tag sites edges ports table x q actualDir sitePos
  exact SignedFields.template_native_destination (s:=actualShape) actualDir F₂ occupied₁ (fun _ => true) boxes₁ hist₁
    old₁ arena stride gap gadgets digits (.inr true) ((source₂).eval input₁) saved₁ (tpl₁) field₁
    N cells₁ (fun v => (ps v).program) (s₁).rows.site edge₁ port₁ physical sizes hosts live
    (fun i => congrFun selected i) fits extents j

