/-- The owned output's three fragment lengths come from the candidate's
published directory and the actual retained writer. This holds before a
report tape or any private cell report has been accepted. -/
theorem ReturnedCandidateReports.ownedFrameCounts {q : NativeAssignments.Routed (b:=t.cube.b) (s:=t.cube.s) owns}
    (actual : ReturnedCandidateReports N t cell recv size raw site origin state siteID edgeID portID F
      original live host hdr body factors bank (b:=b) (gap:=gap) slot
      (ep:=ep) (em:=em) (er:=er) (out:=out) counts (outputs:=outputs) (x:=x) q) (u : Fin (R+1)) (cap : d.candidates ≤ t.cube.maxRows) :
    let m := readings (out u)
    m (base(u)+7)=t.cube.cables ∧ m (base(u)+9)≤t.cube.maxRows ∧ m (base(u)+11)=t.cube.cells := by
  intro m
  have loaded := (site u).input
  rw [actual.literal u] at loaded
  have native := (site u).receipt.native_entry t (site u).placement (f u) (actual.old u) (origin u)
    t.cube.cables t.cube.cells actual.pin actual.subtotal (site u).fresh (site u).gates (site u).outputs
    (site u).width (site u).off (site u).ell (site u).control (site u).profile (site u).claims
    (site u).pad raw (site u).actual loaded
  have kept := (actual.opened.2 u).retained
  have low := kept.primary
  have read (i : ℕ) (hi : i<112) (a : i≠13) (b : i≠46) :
      m (base(u)+i) = readings (site u).published.val.2.2 (base(u)+i) :=
    (kept.lower _ (by omega) (by omega) (by omega)).trans (native.low _ (by omega))
  have dims := (site u).dimensions
  have relocate (i : ℕ) := congrArg (fun base => readings (site u).published.val.2.2 (base+i)) (site u).origin
  exact ⟨(read 7 (by decide) (by decide) (by decide)).trans ((relocate 7).trans dims.2.1),
    (read 9 (by decide) (by decide) (by decide)).le.trans
      ((relocate 9).le.trans (dims.2.2.1.le.trans ((d.directory_length_le pp lp).trans cap))),
    (read 11 (by decide) (by decide) (by decide)).trans ((relocate 11).trans dims.1)⟩

