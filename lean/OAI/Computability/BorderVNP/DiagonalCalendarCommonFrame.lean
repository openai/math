/-- Register zero of each deployed calendar team contains the natural startup
frame. The size bound rules out truncation when this address is made a word. -/
theorem SignedCalendarAt.frozenSites_frame (u : Fin (R₁+1)) :
    ((selectedSites).publicWords u 0).val=(initial₁).frame := by
  have room := (cal.frozenTask_room grid qpos position chart reader chargeFit).2.2.2.2.1
  have operands := reader.deployed_publicOperands prog₁ P₁ blank₁ (geo₁).fits W₁ position sites₁ edges₁ ports₁
    copies₁ ((fan S)^T₁) header layout₁ table₁ selectedTask outside₁ u
  have value := congrArg (fun pub : Arg → Word w₁ => (pub 0).val) operands
  exact value.trans (Nat.mod_eq_of_lt ((Nat.le_add_right _ _).trans_lt room))

/-- All report layouts of the installed evaluator use the same starting frame. -/
theorem SignedCalendarAt.frozenSites_frames :
    (fun u : Fin (R₁+1) => ((selectedSites).publicWords u 0).val) = fun _ => (initial₁).frame :=
  funext (cal.frozenSites_frame grid qpos position chart reader chargeFit)

