import OAI.Computability.BorderVNP.CellBranchDispatch
import OAI.Computability.BorderVNP.CellLoopDispatch
import OAI.Computability.BorderVNP.CellGeneratorDepth

/-! # Compact private serialization and dynamic charges of sparse command generators

Sequences concatenate records. A loop contains its bound and one stored body. Branch records
store both alternatives while the execution charge visits only the chosen one. Fixed reads
are encoded as binary literal addresses and converted to unary only inside the private call.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace CellMacro.Generator

open CellSparse RationalHitting.StackLanguage

/-- An encoded address node in a compact private record. -/
def exprBits (d : ℕ) (e : NatExpr) := Coding.code (Address.pack d e)

/-- A compact command record sequence, prior to record framing. -/
def wire (d : ℕ) : Stmt → List (List Bool)
  | .nil => []
  | .seq a b => wire d a ++ wire d b
  | .fixed (.read k) => [[false,false,true] ++ exprBits d (.lit k)]
  | .fixed o => [[false,false,false] ++ o.bits]
  | .read e => [[false,false,true] ++ exprBits d e]
  | .bit v i => [[false,true] ++ Coding.code (Address.pack d v,Address.pack d i)]
  | .loop e b => [[true,false] ++ Loop.payload (exprBits d e) (records (wire d b))]
  | .ifEq a b y n => [[true,true] ++ branchPayload (exprBits d (difference a b))
      (records (wire d y)) (records (wire d n))]

/-- The actual compact generator argument at the outer RAM/private-tape boundary. -/
def serialized (d : ℕ) (s : Stmt) : List Bool := records (wire d s)

/-- A command's compact input, its actual generated instruction bits, and an upper bound
on the native stack work of this invocation of the installed command handler. -/
structure Job where
  /-- One compact command payload. -/
  input : List Bool
  /-- The chronological elementary instruction bits generated by this invocation. -/
  output : List Bool
  /-- Time of the command handler before including the outer record scan. -/
  ticks : ℕ

/-- Charge of a sparse list of command invocations, including input record framing. -/
def scanCost (js : List Job) : ℕ :=
  (js.map (fun j => 2*(7*j.input.length+10)+j.ticks+1)).sum+1

/-- Dynamic time bounds of the two fixed binary expression procedures. -/
structure Clocks where
  /-- Evaluate one expression on the lexical environment. -/
  expr : NatExpr → List ℕ → ℕ
  /-- Extract one binary digit at an expression-specified offset. -/
  bit : NatExpr → NatExpr → List ℕ → ℕ

private def fixedJob (o : Op) : Job :=
  ⟨[false,false,false] ++ o.bits, o.bits, 3+4*o.bits.length+2⟩

private def readJob (cl : Clocks) (d : ℕ) (e : NatExpr) (env : List ℕ) : Job :=
  let n := e.eval env
  ⟨[false,false,true] ++ exprBits d e, (Op.read n).bits,
    3+cl.expr e env + (7*n+8)*n.bits.length+4*n+9⟩

/-- Dynamic account of the private visits to a sparse program. It is a cost specification;
the tape input is always the compact `serialized` representation. -/
def jobs (cl : Clocks) (d : ℕ) : Stmt → List ℕ → List Job
  | .nil, _ => []
  | .seq a b, env => jobs cl d a env ++ jobs cl d b env
  | .fixed (.read k), env => [readJob cl d (.lit k) env]
  | .fixed o, _ => [fixedJob o]
  | .read a, env => [readJob cl d a env]
  | .bit v i, env => [⟨[false,true] ++ Coding.code (Address.pack d v, Address.pack d i),
      (Op.literal ((v.eval env).testBit (i.eval env))).bits, 2 + cl.bit v i env⟩]
  | .loop a b, env =>
    let e := exprBits d a
    let body := serialized d b
    let n := a.eval env
    [⟨[true,false] ++ Loop.payload e body, stream ((Stmt.loop a b).expand env),
      2+Loop.overheadDispatch e body n+cl.expr a env+
        Loop.sweepCost body (Coding.code env) (fun i => scanCost (jobs cl d b (i::env))) 0 n⟩]
  | .ifEq a b y n, env =>
    let e := difference a b
    let yes := serialized d y
    let no := serialized d n
    let c := if a.eval env = b.eval env then scanCost (jobs cl d y env) else scanCost (jobs cl d n env)
    [⟨[true,true] ++ branchPayload (exprBits d e) yes no, stream ((Stmt.ifEq a b y n).expand env),
      2+cl.expr e env+c+Branch.overhead (exprBits d e) yes no (e.eval env).bits⟩]

/-- Runtime counters change the expansion and costs, while the sparse description depends
only on the input generator. -/
theorem job_inputs (cl : Clocks) (d : ℕ) (s : Stmt) (env : List ℕ) :
    (jobs cl d s env).map Job.input = wire d s := by
  induction s generalizing env with
  | fixed o => cases o <;> rfl
  | seq a b iha ihb => simp [jobs,wire,iha,ihb]
  | _ => rfl

/-- The chronological concatenation of dynamic command outputs is the full emitted bytecode. -/
theorem job_outputs (cl : Clocks) (d : ℕ) (s : Stmt) (env : List ℕ) :
    (jobs cl d s env).flatMap Job.output = stream (s.expand env) := by
  induction s generalizing env with
  | fixed o => cases o <;> simp [jobs,readJob,fixedJob,stream,Stmt.expand,NatExpr.eval]
  | seq a b iha ihb => simp [jobs,Stmt.expand,iha,ihb,stream]
  | loop | ifEq => simp [jobs]
  | nil | read | bit => simp [jobs,readJob,Stmt.expand,stream]

end CellMacro.Generator

end BorderVNP
end Computability
end OAI
