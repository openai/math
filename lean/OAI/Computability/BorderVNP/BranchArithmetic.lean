import OAI.Computability.BorderVNP.BranchFieldEmbedding
import OAI.Computability.BorderVNP.BranchCurveModel

/-!
# The arithmetic function field of the constructed branch

Over a finite advice field, restrict the geometric place to the field generated by the
affine parameters and the deformation parameter. Nonsingularity ensures a finite
separable extension. Its normalized place has finite residue field and preserves the
prescribed residues of all coefficient outputs.
-/

namespace OAI
namespace Computability
namespace BorderVNP

universe u

namespace Branch

open MvPolynomial

/-- Descend the actual simultaneous branch from the ambient constants to its finite
field of equations. The resulting valuation is discrete, has finite residue field,
and specializes all the same outputs. -/
theorem advice_field_branch {E K : Type u} [Field E] [Finite E] [Field K] {I : Type*} {h : ℕ}
    (i : E →+* K) (Y : I → MvPolynomial (Fin h) E) (c : I → E)
    (g : Fin h → MvPolynomial (Fin h) (DeformationField E))
    (M : GeometricBranch (fun j => map i (Y j)) (i ∘ c)
      (fun j => map (deformationMap i) (g j))) :
    ∃ B : GeometricBranch Y c g, Finite (IsLocalRing.ResidueField B.place) := by
  let F := DeformationField E
  let T := DeformationField K
  let emb := (algebraMap T M.L).comp (deformationMap i)
  let : Algebra F M.L := emb.toAlgebra
  have embedPoly (p : Polynomial E) : algebraMap F M.L (algebraMap _ _ p) =
      algebraMap T M.L (algebraMap _ _ (p.map i)) := by
    change emb _ = _
    exact congrArg (algebraMap T M.L) (deformationMap_polynomial i p)
  have coeffs : (algebraMap F M.L).comp (algebraMap E F) = (algebraMap K M.L).comp i := by
    ext e
    change algebraMap T M.L (deformationMap i (algebraMap E F e)) = algebraMap K M.L (i e)
    rw [deformationMap_constant, ← IsScalarTower.algebraMap_apply K T M.L]
  have ev (p : MvPolynomial (Fin h) F) :
      aeval M.x (map (deformationMap i) p) = aeval M.x p := by
    rw [aeval_def, eval₂_map]; rfl
  have hroot (j) : aeval M.x (g j) = 0 := (ev _).symm.trans (M.root j)
  have hJ : (Matrix.of fun j l => aeval M.x (pderiv l (g j))).det ≠ 0 := by
    have eq (j l) : aeval M.x (pderiv l (map (deformationMap i) (g j))) =
        aeval M.x (pderiv l (g j)) := by rw [pderiv_map, ev]
    simpa only [eq] using M.jacobian
  have hv (p : MvPolynomial (Fin h) E) :
      aeval M.x (map (algebraMap E F) p) = aeval M.x (map i p) := by
    rw [aeval_def, aeval_def, eval₂_map, eval₂_map, coeffs]
  obtain ⟨xs, hx, gen, hd, hs, hdisc, hfin, ho⟩ := restricted_branch_over_finite_field
    g M.x hroot hJ M.place (fun p => (embedPoly p) ▸ M.regular (p.map i))
    (by rw [embedPoly]; simpa using M.parameter_zero)
    (fun j => map (algebraMap E F) (Y j)) (algebraMap E F ∘ c) (fun j => by
      rw [hv]
      have e := RingHom.congr_fun coeffs (c j)
      change aeval M.x (map i (Y j)) ∈ M.place ∧
        aeval M.x (map i (Y j)) - (algebraMap F M.L).comp (algebraMap E F) (c j) ∈ M.place.nonunits
      rw [e]
      exact M.outputs j)
  let S := IntermediateField.adjoin F (Set.range M.x)
  let V := M.place.comap S.val.toRingHom
  let : Algebra E S := ((algebraMap F S).comp (algebraMap E F)).toAlgebra
  have tower : IsScalarTower E F S := .of_algebraMap_eq fun _ => rfl
  have ex (p : MvPolynomial (Fin h) F) : S.val (aeval xs p) = aeval M.x p := by
    rw [comp_aeval_apply]; exact congrArg (fun z => aeval z p) hx
  have rootS (j) : aeval xs (g j) = 0 := S.val.injective ((ex _).trans ((hroot j).trans (map_zero _).symm))
  let Jsource :=  Matrix.of fun j l => aeval xs (pderiv l (g j))
  have Jmap : Jsource.map S.val = Matrix.of fun j l => aeval M.x (pderiv l (g j)) := by
    ext j l
    exact ex _
  have hj : Jsource.det ≠ 0 := by
    intro hz
    apply hJ
    rw [← Jmap]
    exact (S.val.map_det Jsource).symm.trans ((congrArg S.val hz).trans (map_zero _))
  have hreg (p : Polynomial E) : algebraMap F S (algebraMap _ _ p) ∈ V := by
    apply ValuationSubring.mem_comap.mpr
    rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes, embedPoly]
    exact M.regular _
  have h0 : algebraMap F S (algebraMap (Polynomial E) F Polynomial.X) ∈ V.nonunits := by
    apply (vanishes_at_comap M.place S.val.toRingHom _).mpr
    change S.val (algebraMap F S _) ∈ M.place.nonunits
    rw [AlgHom.commutes, embedPoly]; simpa using M.parameter_zero
  have out (j) : aeval xs (Y j) ∈ V ∧ aeval xs (Y j) - algebraMap E S (c j) ∈ V.nonunits := by
    have ey : aeval xs (map (algebraMap E F) (Y j)) = aeval xs (Y j) := by
      rw [aeval_def, eval₂_map, ← IsScalarTower.algebraMap_eq E F S]; rfl
    rw [IsScalarTower.algebraMap_apply E F S]
    simpa only [ey, Function.comp_apply] using ho j
  let N : GeometricBranch Y c g :=
    { L := S
      x := xs
      generates := gen
      finiteDegree := hd
      separable := hs
      root := rootS
      jacobian := hj
      place := V
      discrete := hdisc
      regular := hreg
      parameter_zero := h0
      outputs := out }
  exact ⟨N, hfin⟩

end Branch

end BorderVNP
end Computability
end OAI
