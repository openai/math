/-- The true terminal programs after the chosen calendar history and exterior
sewing, with the installed native row and scalar numberings. -/
noncomputable abbrev SignedCalendarAt.frozenSitesOriginalPrograms
    (values : (seedBundle (tape₁) axes d₁ (order₁) position copies₁).Tables F)
    (history : (packHistory (seed₁[values]) (plan₁).compiled.machine.epoch T₁).Index) :
    Packing.Inherited.Site.Programs (netAt[values,history]) := stateAt[values,history]

/-- The entire cell word extent, including the actual local program sizes,
fits the signed machine word on every attained enriched calendar history. -/
theorem SignedCalendarAt.frozenSites_original_addressFit
    (values : (seedBundle (tape₁) axes d₁ (order₁) position copies₁).Tables F)
    (history : (packHistory (seed₁[values]) (plan₁).compiled.machine.epoch T₁).Index) :
    let N := netAt[values,history]
    let cell := cellsAt[values,history]
    let states := cal.frozenSitesOriginalPrograms grid qpos position chart reader chargeFit values history
    ∀ c, guessedSize N cell c+siteSize N cell c (fun v => (states v).program.size)+suppliedSize N cell c<2^w₁ := by
  intro N cell states
  let oldPort := Packing.Inherited.Flat.portRows T₁ (privatePorts schedule₀ seedIndex T₁)
  have measured := (plan₁).frozen_signed_packet_fields (tape₁) order₁ position cal.frozenWitness tag nameSite
    nameEdge namePort values x₁ roundNames paidID oldPort (wired₁) grid.count valid₁ owners₁ hm rfl history dir₁ grid.sites_pos
  have packet := grid.packet_inputs φ q adv c charge factor coeff cal.output (tape₁)
    (grid.template_directory (pins₁) (geo₁)).1 grid.link_eq.symm (order₁) position description grid.sites_pos
  have shortWord : 60*logWidth r₁ (l+1) ≤ w₁ := packet.2.1.2.2.2.1
  intro cellID
  exact ((measured.1 cellID).trans_lt grid.source_bounds.2).trans_le (Nat.pow_le_pow_right (by decide) shortWord)

