  sites₁ edges₁ ports₁ v x₁

open Packing.RoutingOutputs

private def routingEvidence {P : Prop} (h : P) : PSigma fun q : Prop => q := ⟨P,h⟩

set_option cleanup.letToHave false in
set_option maxRecDepth 13000 in
set_option maxHeartbeats 8000000 in
private noncomputable def argumentImage
    (values : (seedBundle tape₁ axes d₁ order₁ position copies₁).Tables F)
    (history : (packHistory (seed₁ values) (plan₁).compiled.machine.epoch T₁).Index)
    (ram : ℕ → ℕ)
    (packet : cal.frozenPacketImage grid qpos position chart reader chargeFit values history ram) :
    PSigma fun q : Prop => q :=
  let named := (plan₁).frozen_routing_image tape₁ order₁ position cal.frozenWitness tag₁ sites₁ edges₁ ports₁
    values x₁ history dir₁ grid.sites_pos _ _ _ _ packet.1
  routingEvidence <| named.atIssuedOrigin (cal.frozenIssuedPlacement grid qpos position chart reader chargeFit).2.2.1

/-- A packet on the native report has the original verifier's site numbers and
the grouped live ports at the installed destination address. -/
theorem SignedCalendarAt.argumentRoutingImage
    (values : (seedBundle tape₁ axes d₁ order₁ position copies₁).Tables F)
    (history : (packHistory (seed₁ values) (plan₁).compiled.machine.epoch T₁).Index)
    (ram : ℕ → ℕ)
    (packet : cal.frozenPacketImage grid qpos position chart reader chargeFit values history ram) :
    (argumentImage cal grid qpos position chart reader chargeFit values history ram packet).1 :=
  (argumentImage cal grid qpos position chart reader chargeFit values history ram packet).2

open Lean Meta Elab Term in
/-- Recover the original routing image from the actual frozen packet and its
own field, history and RAM arguments. -/
elab (name := issuedArgumentImage) "issuedArgumentImage% " source:term:max : term => do
  let packet ← elabTerm source none
  let some info ← whnfUntil (← inferType packet) ``SignedCalendarAt.frozenPacketImage
    | throwError "expected the packet on the actual geometry return"
  return mkAppN (← mkConstWithLevelParams ``SignedCalendarAt.argumentRoutingImage) (info.getAppArgs.push packet)

