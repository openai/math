private noncomputable def frozenReturnedEvidence
    (values : (seedBundle (tape₁) axes d₁ (order₁) position copies₁).Tables F)
    (h : Index (Fin (Module.finrank (ZMod common.p) chart.E)) (Fin (pairedTableParameters (l+1) size₁))
      (chart.pinRadius (R₁+1) r₁))
    (entries : history(values) → ℕ)
    (i : Fin pins₁ → Bool) (hist : history(values)) (claim : Fin ((R₁+1)*(qdim)*w₁) → Bool)
    (checked : cal.FrozenRouteChecks grid qpos position chart reader chargeFit values h entries i hist claim) : PSigma fun q : Prop => q :=
  ownershipEvidence <|
    (plan₁).signedEligibleReturnedOwner (D:=D) (m:=«m») (e:=paid) (S:=S) (R:=R₁) (r:=r₁) (pins:=pins₁)
      (link:=ℓ₁) (k:=l) (d:=d₁) (a:=extra₁) (regs:=64) (rw:=w₁) (ec:=ec₁) (width:=w₁+1)
      (s:=size₁) (copies:=copies₁) (T:=T₁) (header:=header) (work:=Q)
      prog₁ (geo₁).fits W₁ position tag₁ sites₁ edges₁ ports₁ values ((geoSeed).eval x₁) (leaf(values)).property
      (fun t i z => ((ExternalSew.RowTrace.seedNumber S (d₁+1) t i) z).val) free₁ grid.count
      (Sum.inl : paid.Entry → identifiers) numberIDs (bounds₁).2.1 cube scales.α ξ₁ (bounds₁).1 (geo₁).literalSize
      (bounds₁).2.2 number₁ (selectedTask).p arenaBase cap₁ (fun u => ((selectedSites).publicWords u 0).val)
      (fun _ => origin₁) (selectedSites).publicWords (selectedSites).registers addresses (fullPin h)
      layout₁ hold₁ (grid.word_eq.symm ▸ Nat.pow_pos grid.log_pos) (fun _ => rfl)
      (fun u => ((selectedSites).publicWords u 0).val) (room:=fun u => ((boots₁).1 u).1.physical)
      (cal.frozenLayout_fields chart reader chargeFit).1 (codec(values)) ((boots₁).2.choose (fullPin h)) i hist claim
      (by
        intro dim pinCount inner Edge finite G
        exact cal.frozenRouteAdmission grid G) ((selectedTask).lookupFrame 0) (entries hist) (show CheckedRouteInputs _ from checked).sites (show CheckedRouteInputs _ from checked).survives

set_option cleanup.letToHave false in
set_option maxRecDepth 12000 in
