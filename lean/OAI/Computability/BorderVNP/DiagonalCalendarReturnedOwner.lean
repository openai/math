/-- Read the real ownership receipt on every route and private report of this selected
calendar field. Its source is the inverse of the same candidate and public pin as the
calendar’s routed input, and its owner run is the original unmodified joint preparation. -/
theorem SignedCalendarAt.frozenIssuedOwnershipAtOfCandidates
    (values : (seedBundle (tape₁) axes d₁ (order₁) position copies₁).Tables F)
    (h : Index (Fin (Module.finrank (ZMod common.p) chart.E)) (Fin (pairedTableParameters (l+1) size₁))
      (chart.pinRadius (R₁+1) r₁))
    (entries : history(values) → ℕ)
    (valid : ∀ (i : Fin pins₁ → Bool) (hist : history(values)) (claim : Fin ((R₁+1)*(qdim)*w₁) → Bool),
      cal.FrozenRouteChecks grid qpos position chart reader chargeFit values h entries i hist claim)
    (i : Fin pins₁ → Bool) (hist : history(values)) (claim : Fin ((R₁+1)*(qdim)*w₁) → Bool) :
    (frozenReturnedEvidence cal grid qpos position chart reader chargeFit values h entries i hist claim (valid i hist claim)).1 :=
  (frozenReturnedEvidence cal grid qpos position chart reader chargeFit values h entries i hist claim (valid i hist claim)).2

