private theorem controls_before_bundle (addr cables cells privateCount live packet : ℕ) :
    RoutingOutputs.controlsBase addr cables cells privateCount live ≤
      addr+signedGridOutputCount cables cells privateCount live 37 packet := by
  simp only [RoutingOutputs.controlsBase,RoutingOutputs.bases,RoutingOutputs.count,signedGridOutputCount]
  omega

/-- The issued opener addresses its sorted payload after its controls and
its inverse permutation immediately after the complete marked payload. -/
theorem SignedCalendarAt.frozenOpeningBankAddresses :
    let dest := Allocation.dest fresh₁ cap₁ ((located).raw.reserve ceiling₁).size (located).outputs w₁
    let t := actualTask
    let ctl := RoutingOutputs.controlsBase dest t.cube.cables t.cube.cells J₁ liveCount
    ctl ≤ t.p.bundlePayload ∧ t.p.bundleInverse=t.p.bundlePayload+2^rankDepth := by
  intro base task ctl
  obtain ⟨_,first,last⟩ := cal.frozenSites_bundle_addresses grid qpos position chart reader chargeFit
  have cellEq : task.cube.cells=cs₁ := by
    change CoverScale.sites (Cube D) (EnrichedOuter.depth S _ T₁) = _
    rw [grid.depth_eq]
    rfl
  have cableEq : task.cube.cables=cableCount := by
    change (boundary S _ T₁).edges+4*((R₁+1)*CoverScale.sites (Cube D) _) = _
    rw [grid.depth_eq,grid.tiles_eq,Nat.mul_assoc]
    rfl
  constructor
  · change RoutingOutputs.controlsBase base task.cube.cables task.cube.cells J₁ liveCount ≤ (located).directories.bundlePayload
    rw [first,cableEq,cellEq]
    dsimp only [base]
    rw [(located).reserved_size]
    exact controls_before_bundle _ _ _ _ _ _
  · change (located).directories.bundleInverse=(located).directories.bundlePayload+2^rankDepth
    rw [first]
    exact last

