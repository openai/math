/-- Read a reached native publication at every source row of this frozen history.
The real placement and argument field may differ across scans and report proposals.
All original bundle and port coordinates come from the selected W. This is a
predicate on the physical emission, before a native continuation is chosen. -/
theorem issuedSparseSource (v : Routed (b:=cube.b) (s:=cube.width) (B).owners) (u : Fin (R+1))
    (pin : Ports (fun _ : FreeBlock R tiles => seedBlock)) (owners : Fin (B).siteRows → ℕ)
    (src : ∀ t,ReportAssignments ((received v).cells t))
    {Origin : Type} (placed : ℕ → CellPacket.Placed Origin) (extra : ℕ → List CellSparse.Record)
    (field : ℕ → SparseExterior.Field) {q₀ : ReportCursor} {banks : CellBanks.Layout}
    (allocation : ReportAllocation (task).before (task).after banks (charts u) ((received v).cells u) q₀)
    (supp : extra=seedExtras ((received v).cells u) q₀)
    (shape : ∀ c : Fin cells, (placed c.val).directory =
      FinalCell.directory owners net keyN (B).siteID (B).edgeID (B).portID progs c.val
        (countFields (FinalCell.countBase net keyN progs c.val) (charts u).gadgets (charts u).countWidth) ∧
      (placed c.val).privateWires=FinalCell.privateBits net keyN progs c.val) :
    let rr := received v
    let endSignal := pathSupply net (B).cell (B).edgeID (B).portID (B).owners (B).slot pin v
    let native := rr.physicalReportEquiv net (B).cell (B).siteID (B).edgeID (B).portID (B).programs (B).owners
      (B).slot pin owners bottom v (fun _ _ => false) rr.cells (fun _ => rfl) src
    (∀ i : Fin (rr.cells u).length, let c := rr.order ⟨u,i⟩
      (field c.val).values=List.ofFn (endSignal c)++((src u).val.get (Fin.cast (src u).length.symm i)).bits) →
    ∀ i : Fin (rr.cells u).length, let c := rr.order ⟨u,i⟩
      SparseExterior.logicalCell (placed c.val) (extra c.val) (field c.val)=rr.sourceCall net (B).cell (B).siteID (B).edgeID
        (B).portID (B).programs (B).owners (B).slot pin owners bottom v (fun _ _ => false) native u i := by
  intro rr endSignal native bits i c
  subst extra
  apply rr.sourceCall_of_seen net (B).cell (B).siteID (B).edgeID (B).portID (B).programs (B).owners (B).slot pin
    owners bottom v (fun _ _ => false) native u i (placed c.val) _ (field c.val) (bits i)
  exact plan.signedReport_seen p fit W position code sites edges ports table words good seeds free count pos num hp q
    cube α ξ calibrated lit hd number parameters arenaBase profileBits frame origin v u i owners allocation
    (placed c.val) (field c.val) (shape c)

