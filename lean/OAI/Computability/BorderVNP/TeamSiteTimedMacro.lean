import OAI.Computability.BorderVNP.TeamPrivateTimeoutReplay
import OAI.Computability.BorderVNP.TeamSitePrivate

/-! # Timed private macro calls on the physically gathered RAM words -/

namespace OAI
namespace Computability
namespace BorderVNP

namespace TeamSite.Macro

open VPVNP.RAMTape VPVNP.BurstRAM TeamPrivateTape TeamPrivateFragment TeamSiteChoices
open TeamPrivateTimeout TeamPrivateCall

variable {Q Γ : Type} {m g w : ℕ} (M : TeamSite.Macro Q Γ m g) (mark : Γ)

/-- The true symbol tapes loaded from the burst, extended by the independently
prepared unary meter on tape zero. -/
def timedSymbols (n : ℕ) (vs : List (Word w)) :=
  timedTapes M.alphabet.blank mark [] n
    (input M.alphabet.blank M.digit M.inputTape (inputBits vs))

/-- The private tracks after data loading and trusted timer installation. -/
noncomputable def timedInitial (n : ℕ) (vs : List (Word w)) :=
  tracks M.alphabet (M.timedSymbols mark n vs)

/-- The transition table in the actual native bit-track control. -/
noncomputable def timedTable :=
  trackTable M.alphabet (TeamPrivateTimeout.table M.alphabet.blank mark M.table)

/-- Signed result of the native timed call, with the exact private path bits. -/
noncomputable def timedEval (n : ℕ) (vs : List (Word w)) (bits : List Bool) : Option TeamRAM.Sign :=
  (evaluate (M.timedTable mark) (n+1) M.start (M.timedInitial mark n vs) bits).map (fun z => sign z.1)

/-- Uniform clock for all bit tracks on every burst, even a malformed one. -/
theorem timedStops (hmark : M.alphabet.blank ≠ mark) (n : ℕ) (vs : List (Word w)) :
    TeamPrivateValue.Stops (M.timedTable mark) (n+1) M.start (M.timedInitial mark n vs) :=
  (TeamPrivateValue.track_stops_iff ..).2 (stops M.alphabet.blank mark M.table hmark n M.start [] _)

/-- On a bounded original call the timed code gives precisely the same result
for every string, including zero paths and surplus unused bits. -/
theorem timedEval_eq (n : ℕ) (vs : List (Word w)) (bits : List Bool)
    (bound : M.bounded (n+1) vs) : M.timedEval mark n vs bits = M.eval (n+1) vs bits := by
  have timed := symbolEval_tracks M.alphabet (TeamPrivateTimeout.table M.alphabet.blank mark M.table) (n+1)
    M.start (M.timedSymbols mark n vs) bits
  let ts := input M.alphabet.blank M.digit M.inputTape (inputBits vs)
  have raw := symbolEval_tracks M.alphabet M.table (n+1) M.start ts bits
  have eq := timed.trans ((symbolEval_at_stops M.alphabet.blank mark M.table n M.start [] ts bits bound).trans raw.symm)
  simpa only [Option.map_map,Function.comp_def,Macro.timedEval,Macro.eval,timedTable,timedInitial,
    Macro.initial,ts] using congrArg (Option.map sign) eq

/-- Every infinite branch supply yields a native prefix spelling by
the original transition table and the true per-call clock. The witness also
covers the zero path generated by an expired meter. -/
theorem timed_prefix_run (hmark : M.alphabet.blank ≠ mark) (n : ℕ) (vs : List (Word w)) (s : Supply) :
    ∃ a t, a ≤ t ∧ t < n+1 ∧ ∃ out u, Run (M.timedTable mark) t M.start (M.timedInitial mark n vs)
      (takeBits s a) out u ∧ M.timedEval mark n vs (takeBits s a) = some (sign out) := by
  obtain ⟨a,t,hat,ht,out,u,hr⟩ := private_prefix (M.timedStops mark hmark n vs) s
  refine ⟨a,t,hat,ht,out,u,hr,?_⟩
  simp [timedEval,evaluate_of_run hr ht]

end TeamSite.Macro

end BorderVNP
end Computability
end OAI
