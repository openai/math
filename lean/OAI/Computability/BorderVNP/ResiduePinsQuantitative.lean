import OAI.Computability.BorderVNP.ResiduePinsBranch
import OAI.Computability.BorderVNP.BranchCurveBoxOrder
import OAI.Computability.BorderVNP.ResidueApproximationParameter

/-! # Quantitative residue pins for a nonsingular arithmetic chart

The local input is a place over the vanishing parameter on the field generated by
the coordinates of a nonsingular chart root. The pole cutoff and a common extraction
power are obtained from the equation degrees. Neither the pin nor the power depends
on the input polynomial whose special value will be read.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace ResiduePins

open Residue ResidueBox Residue.JetRing Branch Module Matrix IsLocalRing
open scoped Matrix BigOperators Classical

variable {E K β : Type*} [Field E] [Fintype E] [Field K] [Fintype β]
  [Algebra E K] [Algebra (Polynomial E) K] [IsScalarTower E (Polynomial E) K]
  [Algebra (FractionRing (Polynomial E)) K] [IsScalarTower (Polynomial E) (FractionRing (Polynomial E)) K]
  (V : ValuationSubring K) [IsDiscreteValuationRing V] (p : ℕ) [Fact p.Prime]
  [CharP V p] [CharP (ResidueField V) p] [Finite (ResidueField V)] [CharP E p] [Algebra (ZMod p) E]

/-- Scalar action of the prime field on the finite residue field. -/
noncomputable local instance chartResidueAlgebra : Algebra (ZMod p) (ResidueField V) := ZMod.algebra _ _

/-- Lemma 10.1's explicit index dimension and bounded, uniformly chosen extraction
power on the branch from Proposition 9.2. The vector is nonzero and every regular
polynomial of degree at most L acts by its prime-field residue. -/
theorem quantitative_residue_pins (π : V) (hπ : Irreducible π) (t : Kˣ)
    (ht : (t : K) = algebraMap (Polynomial E) K Polynomial.X) (h0 : (t : K) ∈ V.nonunits)
    {h : ℕ} (x : Fin h → K)
    (hgen : IntermediateField.adjoin (FractionRing (Polynomial E)) (Set.range x) = ⊤)
    (g : Fin h → MvPolynomial (Option (Fin h)) E)
    (hg : ∀ i, MvPolynomial.eval₂Hom (algebraMap E K) (fun j => j.elim (t : K) x) (g i) = 0)
    (hJ : (chartJacobian (algebraMap E K) (fun j => j.elim (t : K) x) g).det ≠ 0)
    (B : Basis β (ZMod p) E) (L : ℕ) :
    let ρ := branchLaurentExpansion p π hπ K
    let φ := ρ.comp (algebraMap E K)
    let v := ρ ∘ x
    let τ := Units.map ρ.toMonoidHom t
    let J := (chartJacobian φ (fun j => j.elim (τ : LaurentSeries _) v) g).det
    let η₀ := LaurentSeries.derivative (ResidueField V) (τ : LaurentSeries _) / J
    let S := ∑ j, (g j).totalDegree
    let H := radius L S
    let Ω := pin B H (testFunctional p φ v τ η₀)
    Fintype.card (Index β (Fin h) H) = Module.finrank (ZMod p) E * (H+1)^h * (2*H+1) ∧
    ∃ u > 0, chartBoxPoleBudget h H S < p ^ u ∧
      p ^ u ≤ Fintype.card E * max (chartBoxPoleBudget h H S) 1 ∧ (∀ a : E, a ^ (p^u) = a) ∧ (∃ i, Ω i ≠ 0) ∧
      ∀ A : MvPolynomial (Fin h) E, A.totalDegree ≤ L → ∀ z : ZMod p,
        0 ≤ (MvPolynomial.eval₂ φ v A).order →
        (MvPolynomial.eval₂ φ v A).coeff 0 = algebraMap (ZMod p) (ResidueField V) z →
        (∑ μ ∈ A.support, weights B H (p ^ u) (pow_pos (Fact.out : p.Prime).pos u) g
          (RingHom.id E) (mixedIndex (polynomialIndex μ)) (A.coeff μ)) *ᵥ Ω = z • Ω := by
  intro ρ φ v τ J η₀ S H Ω
  constructor
  · simpa only [Fintype.card_fin] using (pin_dimension (σ := Fin h) B H)
  have hgen' : IntermediateField.adjoin E (insert (t : K) (Set.range x)) = ⊤ := by
    rw [ht]; exact parameter_adjoin_eq_top x hgen
  let r : V := ⟨(t : K), V.nonunits_subset h0⟩
  have hr : r ≠ 0 := fun hz => t.ne_zero (congrArg Subtype.val hz)
  have ht' : 0 < (ρ (t : K)).order :=
    positive_order_at_zero p π hπ r hr ((residue_eq_zero_iff r).mpr (V.coe_mem_nonunits_iff.mp h0))
  have hg' (i : Fin h) : MvPolynomial.eval₂Hom φ (fun j => j.elim (τ : LaurentSeries _) v) (g i) = 0 := by
    have eq := congrArg ρ (hg i)
    rw [MvPolynomial.map_eval₂Hom, map_zero] at eq
    have hy : (fun j : Option (Fin h) => j.elim (τ : LaurentSeries _) v) =
        (fun j => ρ (j.elim (t : K) x)) := by funext j; cases j <;> rfl
    rw [hy]
    exact eq
  have hJ' : J ≠ 0 := by
    have eq : ρ (chartJacobian (algebraMap E K) (fun j => j.elim (t : K) x) g).det = J :=
      map_chartJacobian_det (algebraMap E K) ρ (t : K) x g
    rw [← eq]
    exact (map_ne_zero_iff _ ρ.injective).mpr hJ
  exact branch_residue_pins p π hπ x t hgen' B L (chartBoxPoleBudget h H S) g ht' hg' hJ'
    (nonsingular_box_test_order V p π hπ t ht h0 x hgen g H B hg hJ)

end ResiduePins

end BorderVNP
end Computability
end OAI
