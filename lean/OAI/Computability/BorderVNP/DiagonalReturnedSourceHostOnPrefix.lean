variable {N t cell recv size raw site origin state siteID edgeID portID F original live host hdr body factors bank slot counts U active}
/-- At its own checked site a returned lookup matches the physical rows and
delivers all original retained bundles at the corresponding selected cells. -/
theorem ReturnedCandidateReports.sourceHostAtOwnPrefix
    {q : NativeAssignments.Routed (b:=t.cube.b) (s:=t.cube.s) owns}
    (actual : ReturnedCandidateReports N t cell recv size raw site origin state siteID edgeID portID F
      original live host hdr body factors bank (b:=b) (gap:=gap) slot
      (ep:=fun z => (U z).pub) (em:=fun z => install SparseExterior.driver n (U z).routines)
      (er:=fun z => (visit z).owned.val.2.1) (out:=fun z => (visit z).owned.val.2.2) counts (outputs:=outputs) (x:=x) q)
    {u : Fin (R+1)} :
    ∀ j : Fin d.entries, (∃ c∈(source).cells q u, c.number=(host j).val) →
      (frozen j).delivered (report(u)) d.description
          (OpenSuffix.hostImage ((U u).pub 0).val (readings (visit u).owned.val.2.2)) ∧
      (frozen j).SiteRoom (report(u)) w d.description := by
  have matched := actual.sourceRows N t cell recv size raw site origin state siteID edgeID portID F
    original live host hdr body factors bank slot counts u
  exact ReturnedCandidateReports.hostOnPrefix N t cell recv size raw site origin state siteID edgeID portID F
    original live host hdr body factors bank slot counts U active actual u matched ((source).cells q u) matched

