  ((tape₁).program.length+(cutWidth (l+1)+extra₁)) (ℓ₁) tiles (GridHosts.inputBlockWidth (r₁) (l+1) axes (d₁)) J₁ description

variable {ord : Fin (l+1) × Bool ≃ Fin (2*(l+1))}
    {common : CommonField paid (φ ∘ cube.table) q l (stretch b.σ (l+1)) ord}
    (chart : AdvisedBranch common) [Fact common.p.Prime] [Algebra (ZMod common.p) chart.E]
    (reader : ChosenReader chart (b.physical.teamsPred (l+1)+1) (stretch b.ρ (l+1))
      (b.physical.multBits (l+1)) (b.physical.tally (l+1)) (b.physical.word (l+1))
      (adv (adviceScale b.σ b.ρ (l+1))+6))
    (chargeFit : reader.charge ≤ c*(adv (adviceScale b.σ b.ρ (l+1))+1)^charge)


local notation3 (prettyPrint := false) "layout₁" => cal.frozenLayout chart reader chargeFit
local notation3 (prettyPrint := false) "initial₁" => reader.startupArenaWith (n:=l+1) (reg:=64)
  (prog₁) (a₁) (ℓ₁) (layout₁).header
local notation3 (prettyPrint := false) "located₁" => cal.locatedGateTable grid qpos position (initial₁)
local notation3 (prettyPrint := false) "task₁" => cal.frozenTask grid qpos position chart reader chargeFit
local notation3 (prettyPrint := false) "table₁" => (located₁).raw.reserve ceiling₁
local notation3 (prettyPrint := false) "issued" => freeDirectory R₁ r₁ (initial₁).literal ℓ₁ tiles
  (GridHosts.inputBlockWidth r₁ (l+1) axes d₁) J₁ description
local notation "cubeEntries" => BorderVNP.Cube.TableEntry cube.pred cube.b cube.h cube.copies cube.width

/-- The physical directory and reserved table used by the issued program select
the frozen output address. Every original candidate row fits the arena, and
each cube table entry has its coordinate in the paid-plus-cube scalar table. -/
theorem SignedCalendarAt.frozenIssuedPlacement :
    (issued) = dir₁ ∧ (table₁).size = ceiling₁ ∧
    Allocation.dest ((initial₁).next+7*(issued).candidates) cap₁ (table₁).size (located₁).outputs w₁ =
      Allocation.dest ((initial₁).next+7*(dir₁).candidates) cap₁ ceiling₁ (located₁).outputs w₁ ∧
    (dir₁).candidates ≤ (task₁).cube.maxRows ∧
    ∀ v : cubeEntries, (task₁).id v=(Fintype.equivFin (paid.Entry ⊕ cubeEntries) (Sum.inr v)).val := by
  have same := (cal.frozenSourceRoom grid qpos position chart reader chargeFit).1
  have size := (located₁).raw.reserve_size ceiling₁ (located₁).raw_bound
  refine ⟨same,size,?_,?_,fun _ => rfl⟩
  · rw [same,size]
  · exact Nat.le_add_right (dir₁).candidates _

/-- The native report dimensions and the initial physical header use the
numbered parse table, the complete signed scalar set, and the current word. -/
theorem SignedCalendarAt.frozenIssuedReportFields :
    let task := task₁
    let par := pairedTableParameters (l+1) size₁
    let gadgets := Fintype.card (paid.Entry ⊕ cubeEntries)
    task.p.parameters=par ∧ task.p.report.gadgets=gadgets ∧ task.dim=par+gadgets ∧
      task.p.report.countWidth=w₁ ∧ (initial₁).header=JointHeader.PositiveFields.width cap₁ task.cube.n
        task.cube.header.d task.cube.header.cap task.cube.teams task.dim w₁ :=
  ⟨rfl,rfl,rfl,rfl,(cal.frozenLayout_fields chart reader chargeFit).1⟩

