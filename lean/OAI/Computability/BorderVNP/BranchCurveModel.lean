import OAI.Computability.BorderVNP.BranchCurveSeparable
import OAI.Computability.BorderVNP.BranchCurveDVR

/-!
# Function field and place of a branch of the deformation

The branch records the nonsingular point on the generic fiber and a common
discrete place for every coordinate of the prescribed output.
-/

namespace OAI
namespace Computability
namespace BorderVNP

universe u

namespace Branch

open MvPolynomial

variable {K : Type u} [Field K] {I : Type*} {h : ℕ}

/-- A finite separable branch with its generic parameters and its discrete
valuation above the prescribed special-fiber point. -/
structure GeometricBranch (Y : I → MvPolynomial (Fin h) K) (c : I → K)
    (g : Fin h → MvPolynomial (Fin h) (FractionRing (Polynomial K))) where
  /-- Function field of the component through the retained point. -/
  L : Type u
  [fieldL : Field L]
  [algebraK : Algebra K L]
  [algebraT : Algebra (FractionRing (Polynomial K)) L]
  [tower : IsScalarTower K (FractionRing (Polynomial K)) L]
  /-- Values of the affine parameters at the generic point. -/
  x : Fin h → L
  /-- The field is generated by these parameters and the base parameter. -/
  generates : IntermediateField.adjoin (FractionRing (Polynomial K)) (Set.range x) = ⊤
  /-- The component dominates the line with finite function field degree. -/
  finiteDegree : FiniteDimensional (FractionRing (Polynomial K)) L
  /-- Separability of this function field extension. -/
  separable : Algebra.IsSeparable (FractionRing (Polynomial K)) L
  /-- The deformed affine equations at the generic point. -/
  root : ∀ i, aeval x (g i) = 0
  /-- The Jacobian is invertible at that point. -/
  jacobian : (Matrix.of fun i j => aeval x (pderiv j (g i))).det ≠ 0
  /-- Place above the retained point of the special fiber. -/
  place : ValuationSubring L
  /-- The place is discrete. -/
  discrete : IsDiscreteValuationRing place
  /-- The parameter polynomials are regular at the place. -/
  regular : ∀ p : Polynomial K, algebraMap (FractionRing (Polynomial K)) L
    (algebraMap _ _ p) ∈ place
  /-- The distinguished parameter vanishes at the place. -/
  parameter_zero : algebraMap (FractionRing (Polynomial K)) L
    (algebraMap (Polynomial K) _ Polynomial.X) ∈ place.nonunits
  /-- Every prescribed output is regular and has the retained value. -/
  outputs : ∀ i, aeval x (Y i) ∈ place ∧ aeval x (Y i) - algebraMap K L (c i) ∈ place.nonunits

attribute [instance] GeometricBranch.fieldL GeometricBranch.algebraK GeometricBranch.algebraT
  GeometricBranch.tower

end Branch

end BorderVNP
end Computability
end OAI
