/-- At the control address used by the planner's report lookup, each published
original pointer selects its sewn destination in the planner's cell bank. -/
theorem SignedCalendarAt.frozenPlannerPublishedSourceSlots
    (values : (seedBundle tape₁ axes d₁ order₁ position copies₁).Tables F)
    (history : (packHistory (seed₁ values) (plan₁).compiled.machine.epoch T₁).Index)
    {ram : ℕ → ℕ}
    (marked : cal.frozenIssuedMarkers grid qpos position chart reader chargeFit values history ram) :
    let dir := cal.frozenIssuedDirectory grid qpos position chart reader chargeFit values history
    let N := netAt[values,history]
    let cell := cellsAt[values,history]
    let host := hostsAt[values,history]
    let live := (Equiv.refl (FreeBlock (R₁) tiles)).toEmbedding
    let eid := FieldExport.mergedEdges (fieldSewParams (wired₁) axes d₁) valid₁ (stageAt[values,history]).rows.edge
    let pid := (finProdFinEquiv : FreeBlock (R₁) tiles ≃ Fin ((R₁+1)*tiles)).toEmbedding
    let ptr := fun i : Fin J₁ => (Sum.inl (Sum.inr i) : (tpl₁).Fields)
    ∃ args : (tpl₁).Fields → ℕ,
      Published dir (tpl₁).publicDepth (tpl₁).chunkDepth (ctl+37) (header*logWidth r₁ (l+1)) ptr args ram ∧
      ∀ i, args (ptr i)=(planner).cube.cellBank+(cell (host i)).val*(planner).cube.cellStride+
        (NativeDemands.destination N cell eid pid dir₁ host live (planner).p.privateGap (.inl i)).2 := by
  have same : task₁=planner := (cal.frozenEarlyTask grid qpos position chart reader chargeFit).symm.trans
    (cal.frozenPlannerTask_eq grid qpos position chart reader chargeFit)
  rw [cal.frozenPlannerReportControl grid qpos position chart reader chargeFit, ←same]
  exact cal.frozenIssuedPublishedSourceSlots grid qpos position chart reader chargeFit values history marked

