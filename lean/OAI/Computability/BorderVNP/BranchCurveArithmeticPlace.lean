import OAI.Computability.BorderVNP.BranchCurveDVR
import OAI.Computability.BorderVNP.BranchCurveSeparable
import Mathlib.RingTheory.Jacobson.Ring
import Mathlib.RingTheory.LocalRing.ResidueField.Ideal

/-!
# Restriction of the geometric place to the finite coefficient field

The function field generated by the coordinates over the rational parameter
field of the advice is finite separable by the same Jacobian. The restricted
valuation remains centered above zero, is discrete, and has finite residue
field. These are the field hypotheses for the Laurent expansion in §10.1.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace Branch

/-- The residue field of a centered place of a finite separable function field
over a finite constant field is finite. -/
theorem finite_residue_over_parameter {K L : Type*} [Field K] [Finite K] [Field L]
    [Algebra (Polynomial K) L] [Algebra (FractionRing (Polynomial K)) L]
    [IsScalarTower (Polynomial K) (FractionRing (Polynomial K)) L]
    [FiniteDimensional (FractionRing (Polynomial K)) L]
    [Algebra.IsSeparable (FractionRing (Polynomial K)) L]
    (V : ValuationSubring L) (hregular : ∀ a : Polynomial K, algebraMap _ L a ∈ V)
    (hzero : algebraMap (Polynomial K) L Polynomial.X ∈ V.nonunits) :
    Finite (IsLocalRing.ResidueField V) := by
  let B := lineNormalization K L
  obtain ⟨P, hP, hne, heq⟩ := exists_normalized_center V hregular hzero
  have : IsDedekindDomain B := inferInstanceAs (IsDedekindDomain (integralClosure (Polynomial K) L))
  have : P.IsMaximal := hP.isMaximal hne
  let : Field (B ⧸ P) := Ideal.Quotient.field P
  let : Algebra (Polynomial K) B := inferInstanceAs (Algebra (Polynomial K)
    (integralClosure (Polynomial K) L))
  let j : Polynomial K →+* B := algebraMap _ (integralClosure (Polynomial K) L)
  have hj : j.Finite := by
    have : IsNoetherian (Polynomial K) (integralClosure (Polynomial K) L) :=
      IsIntegralClosure.isNoetherian (Polynomial K) (FractionRing (Polynomial K)) L _
    exact RingHom.finite_algebraMap.mpr (inferInstanceAs (Module.Finite (Polynomial K)
      (integralClosure (Polynomial K) L)))
  let f := (Ideal.Quotient.mk P).comp (j.comp Polynomial.C)
  have hf : f.FiniteType := (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective).comp
    (hj.finiteType.comp (RingHom.finiteType_algebraMap.mpr (inferInstanceAs
      (Algebra.FiniteType K (Polynomial K)))))
  let : Algebra K (B ⧸ P) := f.toAlgebra
  have : Module.Finite K (B ⧸ P) := RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr hf
  have : Finite (B ⧸ P) := Module.finite_of_finite K
  let e : Localization.AtPrime P ≃+* V := (LocalSubring.ofPrimeEquiv B P).toRingEquiv.trans
    (RingEquiv.subringCongr heq)
  let r := IsLocalRing.ResidueField.mapEquiv e
  have : Finite (IsLocalRing.ResidueField (Localization.AtPrime P)) := inferInstanceAs (Finite P.ResidueField)
  exact Finite.of_surjective r r.surjective

/-- Restricting the geometric place along a field embedding preserves vanishing
in the residue field as well as regularity. -/
theorem vanishes_at_comap {L Ω : Type*} [Field L] [Field Ω] (V : ValuationSubring Ω)
    (f : L →+* Ω) (z : L) : z ∈ (V.comap f).nonunits ↔ f z ∈ V.nonunits := by
  rw [(V.comap f).mem_nonunits_iff_or, V.mem_nonunits_iff_or, map_eq_zero,
    ValuationSubring.mem_comap, map_inv₀]

/-- On the arithmetic function field generated by the root coordinates the
restricted geometric place supplies precisely a discrete ring with finite
residue field and the same output residues. -/
theorem arithmetic_place_of_nonsingular_root {E L Ω ι : Type*} [Field E] [Finite E]
    [Field L] [Field Ω] [Algebra (Polynomial E) L] [Algebra (FractionRing (Polynomial E)) L]
    [IsScalarTower (Polynomial E) (FractionRing (Polynomial E)) L] [Fintype ι] [DecidableEq ι]
    (g : ι → MvPolynomial ι (FractionRing (Polynomial E))) (x : ι → L)
    (hgen : IntermediateField.adjoin (FractionRing (Polynomial E)) (Set.range x) = ⊤)
    (hroot : ∀ i, MvPolynomial.aeval x (g i) = 0)
    (hjac : (Matrix.of fun i j => MvPolynomial.aeval x (MvPolynomial.pderiv j (g i))).det ≠ 0)
    (V : ValuationSubring Ω) (f : L →+* Ω)
    (hreg : ∀ a : Polynomial E, f (algebraMap _ L a) ∈ V)
    (h0 : f (algebraMap (Polynomial E) L Polynomial.X) ∈ V.nonunits) :
    IsDiscreteValuationRing (V.comap f) ∧ Finite (IsLocalRing.ResidueField (V.comap f)) := by
  obtain ⟨_, _⟩ := finite_separable_of_nonsingular_system g x hgen hroot hjac
  have ht := (vanishes_at_comap V f _).mpr h0
  exact ⟨discrete_place_over_parameter (V.comap f) hreg ht,
    finite_residue_over_parameter (V.comap f) hreg ht⟩

end Branch

