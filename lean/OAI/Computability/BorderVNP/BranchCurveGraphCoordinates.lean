import OAI.Computability.BorderVNP.BranchCurveGraphDimension
import Mathlib.Tactic.Ring

/-!
# Recovering finite parameters from a point on the graph chart

The zeroth homogeneous chart ratio is nonzero on the finite-parameter
locus. Dividing the other ratios by it recovers parameters whose polynomial
outputs are the chart outputs. The identities hold under arbitrary field
specialization, including the generic point of a component of (9.1).
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace Branch

open MvPolynomial

variable {σ ι K L : Type*} [Field K] [Field L] [Algebra K L]
variable (Y : ι → MvPolynomial σ K) (k : Option σ)

/-- The chart coordinate algebra inside the generic parameter field. -/
noncomputable abbrev ChartRing : Subalgebra K (ParameterField σ K) := (graphChartAlgHom Y k).range

/-- The `j`th homogeneous ratio viewed as an element of the coordinate algebra. -/
noncomputable def chartRatio (j : Option σ) : ChartRing Y k :=
  (graphChartAlgHom Y k).rangeRestrict (X (.inl j))

/-- One output coefficient viewed as an element of the coordinate algebra. -/
noncomputable def chartOutput (i : ι) : ChartRing Y k :=
  (graphChartAlgHom Y k).rangeRestrict (X (.inr i))

private theorem ratio_val (j : Option σ) :
    (chartRatio Y k j).val = homogeneousParameters σ K j / homogeneousParameters σ K k :=
  aeval_X _ _

private theorem output_val (i : ι) :
    (chartOutput Y k i).val = algebraMap _ (ParameterField σ K) (Y i) := by
  calc
    (chartOutput Y k i).val = genericTable Y (X i) := aeval_X _ _
    _ = _ := congrArg (algebraMap _ _) (eval₂Hom_X' C Y i)

/-- The affine parameters on the chart overlap, with values in any extension field. -/
noncomputable def chartParameters (φ : ChartRing Y k →ₐ[K] L) (i : σ) : L :=
  φ (chartRatio Y k (some i)) / φ (chartRatio Y k none)

private theorem clear_chart_denominator (φ : ChartRing Y k →ₐ[K] L)
    (hd : φ (chartRatio Y k none) ≠ 0) (p : MvPolynomial σ K) :
    ∃ (n : ℕ) (r : ChartRing Y k),
      r.val = algebraMap _ _ p * (chartRatio Y k none).val ^ n ∧
      φ r = aeval (chartParameters Y k φ) p * φ (chartRatio Y k none) ^ n := by
  let d := chartRatio Y k none
  induction p using MvPolynomial.induction_on with
  | C a =>
    refine ⟨0, algebraMap K (ChartRing Y k) a, ?_, ?_⟩
    · simp only [pow_zero, mul_one]
      rfl
    · rw [aeval_C, AlgHom.commutes, pow_zero, mul_one]
  | add p q hp hq =>
    obtain ⟨n, r, hr, er⟩ := hp
    obtain ⟨m, s, hs, es⟩ := hq
    refine ⟨n+m, r * d^m + s * d^n, ?_, ?_⟩
    · simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_pow, hr, hs, map_add,
        pow_add, d]
      ring
    · simp only [map_add, map_mul, map_pow, er, es, pow_add, d]
      ring
  | mul_X p i hp =>
    obtain ⟨n, r, hr, er⟩ := hp
    refine ⟨n+1, r * chartRatio Y k (some i), ?_, ?_⟩
    · simp only [Subalgebra.coe_mul, hr, ratio_val, homogeneousParameters, Option.elim, map_mul,
        pow_succ, div_eq_mul_inv]
      ring
    · simp only [map_mul, er, aeval_X, chartParameters, pow_succ, div_eq_mul_inv]
      rw [show φ (chartRatio Y k none) ^ n * φ (chartRatio Y k none) =
        φ (chartRatio Y k none) * φ (chartRatio Y k none) ^ n by ring]
      field_simp

/-- Specialization on the finite-parameter chart preserves every output
coefficient of the original polynomial table. -/
theorem chartOutput_specializes (φ : ChartRing Y k →ₐ[K] L)
    (hd : φ (chartRatio Y k none) ≠ 0) (i : ι) :
    φ (chartOutput Y k i) = aeval (chartParameters Y k φ) (Y i) := by
  obtain ⟨n, r, hr, er⟩ := clear_chart_denominator Y k φ hd (Y i)
  have h : r = chartOutput Y k i * chartRatio Y k none ^ n := by
    apply Subtype.ext
    rw [hr, Subalgebra.coe_mul, Subalgebra.coe_pow, output_val]
  rw [h, map_mul, map_pow] at er
  exact mul_right_cancel₀ (pow_ne_zero _ hd) er

/-- Every specialized chart coordinate is in the field generated by the
recovered affine parameters. -/
theorem chart_image_in_field (hk : homogeneousParameters σ K k ≠ 0)
    (φ : ChartRing Y k →ₐ[K] L) (hd : φ (chartRatio Y k none) ≠ 0)
    (T : IntermediateField K L) (hx : ∀ i, chartParameters Y k φ i ∈ T) :
    ∀ r : ChartRing Y k, φ r ∈ T := by
  have key : chartRatio Y k k = 1 := Subtype.ext ((ratio_val Y k k).trans (div_self hk))
  have hden : φ (chartRatio Y k none) ∈ T := by
    cases k with
    | none => rw [key, map_one]; exact T.one_mem
    | some l =>
      have h := T.inv_mem (hx l)
      simpa [chartParameters, key] using h
  have ratio (j : Option σ) : φ (chartRatio Y k j) ∈ T := by
    cases j with
    | none => exact hden
    | some i =>
      have h := T.mul_mem (hx i) hden
      simpa [chartParameters, div_mul_cancel₀ _ hd] using h
  have values (p : MvPolynomial σ K) : aeval (chartParameters Y k φ) p ∈ T := by
    induction p using MvPolynomial.induction_on with
    | C a => rw [aeval_C]; exact T.algebraMap_mem a
    | add p q hp hq => rw [map_add]; exact T.add_mem hp hq
    | mul_X p i hp => rw [map_mul, aeval_X]; exact T.mul_mem hp (hx i)
  intro r
  obtain ⟨p, rfl⟩ := (graphChartAlgHom Y k).rangeRestrict_surjective r
  induction p using MvPolynomial.induction_on with
  | C a =>
    change φ ((graphChartAlgHom Y k).rangeRestrict (algebraMap K _ a)) ∈ T
    rw [AlgHom.commutes, AlgHom.commutes]
    exact T.algebraMap_mem a
  | add p q hp hq => rw [map_add, map_add]; exact T.add_mem hp hq
  | mul_X p i hp =>
    rw [map_mul, map_mul]
    apply T.mul_mem hp
    cases i with
    | inl j => exact ratio j
    | inr j =>
      change φ (chartOutput Y k j) ∈ T
      rw [chartOutput_specializes Y k φ hd]
      exact values (Y j)

/-- On a component of the deformed graph, the recovered parameters generate
the whole function field over the parameter field. The quotient map `π`
represents the component and its variable `X` represents the deformation
parameter. -/
theorem chart_generates_component {A E : Type*} [CommRing A] [Field E]
    [Algebra K E] [Algebra K A] [Algebra E L] [IsScalarTower K E L]
    [Algebra A L] [IsFractionRing A L] (hk : homogeneousParameters σ K k ≠ 0)
    (π : Polynomial (ChartRing Y k) →ₐ[K] A) (hπ : Function.Surjective π)
    (φ : ChartRing Y k →ₐ[K] L) (hφ : ∀ r, φ r = algebraMap A L (π (Polynomial.C r)))
    (hd : φ (chartRatio Y k none) ≠ 0)
    (ht : ∃ t : E, algebraMap A L (π Polynomial.X) = algebraMap E L t) :
    IntermediateField.adjoin E (Set.range (chartParameters Y k φ)) = ⊤ := by
  let T := IntermediateField.adjoin E (Set.range (chartParameters Y k φ))
  have hR := chart_image_in_field Y k hk φ hd (T.restrictScalars K)
    (fun i => IntermediateField.subset_adjoin E _ ⟨i, rfl⟩)
  obtain ⟨t, ht⟩ := ht
  have hA (a : A) : algebraMap A L a ∈ T := by
    obtain ⟨p, rfl⟩ := hπ a
    induction p using Polynomial.induction_on' with
    | add p q hp hq => rw [map_add, map_add]; exact T.add_mem hp hq
    | monomial n r =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, map_mul, map_pow, ← hφ, ht]
      exact T.mul_mem (hR r) (pow_mem (T.algebraMap_mem t) n)
  apply top_unique
  intro a _
  obtain ⟨p, q, _, e⟩ := IsFractionRing.div_surjective A a
  exact e ▸ T.div_mem (hA p) (hA q)

end Branch

end BorderVNP
end Computability
end OAI
