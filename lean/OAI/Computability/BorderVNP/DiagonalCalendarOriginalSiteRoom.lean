/-- The marked report of an original verifier has room at its actual work base
on the selected physical history, with the native field, payload and address
ranges. The semantic value of the private work assignment is arbitrary. -/
theorem SignedCalendarAt.frozenSites_placed_siteRoom
    (headerWide : 8 ≤ header)
    (values : (seedBundle (tape₁) axes d₁ (order₁) position copies₁).Tables F)
    (history : (packHistory (seed₁[values]) (plan₁).compiled.machine.epoch T₁).Index)
    (bank : Fin J₁ → ℕ → Bool) (j : Fin J₁) :
    let N := netAt[values,history]
    let cell := cellsAt[values,history]
    let host := hostsAt[values,history]
    let dir := dir₁
    let live := (Equiv.refl (FreeBlock (R₁) tiles)).toEmbedding
    let eid := FieldExport.mergedEdges (fieldSewParams (wired₁) axes d₁) valid₁ (stageAt[values,history]).rows.edge
    let pid := (finProdFinEquiv : FreeBlock (R₁) tiles ≃ Fin ((R₁+1)*tiles)).toEmbedding
    let sid := (stageAt[values,history]).rows.site
    let states := cal.frozenSitesOriginalPrograms grid qpos position chart reader chargeFit values history
    let aux := fun site : N.Site => (states site).program.size
    let absolute := fun i : Fin J₁ => (task₁).cube.cellBank+(cell (host i)).val*(task₁).cube.cellStride+
      (NativeDemands.destination N cell eid pid dir host live (task₁).p.privateGap (.inl i)).2
    let boxBase := fun i : Fin J₁ => siteBase N cell (cell (host i)) sid aux ⟨host i,rfl⟩
    ((sourceBundle absolute boxBase bank) j).SiteRoom report₁ w₁ description := by
  intro N cell host dir live eid pid sid states aux absolute boxBase
  have fit := cal.frozenSites_original_addressFit grid qpos position chart reader chargeFit values history
  have copiesPos : 0<copies₁ := by
    by_contra! bad
    have count := grid.count
    rw [Nat.eq_zero_of_le_zero bad,Nat.mul_zero] at count
    exact Nat.succ_ne_zero _ count.symm
  have widths := cal.frozenSites_report_shape grid qpos position chart reader chargeFit
  exact SeedPlan.frozenSigned_reportSiteRoom (prog₁) (geo₁).fits cal.frozenWitness position tag nameSite nameEdge
    namePort values (plan₁).compiled geoInput (seed₁[values]).property roundNames free₁ grid.count Sum.inl fullIDs
    valid₁ history cell fit copiesPos cal.length.replication headerWide grid.literalRanges.2.1
    (ParseTable.signedLiteralCode_bound ord) j (absolute j) (bank j) report₁ widths.1 widths.2

