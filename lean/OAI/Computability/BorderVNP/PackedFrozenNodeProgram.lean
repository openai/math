import OAI.Computability.BorderVNP.PackedFrozenTapeRound
import OAI.Computability.BorderVNP.PackedFrozenBirthSection
import OAI.Computability.BorderVNP.PackedFrozenLayerSaved
import OAI.Computability.BorderVNP.PackedFrozenLayerTape
import OAI.Computability.BorderVNP.PackedFrozenHookSection

/-! # Shared-input record emitter of one selected shortening node

The predecessor array, clipped band fields, current count array and next cable
directory all occur as fixed wire names. The new layer, seed checks and hook
suffix are generated by their actual gate lists on that same assignment.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace Packing.Inherited.FrozenTape.Node

open CellSparse Crossing Shortening Shortening.SeedIntervals Shortening.StaticRows Shortening.CombiningStep
open DirectoryCircuit InheritedBank CellAddressCircuit ParseBatchSort VPVNP.VerifierNetwork
open scoped Classical

variable {D m n s old np C C' d d' k k' w binBits : ℕ} [NeZero D] {K : Type*} [Field K]
variable (e : PaidIdentity K D m) (first : Fin D × Bool) (hm : 0 < m)
variable {A : Type} [Fintype A] (seed : A ↪ Fin n)
variable {σ R B : Type*} [Fintype σ] [Fintype R] [Fintype B] (S : Schema R B)
variable (carried : Frame σ (Pins R B d'))
variable (oldF : Fields s old np C d k w σ)
variable (newF : Fields (siteCapacity e s n) (edgeCapacity e old n) np C' d' k' w σ)
variable (cut : Frame σ ((Fin old × Band D) × CutCircuit.Result × Fin w))
variable (counts : Frame σ (A × Option (Fin e.count) × Fin w))
variable (work extent : Fin s → Fin w → σ) (occupied : Fin old → σ) (ports : Fin np → Bool)
variable (successor : Fin (edgeCapacity e old n) → σ)

private noncomputable def layer := (LayerRows.exists_successor_layer.{_,_,0} e oldF newF cut work extent occupied ports successor).choose
private noncomputable def birth := (Birth.exists_mainSection e first seed newF counts hm).choose
private noncomputable def hook := HookTape.asTape (InheritedHook.native e seed newF counts cut successor)

local notation3 "lf" => layer e oldF newF cut work extent occupied ports successor
local notation3 "bf" => birth e first hm seed newF counts
local notation3 "hf" => hook e seed newF cut counts successor

/-- The actual four-way chronological node frame, with the selected three physical
writers fixed before any represented input network or histogram is specified. -/
noncomputable def frame := nodeFrame carried lf bf hf

/-- The carried and the three newly emitted public row rectangles. -/
noncomputable def schema (old np w : ℕ) := nodeSchema S (LayerRows.schema old D np w) (Birth.schema e first A w)
  (HookTape.schema old D w)

/-- Complete size bound of the uniform node emitter, charging every actual gate list. -/
theorem frame_size : (frame e first hm seed carried oldF newF cut counts work extent occupied ports successor).size ≤
    carried.size +
      ((LayerRows.budget e oldF newF cut work extent + lookupCost s (Fintype.card (Layer.Row old D np)) d d') +
      ((Fintype.card (Birth.Row e first A)*(1+d') + (counts.size+(Views.frame newF).size+6+
          Fintype.card A*((InheritedProfile.adjustNodes e + BankCircuit.headerNodes D e.count m + PaidBox.nodeBound e +
            BankJoint.nodes e first)*(100*(w+1)^2)))) +
        (counts.size+PackedDeckScore.queryCost (PackedDeckScore.batchBits (A × (Fin D × Bool)) (InheritedHook.Row old D)) d' w+
         cut.size+(Views.frame newF).size+1+Fintype.card (InheritedHook.Row old D)*(InheritedHook.nodes e*(100*(w+1)^2))))) := by
  simp only [frame,nodeFrame_size]
  have hl := (LayerRows.exists_successor_layer.{_,_,0} e oldF newF cut work extent occupied ports successor).choose_spec.1
  have hb := (Birth.exists_mainSection e first seed newF counts hm).choose_spec.1
  have hh := InheritedHook.native_size e seed newF counts cut successor
  rw [show (hf).size = (InheritedHook.native e seed newF counts cut successor).size from rfl]
  exact Nat.add_le_add_left (Nat.add_le_add hl (Nat.add_le_add hb hh)) _

variable (pop : PublicPopulation.Pins (Fin old) σ binBits w) (code : A ↪ Fin (2^binBits))
variable (perm : Fin D → Equiv.Perm A) (cuts : InheritedHook.ComputesCuts (m := m) pop code perm cut)
variable {P : Type} [Fintype P] {bits : P → ℕ} (p : Pack D P bits K) (slot : p.layout.Edge ↪ Fin old)
variable (bin : p.layout.Edge → Option A) (positive : p.layout.Edge → Bool)
variable (q : Counts e (densePack p slot) (CutCircuit.denseBin p.layout slot bin) perm)
variable (siteID : p.layout.Site ↪ Fin s) (portID : P ↪ Fin np) (states : p.layout.Site → Site)
variable (prior payload : p.layout.Site → ℕ) (position : e.Entry → ℕ)

private noncomputable abbrev packed := densePack p slot
private noncomputable abbrev labels := CutCircuit.denseBin p.layout slot bin
private noncomputable abbrev orient := positive ∘ (Names.denseSlot p.layout slot).symm
private noncomputable abbrev G := (output e (packed p slot) (labels p slot bin) perm (orient p slot positive) first q).layout
variable (cell : (G e first perm p slot bin positive q).Site → Fin C') (aux : (G e first perm p slot bin positive q).Site → ℕ)
local notation3 "p₀" => packed p slot
local notation3 "bin₀" => labels p slot bin
local notation3 "or₀" => orient p slot positive
local notation3 "oldID" => CutCircuit.denseRows p.layout slot
local notation3 "sID" => siteRows e p₀ siteID seed
local notation3 "eID" => outputRows e p₀ bin₀ perm or₀ first q oldID seed
local notation3 "name₀" => (fun a => (code a).val)
local notation3 "key" => (sID).trans (newF.sites.trans Fin.valEmbedding)
local notation3 "pieces" name => (fun v => Layer.orderedCuts p₀ oldID portID v e bin₀ perm name or₀ first q eID)

include cuts in
set_option maxHeartbeats 2400000 in
set_option backward.isDefEq.respectTransparency false in
/-- The exact ordered tape installed by this frame at every physical site of the selected
successor. The three fresh sections follow from true geometry, old populations, accepted
counts and measured cell loads. -/
theorem image (x : σ → Bool) (M U : ℕ)
    (h : HookTape.SourceData pop code perm e seed newF counts successor p slot bin positive first q siteID portID cell aux
      x prior payload M U)
    (hc : S.Section (carried.eval x) key (carriedRows e p₀ states))
    (previous : Views.EndpointData p.layout oldF siteID slot portID x)
    (hw : ∀ v, value (x ∘ work (siteID v)) = (states v).work)
    (he : ∀ v, value (x ∘ extent (siteID v)) = (states v).size)
    (hin : ∀ v, (states v).incoming = incoming p.layout v)
    (payloads : ∀ v, (states v).work ≤ payload v)
    (tileCap : ∀ t, localRecords (G e first perm p slot bin positive q) true
      (nextPrior e p₀ bin₀ perm or₀ first q prior) (nextPayload e p₀ bin₀ perm or₀ first q payload)
      (fun v => cell v = t) < 2^w)
    (used : ∀ i,x (occupied i) = true ↔ i ∈ Set.range oldID) (hp : ∀ i,ports i = true ↔ i ∈ Set.range portID)
    (name : A → ℕ := name₀) :
    (schema e first (A := A) S old np w).Image
      ((frame e first hm seed carried oldF newF cut counts work extent occupied ports successor).eval x) key
      (roundSites e p₀ bin₀ perm or₀ first q name position sID eID portID states (pieces name)) := by
  have hU : U < 2^w := (Nat.le_add_left _ _).trans_lt h.room
  have hr := LayerRows.saved_inputs e oldF newF cut work extent successor p slot bin perm positive first q siteID portID
    seed states prior payload pop code cuts name x h.population (fun a => (h.bins a).trans_lt hU) h.widths previous
    (Views.EndpointData.of_rep _ _ _ _ _ h.geometry) hw he h.enabled hin payloads cell tileCap
  have hl := (LayerRows.exists_successor_layer.{_,_,0} e oldF newF cut work extent occupied ports successor).choose_spec.2
    p₀ bin₀ perm name or₀ first q siteID oldID portID seed states prior payload x hr used hp
  have layerOk := LayerRows.successor_section e newF p₀ siteID seed ((lf).eval x)
    (fun v => ((pieces name) v).map (Slice.record (states v))) (by simpa only [layer,List.map_map,Function.comp_def] using hl)
  have birthOk := (Birth.exists_mainSection e first seed newF counts hm).choose_spec.2
    p₀ bin₀ perm or₀ q siteID oldID portID cell aux x h.geometry h.histogram prior payload M h.capacity
    (HookTape.sourceRoom_fits e first M U h.room).1
  have hookOk := HookTape.successor_section pop code perm cut e seed newF counts successor p slot bin positive first q
    siteID portID cell aux cuts x prior payload M U h
  have records : HookTape.records code perm e seed p slot bin positive first q siteID portID =
      terminalRows e p₀ bin₀ perm or₀ first q name sID eID portID := by
    funext v
    change SiteShape e p₀ A at v
    rcases v with v | ⟨a,(_ | t | ⟨i,v⟩)⟩ <;> rfl
  rw [records] at hookOk
  exact node_image_key e p₀ bin₀ perm or₀ first q name position sID eID portID states (pieces name) S
    (LayerRows.schema old D np w) (Birth.schema e first A w) (HookTape.schema old D w)
    carried lf bf hf key x hc layerOk birthOk hookOk

end Packing.Inherited.FrozenTape.Node

end BorderVNP
end Computability
end OAI
