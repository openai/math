import OAI.Computability.BorderVNP.BranchCurveArithmeticPlace

/-!
# The arithmetic field of the branch

Section 10 takes the field generated by the parameter coordinates over the
finite advice field and the transcendental deformation parameter. A generically
nonsingular system over that advice field makes the smaller field finite
separable. Restricting the geometric valuation realizes the same coefficient
values there, with discrete value group and finite residue field.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace Branch

open MvPolynomial

/-- The coordinates and their equations descend to their generated intermediate
field, keeping the full Jacobian determinant. -/
theorem root_on_generated_field {F Ω σ : Type*} [Field F] [Field Ω] [Algebra F Ω]
    [Fintype σ] [DecidableEq σ] (g : σ → MvPolynomial σ F) (x : σ → Ω)
    (hz : ∀ i, aeval x (g i) = 0)
    (hJ : (Matrix.of fun i j => aeval x (pderiv j (g i))).det ≠ 0) :
    let S := IntermediateField.adjoin F (Set.range x)
    ∃ xs : σ → S, S.val ∘ xs = x ∧ IntermediateField.adjoin F (Set.range xs) = ⊤ ∧
      (∀ i, aeval xs (g i) = 0) ∧
      (Matrix.of fun i j => aeval xs (pderiv j (g i))).det ≠ 0 := by
  let S := IntermediateField.adjoin F (Set.range x)
  let xs : σ → S := fun i => ⟨x i, IntermediateField.subset_adjoin F _ ⟨i, rfl⟩⟩
  have ev (p : MvPolynomial σ F) : S.val (aeval xs p) = aeval x p := comp_aeval_apply _ _ _
  refine ⟨xs, rfl, ?_, fun i => S.val.injective ((ev (g i)).trans ((hz i).trans (map_zero S.val).symm)), ?_⟩
  · apply IntermediateField.map_injective S.val
    rw [IntermediateField.adjoin_map, ← Set.range_comp, ← AlgHom.fieldRange_eq_map,
      IntermediateField.fieldRange_val]
    rfl
  · intro h
    apply hJ
    let J := Matrix.of fun i j => aeval xs (pderiv j (g i))
    have he : J.map S.val = Matrix.of fun i j => aeval x (pderiv j (g i)) := by
      ext i j
      exact ev _
    rw [← he]
    exact (S.val.map_det J).symm.trans ((congrArg S.val h).trans (map_zero S.val))

/-- The actual restricted arithmetic valuation in §10.1. The `E(t)`-coordinates
are generated by `x`; each polynomial table output over the advice field
retains its prescribed regular residue. -/
theorem restricted_branch_over_finite_field {E Ω σ ι : Type*} [Field E] [Finite E] [Field Ω]
    [Algebra (FractionRing (Polynomial E)) Ω] [Fintype σ] [DecidableEq σ]
    (g : σ → MvPolynomial σ (FractionRing (Polynomial E))) (x : σ → Ω)
    (hroot : ∀ i, aeval x (g i) = 0)
    (hjac : (Matrix.of fun i j => aeval x (pderiv j (g i))).det ≠ 0)
    (V : ValuationSubring Ω)
    (hreg : ∀ a : Polynomial E, algebraMap (FractionRing (Polynomial E)) Ω
      (algebraMap _ _ a) ∈ V)
    (h0 : algebraMap (FractionRing (Polynomial E)) Ω
      (algebraMap (Polynomial E) _ Polynomial.X) ∈ V.nonunits)
    (Y : ι → MvPolynomial σ (FractionRing (Polynomial E))) (c : ι → FractionRing (Polynomial E))
    (hc : ∀ i, aeval x (Y i) ∈ V ∧ aeval x (Y i) - algebraMap _ Ω (c i) ∈ V.nonunits) :
    let F := FractionRing (Polynomial E)
    let S := IntermediateField.adjoin F (Set.range x)
    let W := V.comap S.val.toRingHom
    ∃ xs : σ → S, S.val ∘ xs = x ∧ IntermediateField.adjoin F (Set.range xs) = ⊤ ∧
      FiniteDimensional F S ∧ Algebra.IsSeparable F S ∧ IsDiscreteValuationRing W ∧
      Finite (IsLocalRing.ResidueField W) ∧ ∀ i, aeval xs (Y i) ∈ W ∧
        aeval xs (Y i) - algebraMap F S (c i) ∈ W.nonunits := by
  let F := FractionRing (Polynomial E)
  let S := IntermediateField.adjoin F (Set.range x)
  let W := V.comap S.val.toRingHom
  let : Algebra (Polynomial E) S :=
    ((algebraMap F S).comp (algebraMap (Polynomial E) F)).toAlgebra
  have : IsScalarTower (Polynomial E) F S := .of_algebraMap_eq fun _ => rfl
  obtain ⟨xs, hxs, hgen, hrootS, hJS⟩ := root_on_generated_field g x hroot hjac
  obtain ⟨hfin, hsep⟩ := finite_separable_of_nonsingular_system g xs hgen hrootS hJS
  obtain ⟨hdvr, hκ⟩ := arithmetic_place_of_nonsingular_root g xs hgen hrootS hJS
    V S.val.toRingHom hreg h0
  refine ⟨xs, hxs, hgen, hfin, hsep, hdvr, hκ, fun i => ?_⟩
  have ev : S.val (aeval xs (Y i)) = aeval x (Y i) := by
    rw [comp_aeval_apply]
    exact congrArg (fun w => aeval w (Y i)) hxs
  constructor
  · exact ValuationSubring.mem_comap.mpr (ev ▸ (hc i).1)
  · apply (vanishes_at_comap V S.val.toRingHom _).mpr
    change S.val (aeval xs (Y i) - algebraMap F S (c i)) ∈ V.nonunits
    rw [map_sub, ev, AlgHom.commutes]
    exact (hc i).2

end Branch

end BorderVNP
end Computability
end OAI
