import OAI.Computability.BorderVNP.CoverHeckeRotation
import Mathlib.Analysis.SpecificLimits.Normed
import Mathlib.LinearAlgebra.Matrix.ProjectiveSpecialLinearGroup
import Mathlib.Topology.Algebra.Group.Quotient

/-!
# Density of the group generated by the quaternion lattice and the elliptic motion

Conjugating small rotations by growing powers of the diagonal lattice element
gives all upper shears as limits. A quarter-turn gives the lower shears, and
elementary elimination then generates the entire real special linear group.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace Cover.Frame

open Matrix Set Filter Real
open scoped Matrix Topology

/-- A determinant-one diagonal matrix. -/
noncomputable def dilation (a : ℝ) (ha : a ≠ 0) : SL :=
  ⟨!![a,0;0,a⁻¹], by simp [det_fin_two, ha]⟩

/-- The upper shear with off-diagonal coefficient `a`. -/
noncomputable def upper (a : ℝ) : SL := ⟨!![1,a;0,1], by simp [det_fin_two]⟩

/-- The lower shear with off-diagonal coefficient `a`. -/
noncomputable def lower (a : ℝ) : SL := ⟨!![1,0;a,1], by simp [det_fin_two]⟩

private theorem dilation_mul (a b : ℝ) (ha : a ≠ 0) (hb : b ≠ 0) :
    dilation (a*b) (mul_ne_zero ha hb) = dilation a ha * dilation b hb := by
  apply Subtype.ext
  change (dilation (a*b) _ : Mat) = (dilation a ha : Mat) * (dilation b hb : Mat)
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [dilation, Matrix.mul_apply, Fin.sum_univ_two, mul_comm]

private theorem dilation_pow (a : ℝ) (ha : a ≠ 0) (n : ℕ) :
    (dilation a ha)^n = dilation (a^n) (pow_ne_zero n ha) := by
  induction n with
  | zero =>
    rw [pow_zero]
    apply Subtype.ext
    ext i j; fin_cases i <;> fin_cases j <;> simp [dilation]
  | succ n ih =>
    rw [pow_succ,ih,← dilation_mul]
    congr 1

private theorem dilation_inv (a : ℝ) (ha : a ≠ 0) :
    (dilation a ha)⁻¹ = dilation a⁻¹ (inv_ne_zero ha) := by
  apply inv_eq_of_mul_eq_one_right
  rw [← dilation_mul]
  apply Subtype.ext
  ext i j; fin_cases i <;> fin_cases j <;> simp [dilation,ha]

/-- The expanding diagonal element `(3+2i)^3 = 99+70i` belongs to the base lattice. -/
theorem dilation_mem_gamma : dilation (99+70*√2) (by positivity) ∈ (gammaSL 1).range := by
  let x : Order := ⟨99,70,0,0⟩
  have hx : norm x = 1 := by norm_num [x,norm]
  let u := normUnit x hx
  have hu : u ∈ gamma 1 :=
    ⟨hx, ⟨14,10,0,0⟩, by change (⟨99,70,0,0⟩ : Order) = atDepth 1 ⟨14,10,0,0⟩; ext <;> decide⟩
  refine ⟨⟨u,hu⟩, ?_⟩
  apply Subtype.ext
  change split x = _
  have h : √(2:ℝ)^2 = 2 := sq_sqrt (by norm_num)
  ext i j; fin_cases i <;> fin_cases j <;> simp [split,x,dilation]
  · ring
  · apply eq_inv_of_mul_eq_one_left
    nlinarith

private theorem dilation_rotation (a t : ℝ) (ha : a ≠ 0) :
    ((dilation a ha * rotation t * (dilation a ha)⁻¹ : SL) : Mat) =
      !![cos t, a^2 * √3 * sin t; -(a⁻¹)^2 * sin t / √3, cos t] := by
  rw [dilation_inv]
  change (dilation a ha : Mat) * (rotation t : Mat) * (dilation a⁻¹ _ : Mat) = _
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [dilation, rotation, Matrix.mul_apply, Fin.sum_univ_two] <;>
    field_simp

/-- Conjugates of rotations by powers of any expanding dilation approximate every upper shear. -/
theorem upper_mem_of_dilation {H : Subgroup SL} (hc : IsClosed (H : Set SL))
    (hr : ∀ t, rotation t ∈ H) (a : ℝ) (ha : 1 < a)
    (hA : dilation a (by linarith) ∈ H) (b : ℝ) : upper b ∈ H := by
  have hpos : 0 < a := by linarith
  have hn := hpos.ne'
  let d (n : ℕ) := (a^n)⁻¹
  have hd : Tendsto d atTop (𝓝 0) := by
    simp only [d, ← inv_pow]
    exact tendsto_pow_atTop_nhds_zero_of_lt_one (inv_nonneg.mpr hpos.le) ((inv_lt_one₀ hpos).mpr ha)
  let s (n : ℕ) := b / √3 * (d n)^2
  have hs : Tendsto s atTop (𝓝 0) := by
    simpa [s] using (hd.pow 2).const_mul (b/√3)
  let θ (n : ℕ) := arcsin (s n)
  have ht : Tendsto θ atTop (𝓝 0) := by simpa [θ,Function.comp_def] using continuous_arcsin.continuousAt.tendsto.comp hs
  have hsin : ∀ᶠ n in atTop, sin (θ n) = s n := by
    filter_upwards [hs.eventually (Ioo_mem_nhds (by norm_num : (-1:ℝ)<0) (by norm_num : (0:ℝ)<1))] with n h
    exact sin_arcsin h.1.le h.2.le
  let v (n : ℕ) := (dilation a hn)^n * rotation (θ n) * ((dilation a hn)^n)⁻¹
  have hv (n : ℕ) : v n ∈ H := H.mul_mem (H.mul_mem (H.pow_mem hA n) (hr _)) (H.inv_mem (H.pow_mem hA n))
  refine hc.mem_of_tendsto (b := atTop) (f := v) ?_ (Eventually.of_forall hv)
  apply tendsto_subtype_rng.mpr
  apply tendsto_pi_nhds.mpr; intro i
  apply tendsto_pi_nhds.mpr; intro j
  simp only [v, dilation_pow, dilation_rotation]
  have coslim : Tendsto (fun n => cos (θ n)) atTop (𝓝 1) := by
    simpa [Function.comp_def] using continuous_cos.continuousAt.tendsto.comp ht
  have sinlim : Tendsto (fun n => sin (θ n)) atTop (𝓝 0) := by
    simpa [Function.comp_def] using continuous_sin.continuousAt.tendsto.comp ht
  fin_cases i <;> fin_cases j <;> simp [upper]
  · exact coslim
  · apply (tendsto_const_nhds (x := b)).congr'
    filter_upwards [hsin] with n h
    simp [h,s,d]; field_simp
  · simpa [d] using (((hd.pow 2).neg.mul sinlim).div_const (√3))
  · exact coslim

/-- A quarter-turn converts upper shears into lower ones. -/
theorem lower_mem_of_rotations {H : Subgroup SL} (hr : ∀ t, rotation t ∈ H)
    (hu : ∀ x, upper x ∈ H) (x : ℝ) : lower x ∈ H := by
  have h : √(3:ℝ) ≠ 0 := by positivity
  have he : rotation (π/2) * upper (-3*x) * rotation (-(π/2)) = lower x := by
    apply Subtype.ext
    change (rotation _ : Mat) * (upper _ : Mat) * (rotation _ : Mat) = (lower x : Mat)
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [rotation, upper, lower, Matrix.mul_apply, Fin.sum_univ_two]
    field_simp
    rw [sq_sqrt (by norm_num : (0:ℝ) ≤ 3)]
  rw [← he]; exact H.mul_mem (H.mul_mem (hr _) (hu _)) (hr _)

private theorem mem_of_nonzero_entry (H : Subgroup SL) (hu : ∀ x, upper x ∈ H)
    (hl : ∀ x, lower x ∈ H) (A : SL) (hc : A 1 0 ≠ 0) : A ∈ H := by
  have hdet := A.property
  rw [Matrix.det_fin_two] at hdet
  have he : upper ((A 0 0 - 1) / A 1 0) * lower (A 1 0) * upper ((A 1 1 - 1) / A 1 0) = A := by
    apply Subtype.ext
    change (upper _ : Mat) * (lower _ : Mat) * (upper _ : Mat) = (A : Mat)
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [upper, lower, Matrix.mul_apply, Fin.sum_univ_two] <;> field_simp <;> linarith
  rw [← he]; exact H.mul_mem (H.mul_mem (hu _) (hl _)) (hu _)

/-- The two one-parameter shear families generate every determinant-one real matrix. -/
theorem eq_top_of_shears (H : Subgroup SL) (hu : ∀ x, upper x ∈ H) (hl : ∀ x, lower x ∈ H) :
    H = ⊤ := by
  apply eq_top_iff.mpr; intro A _
  by_cases h : A 1 0 = 0
  · have had := A.property
    rw [Matrix.det_fin_two] at had
    change A 0 0 * A 1 1 - A 0 1 * A 1 0 = 1 at had
    rw [h,mul_zero,sub_zero] at had
    have ha : A 0 0 ≠ 0 := left_ne_zero_of_mul_eq_one had
    have hg : (lower 1 * A) 1 0 ≠ 0 := by
      change ((lower 1 : Mat) * (A : Mat)) 1 0 ≠ 0
      simpa [lower,Matrix.mul_apply,Fin.sum_univ_two,h] using ha
    exact (H.mul_mem_cancel_left (hl 1)).mp (mem_of_nonzero_entry H hu hl _ hg)
  · exact mem_of_nonzero_entry H hu hl A h

/-- The subgroup generated by the base congruence lattice and the paper's elliptic
quaternion is dense in the real frame group. -/
theorem dense_generated : Dense (Subgroup.closure (insert elliptic ((gammaSL 1).range : Set SL)) : Set SL) := by
  let H := Subgroup.closure (insert elliptic ((gammaSL 1).range : Set SL))
  let K := H.topologicalClosure
  have hc : IsClosed (K : Set SL) := H.isClosed_topologicalClosure
  have hz : elliptic ∈ K := H.le_topologicalClosure (Subgroup.subset_closure (mem_insert _ _))
  have ha : dilation (99+70*√2) (by positivity) ∈ K :=
    H.le_topologicalClosure (Subgroup.subset_closure (mem_insert_of_mem _ dilation_mem_gamma))
  have hr := all_rotation_mem hc hz
  have hu := upper_mem_of_dilation hc hr _ (by linarith [sqrt_nonneg (2:ℝ)] : (1:ℝ) < 99+70*√2) ha
  have hk := eq_top_of_shears K hu (lower_mem_of_rotations hr hu)
  change Dense (H : Set SL)
  rw [dense_iff_closure_eq]
  change (K : Set SL) = univ
  rw [hk]; rfl

/-- The quaternion and the congruence lattice generate a dense subgroup of the
actual projective frame group `PSL₂(ℝ)`. -/
theorem dense_projective :
    let proj : SL →* Matrix.ProjectiveSpecialLinearGroup (Fin 2) ℝ :=
      QuotientGroup.mk' (Subgroup.center SL)
    Dense (Subgroup.closure (insert (proj elliptic) (((gammaSL 1).range.map proj) : Set _)) :
      Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) ℝ)) := by
  intro proj
  have hr : Function.Surjective proj := QuotientGroup.mk_surjective
  have hc : Continuous proj := QuotientGroup.continuous_mk
  have hd := hr.denseRange.dense_image hc dense_generated
  change Dense (((Subgroup.closure (insert elliptic ((gammaSL 1).range : Set SL))).map proj) :
    Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) ℝ)) at hd
  rwa [MonoidHom.map_closure, image_insert_eq] at hd

