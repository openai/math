import OAI.Computability.BorderVNP.PackedHistoryNormalizedSubdivision
import OAI.Computability.BorderVNP.PackedHistoryNormalizedReturn
import OAI.Computability.BorderVNP.ShortenEnrichedNamedProgram
import OAI.Computability.BorderVNP.PackedHistoryBoundaryBudget

/-! # Compiling the actual enriched epoch on its routed input rows

The named source program uses the measured node receipts. The subdivision
and final placement circuits operate on the same sparse names and assigned
words. The compilation keeps those names available for tracing every
original host through the physical histories.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace PackedHistoryCircuit.Normalized.EnrichedOuter.Boundary

open Crossing BorderVNP.Epoch BorderVNP.Epoch.Round Cover Shortening Packing Catalog Adaptive PublicCapacity
open Shortening.PreparedBins Shortening.PublicRelative Shortening.PublicSegments
open VPVNP.VerifierNetwork (Frame)
open scoped Classical
attribute [local instance] portFintype

universe u
variable {D m : ℕ} [NeZero D] {K : Type u} [Field K] {e : PaidIdentity K D m} {S : SiteSchedule e}
    {start T t : ℕ} {P : Type} [Fintype P] {bits : P → ℕ} {shape : ℕ → Shape}
    (deep : S.floor+1+S.drop*T ≤ start) (ht : t<T) (budget V E cap : ℕ → ℕ) (w : ℕ)
    (endShape : shape (t+1) = ⟨V S.rounds,E S.rounds⟩)

local notation "high" => S.high (offset S start t)
local notation "stagePins" => S.source.StatePins S.last high V E w
local notation "admitted" => Admissible (Good (S := S) (start := start) (bits := bits) (shape := shape) (w := w) budget)
local notation "named" => Inner S start t V E cap w P bits

set_option maxHeartbeats 650000 in
set_option genInjectivity false in
/-- One physical compilation. Its source program and its installed input and
output directories remain available alongside the Boolean frames. -/
structure Compilation (nodes : ∀ i : Fin S.rounds, S.source.Node S.last high V E w S.fanIn i) where
  /-- The actual measured normalized stages selected by these physical node frames. -/
  program : S.source.NamedRun (P := Port (fan S) P t) (bits := width bits (fan S) t) (Extra := fun _ => Unit)
    S.last high V E w cap (fun _ _ => True) S.positiveFanIn nodes
  /-- The batched true subdivision circuit. -/
  pre : Frame (Fin (fan S) × Pins S start shape w t) (Fin (fan S) × stagePins 0)
  /-- Both the one-hot selected motion and the physical route columns on each terminal input. -/
  terminal : TerminalCircuit S (Cover.AddressCircuit.ProductSlots (Fintype.card (Cube D))
    (S.level (offset S start t) S.rounds+1) ⊕ ↥(S.source.catalog S.rounds))
    (offset S start t) (V S.rounds) (E S.rounds) w
  /-- The compiled terminal site selection with its publicly returned route columns. -/
  post : Frame ((Fin (fan S) × Pins S start shape w t) ⊕ stagePins S.rounds) (Pins S start shape w (t+1))
  post_size : post.size = terminal.size
  /-- The actual input pack, original routes, and installed directory for each child tuple. -/
  input : ∀ c : Fin (fan S) → admitted t, Inputs deep ht budget V E cap w pre c
  /-- All attained terminal histories retain their true sparse directory after the public return. -/
  returned : ∀ c, Returned (F := program.program) deep ht c (input c).flat
    (fun a : named S.rounds => a.val.words) post (fun a => a.val.names) endShape
  selected : ∀ c q τ, terminal.eval (((returned c).run.root q).val.words) (.inl τ) = decide (τ = (returned c).run.selected q)

variable {deep ht budget V E cap w endShape}

open scoped BorderVNP.Epoch.Cube in
set_option maxHeartbeats 800000 in
/-- The enriched outer node generated by this compilation, acting on every
admissible tuple and retaining the complete assigned post-frame output. -/
noncomputable def Compilation.epoch
    {nodes : ∀ i : Fin S.rounds, S.source.Node S.last (S.high (offset S start t)) V E w S.fanIn i}
    (A : Compilation (bits := bits) deep ht budget V E cap w endShape nodes) :
    Epoch deep ht (Good (S := S) (start := start) (bits := bits) (shape := shape) (w := w) budget) stagePins (fun _ => w) where
  Inner := named
  view := fun _ a => a.val.placed
  F := A.program.program
  saveNames := A.program.saveNames
  records i c := (A.program.installed i c).records
  room := A.program.fits
  pins := fun _ a => a.val.words
  pre := A.pre
  step := S.source.namedKernels S.last high V E w nodes
  post := A.post
  checked := A.program.correct
  run c := (A.returned c).run
  initial c i := (A.input c).initialWords i |>.trans (congrArg (fun f : Fin (fan S) → named 0 => (f i).val.words)
    (A.returned c).leaves.symm)
  rows c := (A.returned c).rows
  dummy c := (A.returned c).dummy
  closed c := (A.returned c).closed

open scoped BorderVNP.Epoch.Cube in
set_option maxHeartbeats 800000 in
/-- Scheduling the inner histogram coordinates retains the actual node gate count. -/
theorem Compilation.step_size
    {nodes : ∀ i : Fin S.rounds, S.source.Node S.last (S.high (offset S start t)) V E w S.fanIn i}
    (A : Compilation (bits := bits) deep ht budget V E cap w endShape nodes) (i : Fin S.rounds) : (A.epoch.step i.val i.isLt).size = (nodes i).size :=
  S.source.namedKernels_size S.last high V E w nodes i

private theorem count_le {X : Type} {f g : Fintype X} {n m : ℕ}
    (h : @Fintype.card X f * n ≤ m) : @Fintype.card X g * n ≤ m :=
  (Subsingleton.elim f g) ▸ h

set_option maxHeartbeats 1200000 in
/-- A calibrated schedule and measured physical node family yield an actual
outer site epoch on all admissible child rows. Both boundary costs and the
full source receipts refer to the literal compiled frames. -/
theorem epoch_of_nodes (S : SiteSchedule e) :
    ∃ A a B b : ℕ, ∀ {start T t : ℕ} (deep : S.floor+1+S.drop*T ≤ start) (ht : t<T),
      let d := offset S start t
      S.FitsLevels d → S.HasLeaves d → S.RunsEnriched.{max 1 u,u} d →
      ∀ (shape : ℕ → Shape) (budget V E cap : ℕ → ℕ) (w : ℕ)
        (endShape : shape (t+1) = ⟨V S.rounds,E S.rounds⟩),
        let initial := (shape t).subdivide ⌈S.budget/S.radius⌉₊
        V 0 = initial.sites → E 0 = initial.edges → initial.sites ≤ 2^w → V S.rounds ≤ 2^w →
        (1+3*Fintype.card (Option (allowedMoves (Cube D) S.budget) × Fin (hopCount S.budget S.radius)))*
          (1+budget t) ≤ cap 0 →
        S.recordFactor*(1+budget t) ≤ 1+budget (t+1) →
        ∀ (P : Type) [Fintype P] (bits : P → ℕ)
          (nodes : ∀ i : Fin S.rounds, S.source.Node S.last (S.high d) V E w S.fanIn i)
          (widthCap : Fin S.rounds → ℕ),
          (∀ i : Fin S.rounds, SourceTemplate.NodeRun.{u,0} (P := Port S.fanIn (Port (fan S) P t) i.val)
            (bits := width (width bits (fan S) t) S.fanIn i.val) (S.source.pattern i)
            (S.source.stepDepth S.last (S.high d) i) S.positiveFanIn (S.source.catalog (i.val+1)) (widthCap i) (nodes i)) →
          (∀ i : Fin S.rounds, Fintype.card (Cube D → Deck (S.level d i.val+1))*cap i.val ≤ widthCap i) →
          (∀ i : Fin S.rounds, (S.source.pattern i).record*S.fanIn*cap i.val ≤ cap (i.val+1)) →
          ∃ C : Compilation (bits := bits) deep ht budget V E cap w endShape nodes,
            C.pre.size ≤ startCost (Fintype.card (Cube D)) ⌈S.budget/S.radius⌉₊ A a (fan S) (S.high d) w (shape t) ∧
            C.post.size ≤ finishCost B b d w (shape (t+1)) := by
  obtain ⟨A,a,subdivide⟩ := subdivision_inputs S
  obtain ⟨B,b,terminal⟩ := S.terminal_frames (factorEnum D)
  refine ⟨A,a,B,b,?_⟩
  intro start T t deep ht d level leaves runs shape budget V E cap w endShape initial hv he fit0 fitb
    cap0 capb P fp bits nodes widthCap nodeRun widths growth
  obtain ⟨pre,preCost,prepare⟩ := subdivide deep ht level leaves shape budget V E cap w hv he fit0 cap0
  let inputs (c : Fin (fan S) → Admissible (Good (S := S) (start := start) (bits := bits) (shape := shape)
      (w := w) budget) t) := (prepare c).some
  obtain ⟨r⟩ := S.source.namedRun_of_nodes (P := Port (fan S) P t) (bits := width bits (fan S) t)
    (Extra := fun _ => Unit) S.last (S.high d) V E w cap (fun _ _ => True) S.positiveFanIn nodes widthCap
    nodeRun (fun i => count_le (X := Cube D → Deck (S.level d i.val+1)) (widths i)) growth (S.source.retains_unit S.last (S.high d) V E w cap S.positiveFanIn)
  let field := segmentField (factorEnum D) (S.source.catalog S.rounds) (lev := S.level d S.rounds) rfl
  obtain ⟨f,cert,postCost⟩ := terminal d (V S.rounds) (E S.rounds) w field fitb
  let returns (c) := (returned_execution (F := r.program) deep ht c (inputs c).flat
    (fun a => a.val.words) endShape f runs cert (fun a => a.property.placed)
    (fun i child => (r.installed i child).measure) r.saveNames (fun i child => (r.installed i child).records)
    (fun a => a.val.names) (fun a => a.property.reads) (inputs c).initialSites (inputs c).originalPack
    (inputs c).originalRoutes (inputs c).originalPotential capb)
  let C : Compilation (bits := bits) deep ht budget V E cap w endShape nodes :=
    ⟨r,pre,f,_,terminalPost_size _ endShape f,inputs,fun c => (returns c).choose,fun c => (returns c).choose_spec⟩
  refine ⟨C,preCost,?_⟩
  rw [C.post_size,endShape]
  exact postCost

end PackedHistoryCircuit.Normalized.EnrichedOuter.Boundary

end BorderVNP
end Computability
end OAI
