import OAI.Computability.BorderVNP.CellSparseFactorCode
import OAI.Computability.BorderVNP.PackedBankRecords

/-! # Relocation and ties to the owning cell's physical assignment bank

A public site prefix locates the complete auxiliary subbank inside its cell.
All descriptor tests are invariant under that change of origin. Additional
strided equalities tie the occupied auxiliary rows to their physical data.
Together with the zero suffixes these equalities determine every guessed bit.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace CellSparse

/-- Relocate both ports of one occurrence-routing rule. -/
def Route.shift (r : Route) (off : ℕ) : Route :=
  { r with original := r.original.shift off, compact := r.compact.shift off }

/-- Move every absolute bit address in the record by the owning site's prefix. -/
def Record.shift (r : Record) (off : ℕ) : Record :=
  match r with
  | .zero n w p => .zero n w (p.shift off)
  | .equal n w s t => .equal n w (s.shift off) (t.shift off)
  | .box id base n d => .box id (off+base) n d
  | .profile n s w p rs => .profile n (s.shift off) w p (rs.map (fun r => r.shift off))

private theorem word_shift (bank : ℕ → Bool) (off : ℕ) (xs : List ℕ) :
    word bank (xs.map (off+·)) = word (fun t => bank (off+t)) xs := by
  induction xs with
  | nil => rfl
  | cons i xs ih => simp only [List.map_cons,word,ih]

private theorem label_shift (bank : ℕ → Bool) (off : ℕ) (p : Port) (w i : ℕ) :
    label bank (p.shift off) w i = label (fun t => bank (off+t)) p w i := by
  unfold label
  rw [← word_shift]
  congr 1
  simp [Port.lanes,Function.comp_def]

private theorem earlier_shift (bank : ℕ → Bool) (off : ℕ) (p : Port) (w t i : ℕ) :
    earlier bank (p.shift off) w t i = earlier (fun n => bank (off+n)) p w t i := by
  simp only [earlier,funext (label_shift bank off p w)]

/-- A record at the relocated address reads exactly its original site-local assignment. -/
theorem Record.valid_shift (r : Record) (boxes : List (List Factor)) (bank : ℕ → Bool) (off : ℕ) :
    (r.shift off).Valid boxes bank ↔ r.Valid boxes (fun t => bank (off+t)) := by
  cases r with
  | zero n w p => simp [Record.shift,Record.Valid,zeroValid]
  | equal n w s t => simp [Record.shift,Record.Valid,equalValid]
  | box id base n d => rfl
  | profile n s w p rs =>
    simp only [Record.shift,Record.Valid,profileValid,label_shift,earlier_shift,List.forall_mem_map,
      Route.shift,Port.atBit_shift]

end CellSparse

namespace Packing.BankCircuit

open Crossing.Profile.Cell CellSparse
open scoped Classical

variable {R : Type*} [Fintype R] (L : BankLayout R)

/-- One whole-bundle tie from a canonical physical port to its occupied auxiliary row. -/
noncomputable def tie (off : ℕ) (canonical : R → Port) (r : R) : Record :=
  .equal (L.copies r) (L.lanes r) (canonical r) ((L.port r).shift off)

/-- The endpoint comparisons generated by a strided tie are exactly the physical data
equalities for all occupied bits, including zero-width rows. -/
theorem tie_valid (off : ℕ) (canonical : R → Port) (r : R) (boxes : List (List Factor)) (bank : ℕ → Bool) :
    (tie L off canonical r).Valid boxes bank ↔
      ∀ (i : Fin (L.copies r)) (k : Fin (L.lanes r)),
        bank (off + (L.port r).atBit i k) = bank ((canonical r).atBit i k) := by
  constructor
  · intro h i k
    exact ((Port.atBit_shift _ _ _ _).symm ▸ (h i i.isLt k k.isLt).symm)
  · intro h i hi k hk
    simpa only [Port.atBit_shift] using (h ⟨i,hi⟩ ⟨k,hk⟩).symm

/-- The cell's canonical wires, each stored once, determine every auxiliary slot
after applying the sparse ties and relocated suffix pins. -/
theorem tiedBank_unique (off : ℕ) (canonical : R → Port) (boxes : List (List Factor)) (bank : ℕ → Bool)
    (htie : ∀ r, (tie L off canonical r).Valid boxes bank)
    (hpad : ∀ r, ((padding L r).shift off).Valid boxes bank)
    {i : ℕ} (hi : i < Fintype.card R * L.stride) :
    bank (off+i) = paddedBank L (fun r n k => bank ((canonical r).atBit n k)) i := by
  apply padded_unique L _ boxes (fun t => bank (off+t)) _ _ hi
  · exact fun r => (Record.valid_shift _ _ _ _).mp (hpad r)
  · exact fun r => (tie_valid L off canonical r boxes bank).mp (htie r)

end Packing.BankCircuit

end BorderVNP
end Computability
end OAI
