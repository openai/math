import OAI.Computability.BorderVNP.CoverFrameOperator
import OAI.Computability.BorderVNP.CoverHeckeCorrespondenceWords
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.MeasureTheory.Integral.Bochner.Basic

/-!
# Ergodicity of the compact Hecke correspondence

For a compact frame quotient, preservation of full-support Haar measure and
density of the subgroup generated by the lattice and its commensurator element
force every harmonic continuous function to be constant. This identifies the
uniform limit of the actual Hecke Cesàro averages.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace Hecke

open BoundedContinuousFunction MeasureTheory Set Finset Filter
open scoped Topology

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
variable (Γ : Subgroup G) (z : G) [Fintype (Cosets (intersection Γ z))]

omit [TopologicalSpace G] [IsTopologicalGroup G] in
private theorem branch_sum (f : Cosets Γ → ℝ) (x : G) :
    ∑ i, f (branch Γ z x i) = (Fintype.card (Cosets (intersection Γ z)) : ℝ) *
      average Γ z f (coset Γ x) := by
  have : Nonempty (Cosets (intersection Γ z)) := ⟨coset _ 1⟩
  rw [average_coset, mul_inv_cancel_left₀ (by positivity)]

private def leftInvariants (f : Cosets Γ → ℝ) : Subgroup G where
  carrier := {a | ∀ x, f (coset Γ (a*x)) = f (coset Γ x)}
  one_mem' := by simp
  mul_mem' := by intro a b ha hb x; rw [mul_assoc, ha, hb]
  inv_mem' := by intro a ha x; simpa using (ha (a⁻¹*x)).symm

private theorem invariants_closed (f : Cosets Γ →ᵇ ℝ) : IsClosed (leftInvariants Γ f : Set G) := by
  have h : (leftInvariants Γ f : Set G) = ⋂ x : G, {a | f (coset Γ (a*x)) = f (coset Γ x)} := by
    ext a; simp [leftInvariants]
  rw [h]
  exact isClosed_iInter fun x => isClosed_eq (f.continuous.comp
    ((coset_openQuotient Γ).continuous.comp (continuous_id.mul continuous_const))) continuous_const

variable [CompactSpace (Cosets Γ)] [MeasurableSpace (Cosets Γ)] [OpensMeasurableSpace (Cosets Γ)]

/-- Harmonic functions of the finite Hecke correspondence are constant under density and stationarity. -/
theorem harmonic_const (μ : Measure (Cosets Γ)) [IsFiniteMeasure μ] [μ.IsOpenPosMeasure]
    (hμ : ∀ f : Cosets Γ →ᵇ ℝ, (∫ x, operator Γ z f x ∂μ) = ∫ x, f x ∂μ)
    (hdense : Dense (Subgroup.closure ((Γ : Set G) ∪ {z}) : Set G))
    (f : Cosets Γ →ᵇ ℝ) (hfixed : operator Γ z f = f) :
    f = const (Cosets Γ) (f (coset Γ 1)) := by
  let value (x : Cosets Γ) i := f (branch Γ z x.out i)
  let card : ℝ := Fintype.card (Cosets (intersection Γ z))
  have hout (x : Cosets Γ) : coset Γ x.out = x := Quotient.out_eq x
  have hav (x : Cosets Γ) : ∑ i, value x i = card * f x := by
    rw [show (∑ i, value x i) = card * operator Γ z f (coset Γ x.out) from branch_sum Γ z _ _,
      hout, hfixed]
  have hs (x : Cosets Γ) : ∑ i, (value x i)^2 = card * operator Γ z (f*f) x := by
    calc
      _ = ∑ i, (f*f) (branch Γ z x.out i) := by simp [value, sq]
      _ = card * operator Γ z (f*f) (coset Γ x.out) := branch_sum Γ z _ _
      _ = _ := by rw [hout]
  have hv (x : Cosets Γ) (i) : value x i = f x := by
    apply CoverFrameMixing.branch_eq_of_stationary μ f value f.continuous hav
    · simp_rw [hs]
      exact continuous_const.mul (operator Γ z (f*f)).continuous
    · simp_rw [hs, integral_const_mul, hμ, sq, mul_apply]
      rfl
  have hzinv : z ∈ leftInvariants Γ f := by
    intro x
    have hx : coset Γ (coset Γ x).out = coset Γ x := Quotient.out_eq _
    obtain ⟨a,ha⟩ : ∃ a : Γ, x = (a:G) * (coset Γ x).out := by
      have hmem := QuotientGroup.rightRel_apply.mp (Quotient.exact hx)
      exact ⟨⟨x * (coset Γ x).out⁻¹, hmem⟩, by simp⟩
    have h := hv (coset Γ x) (coset (intersection Γ z) a)
    change f (coset Γ (z * a * (coset Γ x).out)) = f (coset Γ x) at h
    rwa [mul_assoc, ← ha] at h
  have hsub : Subgroup.closure ((Γ:Set G) ∪ {z}) ≤ leftInvariants Γ f := by
    rw [Subgroup.closure_le]
    rintro a (ha|rfl)
    · intro x
      apply congrArg f
      apply Quotient.sound
      exact QuotientGroup.rightRel_apply.mpr (by simpa [mul_assoc] using Γ.inv_mem ha)
    · exact hzinv
  have hall : ∀ a : G, a ∈ leftInvariants Γ f := fun a =>
    closure_minimal hsub (invariants_closed Γ f) (hdense a)
  ext ⟨a⟩
  change f (coset Γ a) = f (coset Γ 1)
  simpa only [mul_one] using (hall a : ∀ x, f (coset Γ (a*x)) = f (coset Γ x)) 1

/-- Integration as a bounded linear observable on the compact quotient. -/
noncomputable def observable (μ : Measure (Cosets Γ)) [IsFiniteMeasure μ] :
    (Cosets Γ →ᵇ ℝ) →L[ℝ] ℝ :=
  let L : (Cosets Γ →ᵇ ℝ) →ₗ[ℝ] ℝ := {
    toFun := fun f => ∫ x, f x ∂μ
    map_add' := by
      intro f g
      exact integral_add (f.continuous.integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)) (g.continuous.integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _))
    map_smul' := by intro c f; exact integral_const_mul c _ }
  L.mkContinuous (μ.real univ) (fun f => by
    rw [mul_comm]
    exact norm_integral_le_of_norm_le_const (Eventually.of_forall (f.norm_coe_le_norm)))

omit [IsTopologicalGroup G] in
/-- The observable gives the ordinary real integral against the quotient measure. -/
theorem observable_apply (μ : Measure (Cosets Γ)) [IsFiniteMeasure μ] (f : Cosets Γ →ᵇ ℝ) :
    observable Γ μ f = ∫ x, f x ∂μ := rfl

/-- Uniform convergence of the finite Hecke means to the Haar integral. -/
theorem frame_means_tendsto (μ : Measure (Cosets Γ)) [IsProbabilityMeasure μ] [μ.IsOpenPosMeasure]
    (hμ : ∀ f : Cosets Γ →ᵇ ℝ, (∫ x, operator Γ z f x ∂μ) = ∫ x, f x ∂μ)
    (hdense : Dense (Subgroup.closure ((Γ : Set G) ∪ {z}) : Set G)) (f : Cosets Γ →ᵇ ℝ) :
    Tendsto (CoverFrameMixing.mean (operator Γ z) f) atTop
      (𝓝 (const (Cosets Γ) (∫ x, f x ∂μ))) := by
  apply CoverFrameMixing.mean_tendsto _ (operator_norm_le Γ z) (observable Γ μ)
    (fun u => by simpa [observable_apply] using hμ u) _ _ (average_compact Γ z f)
  intro g hg hi
  have hc := harmonic_const Γ z μ hμ hdense g hg
  rw [observable_apply, observable_apply, hc] at hi
  exact hc.trans (congrArg (const (Cosets Γ)) (by simpa using hi))

end Hecke

