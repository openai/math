/-- The immutable issued packet and the actual sparse emission launch the
private argument for each received report, before selecting any successful
private computation on the circuit. -/
theorem SignedCalendarAt.frozenLookupReportArguments [Fact (8≤header)]
    (values : (seedBundle (tape₁) axes d₁ (order₁) position copies₁).Tables F)
    (h : Index (Fin (Module.finrank (ZMod common.p) chart.E)) (Fin (pairedTableParameters (l+1) size₁))
      (chart.pinRadius (R₁+1) r₁))
    (i : Fin pins₁ → Bool) (hist : history(values)) (claim : Fin ((R₁+1)*(qdim)*w₁) → Bool)
    (raw : CheckedBroadcast (planner₁).cube) (allowed : (elig(values,hist)) raw.val)
    (publication : cal.LookupReportPublicationAt oper qpos position chart reader chargeFit values h i hist claim raw allowed)
    (capacity : cal.LookupReportCapacityAt oper qpos position chart reader chargeFit values h i hist claim raw allowed)
    (opening : cal.LookupReportOpeningAt oper qpos position chart reader chargeFit values h i hist claim raw allowed)
    (delivered : cal.LookupBundleDeliveryAt oper qpos position chart reader chargeFit values h i hist claim raw allowed) :
    cal.LookupReportArgumentsAt oper qpos position chart reader chargeFit values h i hist claim raw allowed := by
  let prepared := cal.frozenLookupBeforeEmission oper qpos position chart reader chargeFit values h i hist claim
    raw allowed publication capacity opening
  let provider := cal.frozenLookupArgumentEmission oper qpos position chart reader chargeFit values h i hist claim
    raw allowed publication capacity opening delivered
  exact finishOriginalReportArguments% prepared with provider

