import OAI.Computability.VPVNP.LinearNormalization
import OAI.Computability.VPVNP.MonicGraphRelation
import OAI.Computability.VPVNP.PerronRelation

/-! # Bounded monic relations inside polynomially parametrized algebras

For the coefficient specialization in §9.1 the number of output coordinates can be
exponential. The degree estimate must depend on the number of parameters. We normalize
the subalgebra generated by the given coordinates after adjoining an independent subset
of the parameter variables. Setting those independent variables to zero recovers a
relation using only the original coordinates.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace Branch

open MvPolynomial Algebra VPVNP.RadicalCertificate

variable {K I : Type*} [Field K] [Infinite K] [Fintype I] {m D : ℕ}

private theorem normalized_relation
    (S : Subalgebra K (MvPolynomial (Fin m) K)) [Algebra.IsAlgebraic S (MvPolynomial (Fin m) K)]
    (v : I → S) (hv : adjoin K (Set.range v) = ⊤)
    (hd : ∀ i, (v i).val.totalDegree ≤ D) (T : S) (hT : T.val.totalDegree ≤ D) :
    ∃ (Q : Fin m → S) (U : MvPolynomial (Fin (m+1)) K),
      (∀ j, Q j ∈ Submodule.span K (Set.range v)) ∧
      U.totalDegree ≤ perronSimplexBound m D ∧ (finSuccEquiv K m U).Monic ∧
      aeval (Fin.cons T Q) U = 0 := by
  classical
  let v' := v ∘ (Fintype.equivFin I).symm
  have hr : Set.range v' = Set.range v := (Fintype.equivFin I).symm.surjective.range_comp v
  have hi (a : S) : IsIntegral (adjoin K (Set.range v')) a := by
    let z : adjoin K (Set.range v') := ⟨a, by rw [hr, hv]; trivial⟩
    exact isIntegral_algebraMap (x := z)
  obtain ⟨r, Q, hspan, hQ, hInt⟩ := VPVNP.LinearNormalization.exists_of_integral_adjoin v' hi
  have : Algebra.IsIntegral (adjoin K (Set.range Q)) S := ⟨hInt⟩
  have hb : IsTranscendenceBasis K Q :=
    (algebraicIndependent_iff_injective_aeval.mpr hQ).isTranscendenceBasis_iff_isAlgebraic.mpr
      inferInstance
  have hdim := (hb.algebraMap_comp (A := MvPolynomial (Fin m) K)).cardinalMk_eq
    (IsTranscendenceBasis.mvPolynomial (Fin m) K)
  have : r = m := by simpa using hdim
  subst r
  rw [hr] at hspan
  have hdeg (j) : (Q j).val.totalDegree ≤ D := by
    obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp (hspan j)
    rw [← ha]
    change (S.val (∑ i, a i • v i)).totalDegree ≤ D
    simp only [map_sum, map_smul]
    exact totalDegree_finsetSum_le fun i _ => (totalDegree_smul_le ..).trans (hd i)
  let x : Fin (m+1) → S := Fin.cons T Q
  obtain ⟨W, hW, hWd, hWz⟩ := perron_relation (S.val ∘ x)
    (fun i => Fin.cases hT hdeg i)
  have hz : aeval x W = 0 := by
    apply Subtype.val_injective (p := (· ∈ S))
    change S.val ((aeval x) W) = 0
    rw [← AlgHom.comp_apply, comp_aeval]
    exact hWz
  have hiT : IsIntegral (aeval Q : MvPolynomial (Fin m) K →ₐ[K] S).range T := by
    rw [← adjoin_range_eq_range_aeval]
    exact hInt T
  obtain ⟨U, hmon, heq, _, hle⟩ := monic_relation_of_relation Q T hQ hiT W hW hz
  exact ⟨Q, U, hspan, hle.trans hWd, hmon, heq⟩

omit [Infinite K] in
private theorem map_relation {V A A' : Type*} [CommRing A] [CommRing A'] [Algebra K A]
    [Algebra K A'] (f : A →ₐ[K] A') (x : V → A) (q : MvPolynomial V K) (hq : aeval x q = 0) :
    aeval (f ∘ x) q = 0 := by
  change aeval (fun i => f (x i)) q = 0
  rw [← comp_aeval, AlgHom.comp_apply, hq, map_zero]

set_option maxHeartbeats 1000000 in
/-- An element of a polynomially parametrized algebra satisfies a monic relation in
linear combinations of its generators. The total degree is bounded in terms of parameter
count and generator degree, independently of the number of generators. -/
theorem monic_relation_in_span (g : I → MvPolynomial (Fin m) K)
    (T : MvPolynomial (Fin m) K) (hT : T ∈ adjoin K (Set.range g))
    (hTd : T.totalDegree ≤ D) (hd : ∀ i, (g i).totalDegree ≤ D) (hD : 1 ≤ D) :
    ∃ (Q : Fin m → MvPolynomial (Fin m) K) (U : MvPolynomial (Fin (m+1)) K),
      (∀ j, Q j ∈ Submodule.span K (Set.range g)) ∧
      U.totalDegree ≤ perronSimplexBound m D ∧ (finSuccEquiv K m U).Monic ∧
      aeval (Fin.cons T Q) U = 0 := by
  classical
  let A := MvPolynomial (Fin m) K
  let B := adjoin K (Set.range g)
  let allX : Set A := Set.range X
  have hxTop : adjoin B allX = ⊤ := by
    apply top_unique
    intro a _
    induction a using MvPolynomial.induction_on with
    | C k => exact (adjoin B allX).algebraMap_mem (algebraMap K B k)
    | add p q hp hq => exact (adjoin B allX).add_mem (hp trivial) (hq trivial)
    | mul_X p i hp => exact (adjoin B allX).mul_mem (hp trivial) (subset_adjoin ⟨i, rfl⟩)
  have : Algebra.IsAlgebraic (adjoin B allX) A := ⟨fun x => by
    let z : adjoin B allX := ⟨x, by rw [hxTop]; trivial⟩
    exact isAlgebraic_algebraMap (A := A) z⟩
  obtain ⟨s, hs, hb⟩ := exists_isTranscendenceBasis_subset (R := B) allX
  let j : s → A := Subtype.val
  let : Fintype s := ((Set.finite_range (X : Fin m → A)).subset hs).fintype
  let S' := adjoin B (Set.range j)
  let S := S'.restrictScalars K
  have : Algebra.IsAlgebraic S A := hb.isAlgebraic
  let lifted (i : I) : S := algebraMap B S' ⟨g i, subset_adjoin ⟨i, rfl⟩⟩
  let ind (a : s) : S := ⟨j a, subset_adjoin ⟨a, rfl⟩⟩
  let v : I ⊕ s → S := Sum.elim lifted ind
  have hr : Set.range (S.val ∘ v) = Set.range g ∪ Set.range j := by
    ext x
    constructor
    · rintro ⟨i | i, rfl⟩
      · exact Or.inl ⟨i, rfl⟩
      · exact Or.inr ⟨i, rfl⟩
    · rintro (⟨i, rfl⟩ | ⟨i, rfl⟩)
      · exact ⟨Sum.inl i, rfl⟩
      · exact ⟨Sum.inr i, rfl⟩
  have hv : adjoin K (Set.range v) = ⊤ := by
    apply Subalgebra.map_injective (f := S.val) Subtype.val_injective
    rw [AlgHom.map_adjoin, ← Set.range_comp, hr, adjoin_union_eq_adjoin_adjoin, Algebra.map_top,
      Subalgebra.range_val]
  let t : S := algebraMap B S' ⟨T, hT⟩
  obtain ⟨Q, U, hQ, hUd, hmon, hz⟩ := normalized_relation S v hv
    (fun i => by
      cases i with
      | inl k => exact hd k
      | inr a =>
        obtain ⟨k, hk⟩ := hs a.property
        change (j a).totalDegree ≤ D
        rw [← show X k = j a from hk, totalDegree_X]
        exact hD) t hTd
  let retractB : S' →ₐ[B] B := (aeval (fun _ : s => (0 : B))).comp hb.1.repr
  let retract : S →ₐ[K] A := B.val.comp (retractB.restrictScalars K)
  have hfix (x : B) : retract (algebraMap B S' x) = (x : A) :=
    congrArg B.val (retractB.commutes x)
  have hkill (a : s) : retract (ind a) = 0 := by
    have ha : hb.1.repr (ind a) = X a := by
      apply hb.1
      exact (hb.1.aeval_repr (ind a)).trans (aeval_X (R := B) (Subtype.val : s → A) a).symm
    change B.val (aeval (fun _ : s => (0 : B)) (hb.1.repr (ind a))) = 0
    rw [ha, aeval_X, map_zero]
  refine ⟨retract ∘ Q, U, fun k => ?_, hUd, hmon, ?_⟩
  · obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp (hQ k)
    change retract (Q k) ∈ _
    rw [← ha, map_sum]
    apply Submodule.sum_mem
    intro i _
    rw [map_smul]
    apply Submodule.smul_mem
    cases i with
    | inl k =>
      rw [show retract (v (.inl k)) = g k from hfix _]
      exact Submodule.subset_span ⟨k, rfl⟩
    | inr a => rw [show retract (v (.inr a)) = 0 from hkill a]; exact Submodule.zero_mem _
  · have he : retract ∘ Fin.cons t Q = Fin.cons T (retract ∘ Q) := by
      funext i
      exact Fin.cases (hfix _) (fun _ => rfl) i
    rw [← he]
    exact map_relation retract _ U hz

end Branch

end BorderVNP
end Computability
end OAI
