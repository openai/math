import Mathlib.Algebra.MvPolynomial.Equiv
import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.Algebra.MvPolynomial.Degrees
import Mathlib.RingTheory.MvPolynomial.Basic

/-! # The graph algebra for separating a point from a parametrized image

For outputs `Y` and a point `c`, use the output coordinates together with the
parameter-scaled differences `t * (Yᵢ - cᵢ)`. A separating polynomial of any degree
puts `t` in the algebra generated by these functions. This is the qualitative
input to the effective normalization step of §9.1.
-/

namespace OAI
namespace Computability
namespace BorderVNP

namespace Branch

open MvPolynomial Algebra

variable {I K : Type*} [Field K] {h : ℕ}

/-- Coordinates on the formal graph in one extra scalar parameter. -/
noncomputable def differenceCoordinates (c : I → K) : I ⊕ I → MvPolynomial (Option I) K :=
  Sum.elim (fun i => X (some i)) (fun i => X none * (X (some i) - C (c i)))

/-- Evaluate the formal output variables at the parametrization, preserving the extra
variable as coordinate zero. -/
noncomputable def liftParametrization (Y : I → MvPolynomial (Fin h) K) :
    MvPolynomial (Option I) K →ₐ[K] MvPolynomial (Fin (h+1)) K :=
  aeval (fun o => o.elim (X 0) (fun i => rename Fin.succ (Y i)))

/-- Realized graph coordinates in the `h + 1` parameters. -/
noncomputable def realizedDifferences (Y : I → MvPolynomial (Fin h) K) (c : I → K) :
    I ⊕ I → MvPolynomial (Fin (h+1)) K := liftParametrization Y ∘ differenceCoordinates c

private theorem lifted_substitute (Y : I → MvPolynomial (Fin h) K) (q : MvPolynomial I K) :
    aeval (fun i => rename Fin.succ (Y i)) q = rename Fin.succ (aeval Y q) := by
  rw [← comp_aeval]; rfl

/-- An equation nonzero at the target expresses the new parameter in the graph algebra. -/
theorem parameter_mem_graph (Y : I → MvPolynomial (Fin h) K) (c : I → K)
    (q : MvPolynomial I K) (hq : aeval Y q = 0) (hc : eval c q ≠ 0) :
    X (0 : Fin (h+1)) ∈ adjoin K (Set.range (realizedDifferences Y c)) := by
  let S := adjoin K (Set.range (realizedDifferences Y c))
  let y (i) := rename Fin.succ (Y i)
  have hy (i) : y i ∈ S := by
    have h := subset_adjoin (R := K) (Set.mem_range_self (f := realizedDifferences Y c) (.inl i))
    simpa [realizedDifferences, liftParametrization, differenceCoordinates, y, S] using h
  have hd (i) : X 0 * (y i - C (c i)) ∈ S := by
    have h := subset_adjoin (R := K) (Set.mem_range_self (f := realizedDifferences Y c) (.inr i))
    simpa [realizedDifferences, liftParametrization, differenceCoordinates, y, S] using h
  have ht (p : MvPolynomial I K) : X 0 * (aeval y p - C (eval c p)) ∈ S := by
    induction p using MvPolynomial.induction_on with
    | C x => simp
    | add p q hp hq =>
      simp only [map_add, add_sub_add_comm, mul_add]
      exact S.add_mem hp hq
    | mul_X p i hp =>
      simp only [map_mul, aeval_X, eval_X]
      convert! S.add_mem (S.mul_mem hp (hy i)) (S.mul_mem (S.algebraMap_mem (eval c p)) (hd i))
        using 1
      change _ = _ + C (eval c p) * _
      ring
  have h0 : aeval y q = 0 := by rw [lifted_substitute, hq, map_zero]
  have he := S.mul_mem (S.algebraMap_mem (-(eval c q)⁻¹)) (ht q)
  rw [h0, zero_sub, mul_neg] at he
  change C (-(eval c q)⁻¹) * -(X 0 * C (eval c q)) ∈ S at he
  simpa [mul_left_comm, ← map_mul, hc] using he

/-- The formal graph functions have degree at most two in the parameter and outputs. -/
theorem differenceCoordinates_degree (c : I → K) (i : I ⊕ I) :
    (differenceCoordinates c i).totalDegree ≤ 2 := by
  cases i with
  | inl i => simp [differenceCoordinates]
  | inr i =>
    apply (totalDegree_mul ..).trans
    rw [totalDegree_X]
    have hd := totalDegree_sub_C_le (X (some i) : MvPolynomial (Option I) K) (c i)
    rw [totalDegree_X] at hd
    omega

/-- The realized coordinates have degree at most `d + 1` in the parameters. -/
theorem realizedDifferences_degree {d : ℕ} (Y : I → MvPolynomial (Fin h) K)
    (hY : ∀ i, (Y i).totalDegree ≤ d) (c : I → K) (i : I ⊕ I) :
    (realizedDifferences Y c i).totalDegree ≤ d+1 := by
  cases i with
  | inl i =>
    simpa only [realizedDifferences, Function.comp_apply, differenceCoordinates, Sum.elim_inl,
      liftParametrization, aeval_X, Option.elim_some] using
      ((totalDegree_rename_le Fin.succ (Y i)).trans ((hY i).trans (Nat.le_succ d)))
  | inr i =>
    simp only [realizedDifferences, Function.comp_apply, differenceCoordinates, Sum.elim_inr,
      liftParametrization, map_mul, map_sub, aeval_X, aeval_C, algebraMap_eq, Option.elim_some,
      Option.elim_none]
    apply (totalDegree_mul ..).trans
    rw [totalDegree_X, Nat.add_comm]
    apply Nat.add_le_add_right
    apply (totalDegree_sub ..).trans
    simpa using (totalDegree_rename_le Fin.succ (Y i)).trans (hY i)

/-- Substituting polynomials of degree at most `b` multiplies total degree by at most `b`. -/
theorem substitute_degree {V W : Type*} {b : ℕ} (f : V → MvPolynomial W K)
    (hf : ∀ i, (f i).totalDegree ≤ b) (q : MvPolynomial V K) :
    (aeval f q).totalDegree ≤ b*q.totalDegree := by
  classical
  conv_lhs => rw [q.as_sum, map_sum]
  apply totalDegree_finsetSum_le
  intro a ha
  rw [aeval_monomial, algebraMap_eq]
  refine (totalDegree_mul ..).trans ?_
  rw [totalDegree_C, zero_add]
  calc
    _ ≤ ∑ i ∈ a.support, (f i ^ a i).totalDegree := totalDegree_finsetProd _ _
    _ ≤ ∑ i ∈ a.support, a i * b := Finset.sum_le_sum fun i _ =>
      (totalDegree_pow ..).trans (Nat.mul_le_mul_left _ (hf i))
    _ ≤ b*q.totalDegree := by
      rw [← Finset.sum_mul, Nat.mul_comm b]
      exact Nat.mul_le_mul_right _ (le_totalDegree ha)

end Branch

end BorderVNP
end Computability
end OAI
