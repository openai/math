include accepted in
/-- Running the named reset up to its pre-funding checkpoint preserves the exact
low-order existence plane and the complete forward/inverse host directory. -/
theorem DateInputs.fromNamed_operand_actors (degreeAt : venue.degree=D) (ready : (u).Ready) (mem : Memory w)
    (gr : z=S.grainAt G.b p (age+1)) (fee : wire=S.epochPower^S.priceExponent)
    (capAt : input.placement.cap=cap) (history : hist=S.firstWidth G.b p) (branch : G.b≤2^S.capGain)
    (seen : stageVenue input input.valid.host io (successor₀).funded.oldLanes (successor₀).funded.precision floor
      (input.venueRoster input.valid.host) mem) (popFit : count.Fits w floor)
    (popRead : mem count.base=(Fintype.card input.V:Word w))
    (wireRoom : ∀(x:DescentColonies.Block k)(j:Fin (2*input.placement.cap)),(io.wire x.val j.val).Fits w floor ∧
      HH*chunks (S.groupCount age) (successor₀).funded.oldLanes≤(io.wire x.val j.val).size)
    (oldPos : 0<(successor₀).funded.oldLanes) (oldWidth : (successor₀).funded.precision=S.censusBits p)
    (entryFits : start<2^w) (low : k≤(E).low)
    (score : 3*(E).dim+((E).precision+Nat.clog 2 (E).hosts)+2≤w)
    (live : 0 < amp) (degreePos : 0 < 32*Nat.clog 2 (2*venue.degree))
    (headerBits : Nat.clog 2 ((E).dim+2)+((E).dim+S.censusBits p) ≤ w) (hostBits : HH < 2^w)
    (ranksFit : venue.degree*2^Ht < 2^w)
    (namesFit : DescentFallbackShapeTable.actorWordBits k (32*Nat.clog 2 (2*venue.degree)) g n ≤ w)
    (degFit : venue.degree+1 < 2^w) (laneRoom : 2^e ≤ w)
    {snapshot:Memory w} (atOperands:(u).throughOperandDate.Runs ((entry₀).image mem) snapshot) :
    (∀j (p₀:Row HH (2^(T).commonDepth) (2^e)),snapshot ((inputs).actor.base+j.val*actorRows+
      (row _ _ _ p₀).val)=((data (ClosedReset.Recorded.realActor (reset:=B)
      (ClosedReset.Window.shapes B) (ClosedReset.Window.rack B input.valid.host) j) p₀).val:Word w)) ∧
    snapshot (inputs).ranks.count.base=(Fintype.card B.next.V:Word w) ∧
    (∀v:B.next.V,snapshot ((inputs).ranks.inverse.base+(B.next.vertex v).val)=((rawId v).val:Word w)) ∧
    (∀v:B.next.V,snapshot ((inputs).ranks.forward.base+(rawId v).val)=((B.next.vertex v).val:Word w)):=by
  have reached:=DateInputs.fromNamed_venue_directory accepted drift degree payload e previous M nextM oldLanes primitiveLanes
    printedBits venue io floor w fitsStencil fitsSigned fitsCut count previousMeta previousArguments initial prepared sceneRoom
    degreeAt ready mem gr fee capAt history branch seen popFit popRead wireRoom oldPos oldWidth entryFits low score
    live degreePos headerBits hostBits ranksFit namesFit degFit laneRoom
  obtain ⟨measured,posted,scan,ran,_,total,inv,fwd,_,_,mid,write,planes,_⟩:=reached
  have shSize:(U).shapes=rows:=by
    change (DescentDenseHostOrder.roster ctl.board k (GroupStage.depthBound venue.degree n f g)).card=_
    rw [degreeAt]
    exact (DescentExteriorReplay.HopTables.reset_public B).1.symm
  have chSize:(U).chunksPerHost=chunks (2^(T).commonDepth) (2^e):=by
    change chunks (2^cc) (2^e)=_
    rw [B.commonDepth]
  exact ClosedReset.Window.recorded_operand_actors B input.valid.host ready rfl shSize chSize
    atOperands scan ran total inv fwd write planes

end
