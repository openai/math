import OAI.Hierarchy.DescentPublicDegreeNumbers

namespace OAI
namespace Hierarchy.DescentRawCablePanel
def normBits (cap b C pad : ℕ) := Nat.clog 2 (max (cap*b) (C+1+pad)+1)
end Hierarchy.DescentRawCablePanel

namespace Hierarchy.DescentSixParty.Chronology
open DescentHostDegree
def donorNameBits (age degree : ℕ) := Nat.clog 2 (2^(age+1)*(2^(packExponent 20 degree)+2))
end Hierarchy.DescentSixParty.Chronology

end OAI
