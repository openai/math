import OAI.Hierarchy.TaggedWirePacketInputs
import OAI.Hierarchy.TaggedWirePacketRoleOrder

namespace OAI
/-! # The emitted native operands of the actual elected strip installation -/
noncomputable section
namespace Hierarchy.ProtocolRAM.Calendar.CatalogueRows
open Computability.VPVNP.BurstRAM PrivateRAM ProbeStage CoreBoard AdaptiveProbe Strip WireTelescope StripPaths PacketTurns
open LinearAlgebra.SpectralBooks ChordGraph
open scoped Fin.CommRing Classical
variable {h d k K n w Rn : ℕ} {S : PurchaseSampler} {A B Ball : Type} [Fintype A] [Fintype B]
local notation "C" => TreeColumn n
local notation "X" => TreeSite n k
local notation "R" => ColumnWires.Role C (Fin n) (A⊕B) k
local notation "T" => TreeLink n k
local notation "U" => R⊕T
local notation "PortSpec" => StripPorts S h d k C (Fin n) B
variable (extra : A⊕B→DistinctPair (TreeSite n k)) (place : Ball×TreeSite n k↪Fin K) (u : Ball)
    (b : Board) (shift : ℕ) (phys : Fin (shift+b.rows)→Chord K)
local notation "ends" => ColumnWires.ends (Strip.horizontal n) extra
local notation "Fwd" => Fin.natAdd shift
local notation "oldChord" => Sum.elim (reportedRole place ends u) (reportedRole place (treeEnds n k) u)

def emitterMate (p : PortSpec) (b : Board) (shift : ℕ) (c : C) (j : Fin k) : Expr :=
  PacketScan.add (.lit shift) (p.mate b (.catalyst c j : R))

def emitterTree (p : PortSpec) (b : Board) (shift : ℕ) (t : T) : Expr :=
  PacketScan.add (.lit shift) (p.primary b (treeRole n k t : R))

omit [Fintype A] [Fintype B] in
/-- The operands are generated by the actual catalogue primary and opposite
radius lookups. Only the retained input needs its prior commodity address. -/
theorem StripPorts.packet_reads (p : PortSpec) (m : Memory w) (reg : Word w)
    (lookup : Fin b.coreRows≃Edges S h d k) (loaded : CoreLookup.Loaded p.directory lookup m)
    (wide : b.rows<2^w) (π : Equiv.Perm (Fin (2^h)))
    (col : C → Columns h d) (column : ∀c,((p.column c).eval m reg).val=((Fintype.equivFin _) (col c)).val)
    (row : Fin b.rows→Site h d k×Site h d k)
    (core : ∀f,row (b.coreIndex (lookup.symm f))=CoreBoard.ends π f)
    (hor : ∀f l (v : Fin b.rows),((b.coreOnly (p.horizontal f l)).eval m reg).val=v.val →
      Faces (Prod.map col id) (ColumnWires.ends (Strip.horizontal n) extra (.horizontal f l)) (row v))
    (birth : ∀j (v : Fin b.rows),((p.probe j).eval m reg).val=v.val →
      Faces (Prod.map col id) (extra (.inr j)) (row v))
    (name : Site h d k↪Fin K) (fits : ∀x,place (u,x)=name (Prod.map col id x))
    (old : A→Fin (shift+b.rows)) (idx : R→Fin b.rows) (mate : C→Fin k→Fin b.rows)
    (stock : ∀a,phys (old a)=reportedRole place (ColumnWires.ends (Strip.horizontal n) extra) u (.extra (.inl a)))
    (idxRead : ∀r,paidRole r→((p.primary b r).eval m reg).val=(idx r).val)
    (mateRead : ∀c j,((p.mate b (.catalyst c j : R)).eval m reg).val=(mate c j).val)
    (real : ∀v,∀ne:(row v).1≠(row v).2,phys (Fin.natAdd shift v)=Probe.orderedEnds
      (name (row v).1) (name (row v).2) (name.injective.ne ne))
    (site : X→Expr) (stored : A→Expr) (qty : U→Expr) (enum : Fin Rn≃U) (bits : Fin Rn→ℕ)
    (room : K≤2^w) (mounted : ∀x,(site x).eval m reg=((place (u,x)).val : Word w))
    (held : ∀a,(stored a).eval m reg=((old a).val : Word w))
    (amount : ∀i,(qty (enum i)).eval m reg=(bits i : Word w)) :
    let pr:=primaryRow (b:=b) old Fwd idx
    let ma:=fun c j=>Fwd (mate c j)
    let tr:=fun j:T=>Fwd (idx (treeRole n k j))
    let target:=Sum.elim (links (Strip.horizontal n) extra place u pr ma) (fun j=>[tr j]) ∘ enum
    Reads (oldChord ∘ enum) phys target bits
      (packetInputs extra place u pr ma tr enum site (readPrimary stored shift (p.primary b))
        (emitterMate (A:=A) p b shift) (emitterTree (A:=A) p b shift) qty) m reg := by
  dsimp only
  obtain ⟨first,second,tree⟩:=p.install_faces extra place u phys b m reg lookup loaded wide π col column row
    core hor birth name fits old Fwd idx mate stock idxRead mateRead real
  have selected (r : R) (good : paidRole r) : (p.primary b r).eval m reg=((idx r).val : Word w) := by
    apply Fin.ext
    exact (idxRead r good).trans (Fin.val_cast_of_lt ((idx r).isLt.trans wide)).symm
  have other (c : C) (j : Fin k) : (p.mate b (.catalyst c j : R)).eval m reg=((mate c j).val : Word w) := by
    apply Fin.ext
    exact (mateRead c j).trans (Fin.val_cast_of_lt ((mate c j).isLt.trans wide)).symm
  apply inputs_read extra place u phys _ _ _ enum site _ _ _ qty bits m reg room mounted amount
    (read_primary b shift stored (p.primary b) old idx m reg held selected)
  · intro c j;simp [emitterMate,PacketScan.add_eval,other c j,Expr.eval,Nat.cast_add]
  · intro t
    have good : paidRole (treeRole n k t : R) := by rcases t with i|⟨c,j,b⟩ <;> trivial
    simp [emitterTree,PacketScan.add_eval,selected _ good,Expr.eval,Nat.cast_add]
  · exact first
  · exact second
  · exact tree

end Hierarchy.ProtocolRAM.Calendar.CatalogueRows

end
end OAI
