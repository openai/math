/-- Each physical root lookup at the named reset accesses the original page under the public calendar chart. -/
theorem fromNamed_chart_root_bank (mixed : ClosedReset.Window.MixedGeometry B (2^e) M cal (v) base₀)
    (s : Bool) (t : DescentResetLocalRoster.Root k (2^n)) :
    (u).earlier.pages s t=(im).receiver.privatePageBank (im).book s
      (ClosedReset.Window.chartTicket (date:=a) (floor:=start) B (2^e) M cal mixed t) :=by
  rw [fromNamed_root_bank]
  unfold fromNamed_root_image
  apply Receiver.IndexedRoots.privatePage_reindex (X₀)
  exact cast_heq _ _

end
