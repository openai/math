local notation "aRoom" => (A).endAddress v.mesh≤ size
local notation "entryWidth" => EntryOrder.sourceWidth v.sampler π.symm v.depth mark width (fuel v.mesh*width)

/-- The pre-event paid vector is zero, commodity stock is the funded input
payload, and no catalyst bit has been debited at date zero. -/
theorem wide_dated_first (extent : aRoom) (age : v.wideStockHeight≤h)
    (budget:v.keepLimit*width+1≤2^h) (small:width≤2^h) (issues:Attempt→Entry num width)
    (i:Source v.sampler π v.depth mark) :
    v.wideDatedValue h width v.maxBits mid chk issues 0 (visible i) =
      entryWidth i := by
  rcases i with e|goods|a
  · rfl
  · have lim:=v.wide_stock_sizes h width age budget small
    have zero:=v.wide_initial_stock h width size extent stock v.radius π o seed lim.words.addresses lim.strip
    change v.wireGoodsAt h width 0 mid goods=_
    simpa only [EntryOrder.sourceWidth] using v.wire_initial_goods h width mid zero.1 goods
  · change fuel v.mesh*width-PrefixReserve.used _ _ (PrefixReserve.countAt v.mesh issues 0) _=fuel v.mesh*width
    rw [PrefixReserve.chronological]
    simp

end Hierarchy.ProtocolRAM.Calendar.FixedProtocolFormat
