import OAI.Hierarchy.CircuitGenerators
import OAI.Computability.VPVNP.GradedComponents

namespace OAI
/-! # The ideal generated by the balanced homogeneous pieces of a circuit -/

namespace Hierarchy.CircuitSplit

open MvPolynomial Computability.VPVNP

variable {F σ : Type*} [Field F] {n : ℕ}

private def High (d : ℕ) (I : Ideal (MvPolynomial σ F)) (f : MvPolynomial σ F) : Prop :=
  ∀ t, 2 * d < 3 * t → t ≤ d → homogeneousComponent t f ∈ I

private def Balanced (d : ℕ) (I : Ideal (MvPolynomial σ F)) (f : MvPolynomial σ F) : Prop :=
  ∀ t, d < 3 * t → 3 * t ≤ 2 * d → homogeneousComponent t f ∈ I

private theorem above_third {d : ℕ} {I : Ideal (MvPolynomial σ F)} {f : MvPolynomial σ F}
    (mid : Balanced d I f) (high : High d I f) {j : ℕ} (hj : d < 3 * j) (hle : j ≤ d) :
    homogeneousComponent j f ∈ I := by
  by_cases h : 3 * j ≤ 2 * d
  · exact mid j hj h
  · exact high j (by omega) hle

private theorem high_mul {d : ℕ} {I : Ideal (MvPolynomial σ F)} {f g : MvPolynomial σ F}
    (mf : Balanced d I f) (mg : Balanced d I g) (hf : High d I f) (hg : High d I g) :
    High d I (f * g) := by
  intro t ht htd
  rw [Computability.VPVNP.homogeneousComponent_mul]
  apply I.sum_mem
  rintro ⟨a, b⟩ hab
  have splitDegree : a + b = t := Finset.mem_antidiagonal.mp hab
  by_cases ha : d < 3 * a
  · exact I.mul_mem_right _ (above_third mf hf ha (by omega))
  · exact I.mul_mem_left _ (above_third mg hg (by omega) (by omega))

private theorem high_operand (p : Program F σ n) (r : Ref F σ n) {d : ℕ} (hd : 2 ≤ d)
    (I : Ideal (MvPolynomial σ F)) (hp : ∀ i, High d I (p.run C X i)) :
    High d I (operand p r) := by
  cases r with
  | gate i => exact hp i
  | const c =>
    intro t ht _
    have h : t ≠ 0 := by omega
    simp [operand, Ref.read, homogeneousComponent_of_mem (isHomogeneous_C σ c), h]
  | var x =>
    intro t ht _
    have h : t ≠ 1 := by omega
    simp [operand, Ref.read, homogeneousComponent_of_mem (isHomogeneous_X F x), h]

private theorem high_gate (p : Program F σ n) (d : ℕ) (hd : 2 ≤ d)
    (I : Ideal (MvPolynomial σ F)) (generated : ∀ f ∈ gateValues p, Balanced d I f) :
    ∀ i, High d I (p.run C X i) := by
  induction p with
  | nil => exact fun i => i.elim0
  | snoc p op a b ih =>
    have prev : ∀ i, High d I (p.run C X i) :=
      ih (fun f hf => generated f (by simp [gateValues, hf]))
    have ha := high_operand p a hd I prev
    have hb := high_operand p b hd I prev
    intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simp only [Program.run, Fin.lastCases_last]
      change High d I (op.apply (operand p a) (operand p b))
      cases op with
      | add =>
        intro t ht htd
        simpa only [BinOp.apply, map_add] using I.add_mem (ha t ht htd) (hb t ht htd)
      | sub =>
        intro t ht htd
        simpa only [BinOp.apply, map_sub] using I.sub_mem (ha t ht htd) (hb t ht htd)
      | mul =>
        exact high_mul (generated _ (by simp [gateValues]))
          (generated _ (by simp [gateValues])) ha hb
    · simpa only [Program.run, Fin.lastCases_castSucc] using prev j

/-- For every original reference, each component of degree above two thirds through degree
`d` belongs to the ideal containing the balanced components of the program occurrences. -/
theorem high_ref_mem (p : Program F σ n) (r : Ref F σ n) (d : ℕ) (hd : 2 ≤ d)
    (I : Ideal (MvPolynomial σ F))
    (generated : ∀ g ∈ gateValues p, ∀ j, d < 3*j → 3*j ≤ 2*d →
      homogeneousComponent j g ∈ I)
    (t : ℕ) (ht : 2*d < 3*t) (htd : t ≤ d) :
    homogeneousComponent t (operand p r) ∈ I :=
  high_operand p r hd I (high_gate p d hd I generated) t ht htd

/-- The balanced-degree components of the actual circuit occurrences generate an ideal
containing the degree-`d` output. -/
theorem output_mem (c : Computability.VPVNP.Circuit F σ n) (d : ℕ) (hd : 2 ≤ d)
    (I : Ideal (MvPolynomial σ F))
    (generated : ∀ g ∈ gateValues c.program, ∀ j, d < 3*j → 3*j ≤ 2*d →
      homogeneousComponent j g ∈ I) :
    homogeneousComponent d c.polynomial ∈ I :=
  high_ref_mem c.program c.output d hd I generated d (by omega) (by omega)


end Hierarchy.CircuitSplit

end OAI
