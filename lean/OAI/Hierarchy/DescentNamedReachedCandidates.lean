local notation:max "fetch" gg:arg hx:arg hj:arg peers:arg h:arg gr:arg x:arg j:arg =>
  ((physicalRack (((h):Fin (A₁).hosts).cast peers)).bind (fun z=>
    candidateRows B (fieldNames B) ((((gr):Fin (A₁).groups).cast gg,z),((x):Fin (A₁).blocks).cast hx)
      (((j):Fin (2*(A₁).candidates)).cast (congrArg (2*·) hj))))

/-- The physical rack has one signed word for each field of each native argument. -/
theorem DateInputs.named_reached_candidate_sources (ready : (u).Ready) (after : Memory w)
    (hx : (A₁).blocks=2^k) (hj : (A₁).candidates=totalLocal B)
    (gg : (A₁).groups=S.groupCount (age+1)) (aligned : (A₁).hosts=(v).sheets.hosts)
    (archive : ∀i j,let whereAt:=(v).operandIndex (u).operand i
      Source ((v).previous (u).operand draw base₀ i j)
        (fun h gr=>ResetOutput.signedCandidateField (A₁).signedBits whereAt.2.1
          (fetch gg hx hj aligned h gr (whereAt.1) j)) (A₁).lanes ((u).operandEntry ready after))
    (arg : Fin (u).operand.slots) (block : Fin (A₁).blocks) (node : Fin (u).operand.nodes) :
    let raw:=fun (f₀ : Fin 7) (j : Fin (2*(A₁).candidates)) h gr=>
      ResetOutput.signedCandidateField (A₁).signedBits f₀ (fetch gg hx hj aligned h gr block j)
    (∀f₀ j,let i:=(v).operandOrdinal (u).operand f₀ arg block node
      Source ((v).previous (u).operand draw base₀ i j) (raw f₀ j) (A₁).lanes ((u).operandEntry ready after)) ∧
    (∀f₀ j h gr,((raw f₀ j h gr).val : Cell (A₁).valueBits)=
      ResetOutput.nativeCandidateField (A₁).signedBits (A₁).valueBits f₀ (fetch gg hx hj aligned h gr block j)):=by
  constructor
  · intro f₀ j
    simpa only [ResetOutput.operandIndex_ordinal] using archive ((v).operandOrdinal (u).operand f₀ arg block node) j
  · intro f₀ j h gr
    rfl

end
