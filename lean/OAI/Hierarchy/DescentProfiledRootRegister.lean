/-- Fresh physical gate selectors on the exact output of the selected reset.
Their source is the stencil packet seen by the original prefix archive. -/
theorem profiled_root_register (seed₁ : data 0)
    (placed₁ : ∀j (ev : RunTrace.Events traces j), RegisterTimeline.fitsAt traces menu initial (w:=w) j ev)
    (incoming : (evt).incoming cur history) (words : SnapshotWordRoom S n h k tail p f g payload w)
    (hw : (nextPath).whole p) (geo : data i) (space : support₁) (admitted : ready₁ geo.capacity space)
    (hn : n₁=n) (hh : h₁=h) (hf : f₁=f) (hg : g₁=g) (ht : tail₁=tail)
    (hb : HEq ctl.board board) (ho : RotorSpec.ofRates ctl=op)
    (degreeAt : (cur).ports.venue.degree=D) (capAt : r.placement.cap=capacity)
    (actorMem mid : Memory w)
    (origins : RegisterTimeline.MatchedPublicOriginsAt (input:=r) (ctl:=ctl) (f:=f) (g:=g) (tail:=tail) board op B p drift degree payload w (menu).ordinary
      cur space hn hh hf hg ht hb ho degreeAt admitted.1 history capAt actorMem)
    (first : (u₁ space).throughOperandDate.Runs atMem mid) :
    Nonempty (RootRegister B positive hw.2 (oldArchive hw) (rank₀ hw) (v).birth (z₁ geo space).guards
      ((z₁ geo space).classImage mid) rfl rfl rfl) :=by
  have ms:=profiled_original_measures (F:=F) (cp:=cp) (nP:=nP) (k:=k) (cut:=cut) (tail:=tail) (n:=n) (h:=h) (C:=C) (f:=f) (g:=g) (p:=p) (U:=U) (r:=r) (ctl:=ctl) X G S ordinary reset branch positive room shorten w fit drift degree
    payload lo header initial bus seedDegree degreeRoom walk m before B after_ joined seed₁ placed₁ incoming words
  have recorded : B.Recorded p := (profiled_reset_controls (r:=r) (ctl:=ctl) X G S ordinary reset branch positive room shorten walk before B after_ joined).1
  exact RegisterTimeline.root_from_measures (input:=r) (ctl:=ctl) (f:=f) (g:=g) (tail:=tail) board op B p drift degree payload w (menu).ordinary cur
    geo.capacity space recorded hn hh hf hg ht hb ho degreeAt admitted.1 history ms hw.2 (oldArchive hw)
    (rank₀ hw) admitted.2 mid actorMem first origins

end
