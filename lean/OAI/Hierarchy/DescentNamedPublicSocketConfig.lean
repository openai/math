private theorem cableCap_eq {n n' h : ℕ} (left : NonlinearExpanders.Graph n h)
    (right : NonlinearExpanders.Graph n' h) (height : ℕ) (dim : n=n') (eqv : HEq left right) :
    DescentResetCableSlots.cableCap left height = DescentResetCableSlots.cableCap right height :=by
  subst n'
  cases eq_of_heq eqv
  rfl

include accepted in
theorem DateInputs.fromNamed_public_socket_config (degreeAt : venue.degree=D)
    (capAt : input.placement.cap=cap) (gr : z=S.grainAt G.b p (age+1)) :
    HEq (u).atlas.board (Z).graph ∧
    publicOperands (u).atlas (u).roots (u).menu.payload =
      ClosedReset.Window.publicOperandConfig B field query M batches ((Z).unit/p) nodes args p :=by
  have graph₀ : HEq (u).atlas.board ctl.board :=HEq.rfl
  refine ⟨graph₀.trans B.graph.symm,?_⟩
  have privateSlots := cableCap_eq ctl.board (Z).graph (GroupStage.depthBound D n f g) B.dimension.symm B.graph.symm
  have residual := ClosedReset.Window.funded_residual B
  have units := ClosedReset.Window.funded_units B accepted gr
  have half : (2*cap)/2=cap :=by omega
  have native : publicOperands (u).atlas (u).roots (u).menu.payload =
      Chart.publicMenu ctl.board venue.degree k cap Ht field query M batches args nodes packet f C p :=by
    change Chart.publicMenu ctl.board venue.degree k ((2*cap)/2) Ht field query M batches args nodes packet f C p=_
    exact congrArg (fun sourceCap => Chart.publicMenu ctl.board venue.degree k sourceCap Ht field query M batches args nodes packet f C p) half
  refine native.trans ?_
  unfold ClosedReset.Window.publicOperandConfig ClosedReset.Window.flatConfig ClosedReset.Window.operandShape
  unfold Chart.publicMenu
  dsimp only [DescentResetCableSlots.cableCap] at privateSlots
  simp only [DescentResetCableSlots.cableCap, degreeAt, input.branch, capAt, residual,
    B.dimension, B.width, units, privateSlots]

