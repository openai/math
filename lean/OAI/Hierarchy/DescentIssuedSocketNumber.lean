local notation "pubCfg" => publicOperandConfig B field query lanes batches split nodes args grain


open DescentOperandStateBanks DescentResetOperandComponents DescentOperandCandidateLookup
open DescentDatedAddressBook.ResetOutput


theorem PublicSocket.query_live {host : Host} {word number size : ℕ} {tag : Bool}
    (socket : PublicSocket B host split word tag number) (enough : 2*totalLocal B<2^query)
    (arg : Fin (pubCfg).args) (node : Fin (pubCfg).nodes) (row : (pubCfg).Data B.reset.n)
    (hit : (pubCfg).mixed B.reset.graph node.val arg.val row=some (number,word,size,tag)) :
    (pubCfg).column B.reset.graph query none (finProdFinEquiv (arg,node)) row≠0:=by
  have npos : 0<number:=by rw [socket.address];omega
  have bound : number<2^query:=by
    rw [socket.address]
    have placed:=(Roster.addr A₁ ord₁ (blocks B) host (localRoster B host) socket.face).isLt
    omega
  intro empty
  have eqn:=congrArg Fin.val empty
  simp only [DescentResetPublicOperandBook.Config.column,Equiv.symm_apply_apply,hit,Fin.val_natCast,
    Nat.mod_eq_of_lt bound,Fin.val_zero] at eqn
  omega

end
