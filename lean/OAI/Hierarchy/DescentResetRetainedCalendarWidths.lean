import OAI.Hierarchy.DescentRetainedArgumentLimit
import OAI.Hierarchy.DescentResetRetainedDimensions
import OAI.Hierarchy.DescentResetRetainedPlacementChart
import OAI.Hierarchy.DescentOperandWidth
import OAI.Hierarchy.DescentResetDigits
import OAI.Hierarchy.DescentPackedWalshPrice

namespace OAI
/-! # Public capacities and lane exponents of the reset operand mixer -/
namespace Hierarchy.DescentSixParty
open DescentCompiler DescentPackedWalsh
noncomputable section
namespace AtomSchedule
variable {F : Type} [Field F] (S : DescentCompiler.AtomSchedule) (G : PoweredGadget F)

def retainedNodes := S.epochPower^S.localTokenExponent

/-- Both dimensions use the same closed token and operand exponents at every date. -/
theorem capacities_scale :
    (retainedNodes S) ≤ DescentCompiler.TerminalScale.scale S.height S.localTokenExponent ∧
    S.retainedArguments G ≤ DescentCompiler.TerminalScale.scale S.height (operandExponent G S) := by
  have power (j : ℕ) : (2^S.height)^j ≤ 2^(j*(S.height+1)) := by
    rw [← pow_mul, Nat.mul_comm S.height j]
    exact Nat.pow_le_pow_right (by decide : 0 < 2) (Nat.mul_le_mul_left _ (Nat.le_succ _))
  exact ⟨power _, power _⟩

/-- Drift pays for all scalar arguments generated by the flattened slices of one actual node. -/

theorem capacities_at_scale (drift C : ℕ) (room : drift+1≤DescentCompiler.TerminalScale.scale S.height C) :
    (retainedNodes S)≤DescentCompiler.TerminalScale.scale S.height S.localTokenExponent ∧
    S.retainedArgumentsAt G drift≤DescentCompiler.TerminalScale.scale S.height (C+operandExponent G S) :=by
  refine ⟨(capacities_scale S G).1,?_⟩
  rw [← DescentCompiler.TerminalScale.scale_mul]
  exact Nat.mul_le_mul room (capacities_scale S G).2

/-- One local receiver joins all previous per-node fields over its own donor fibre. -/
def retainedWidth (k tail drift degree p : ℕ) :=
  let s:=DescentOperandWidth.recordBits G S k tail drift degree p
  let nodes:=(retainedNodes S);let fields:=2+7*(S.retainedArgumentsAt G drift);let donors:=2^k
  let selectorBits:=donors*Nat.clog 2 (donors+1)
  max 1 (max (s*nodes) (max (s*donors+s) (max ((s*donors)*(fields*nodes)+s*donors) (s*donors+selectorBits))))

def retainedExponent (k tail drift degree p age h : ℕ) :=
  laneBits (S.groupWidth k tail age) h (retainedWidth S G k tail drift degree p)

/-- The stored matrix code acts on c+k bits. Its physical tile width can be
chosen for the operand schema independently of the earlier election's stencil. -/
def retainedCalendar (k tail drift degree p age h previousLanes : ℕ) : DescentResetRetainedSetup.Layout :=
  let c:=S.groupWidth k tail age;let e:=retainedExponent S G k tail drift degree p age h
  ⟨DescentOperandWidth.recordBits G S k tail drift degree p,S.hostSize age,S.groupCount age,2^k,
    (retainedNodes S),S.retainedArgumentsAt G drift,(retainedNodes S),S.retainedArgumentsAt G drift,previousLanes,2^e,c-e,e+k,c,2^e,2^e⟩

theorem retainedGeometry (k tail drift degree p age h previousLanes : ℕ)
    (base : S.baseGroups=2^tail) (radix : S.radix=2^k) (inRange : age<S.length) :
    let L:=retainedCalendar S G k tail drift degree p age h previousLanes
    L.high+L.low=S.groupWidth k tail age+k ∧ L.cut=S.groupWidth k tail (age+1)+k ∧
    2^(L.high+L.low)=L.groups*L.blocks ∧ 2^L.low=L.gatherLanes*L.blocks ∧
    L.cut≤L.high+L.low ∧ L.donors=2^k ∧ L.matrixLanes=L.gatherLanes ∧
    L.matrixLanes*L.donors=2^L.low ∧ L.grouped=S.groupCount (age+1)*L.blocks :=by
  let c:=S.groupWidth k tail age;let e:=retainedExponent S G k tail drift degree p age h
  have fit : e≤c:=Nat.min_le_left ..
  have dim : c-e+(e+k)=c+k:=by omega
  have past : 2^c=S.groupCount age:=S.group_power base radix age
  have cut : c=S.groupWidth k tail (age+1)+k:=S.group_cut inRange
  have rad : 2^(e+k)=2^e*2^k:=pow_add ..
  have left : 2^(c+k)=S.groupCount age*2^k:=by rw [pow_add,past]
  have group : 2^c=S.groupCount (age+1)*2^k:=by rw [cut,pow_add,S.group_power base radix]
  dsimp only [retainedCalendar,DescentResetRetainedSetup.Layout.donors,DescentResetRetainedSetup.Layout.matrixLanes,
    DescentResetRetainedSetup.Layout.grouped]
  change _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ (2^(c-e+(e+k)-c)=2^k) ∧ (2^(e+k)/2^(c-e+(e+k)-c)=2^e) ∧ _ ∧ _
  have d : c-e+(e+k)-c=k:=by omega
  rw [d]
  have strip : 2^(e+k)/2^k=2^e:=by rw [rad,Nat.mul_div_cancel _ (Nat.two_pow_pos _)]
  exact ⟨dim,cut,by rw [dim];exact left,rad,by omega,rfl,strip,by rw [strip,rad],group⟩

/-- A true seed has one node per occupied host and exactly three banks of argument slots.
These dimensions follow from the preceding calendar entry even when later caps are larger. -/
def retainedFromPrevious (k tail drift degree p age h previousNodes previousArgs previousLanes : ℕ) : DescentResetRetainedSetup.Layout :=
  { retainedCalendar S G k tail drift degree p age h previousLanes with previousNodes:=previousNodes, previousArgs:=previousArgs }

theorem previousGeometry (k tail drift degree p age h oldNodes oldArgs oldLanes : ℕ)
    (base : S.baseGroups=2^tail) (radix : S.radix=2^k) (inRange : age<S.length) :
    let L:=retainedFromPrevious S G k tail drift degree p age h oldNodes oldArgs oldLanes
    L.high+L.low=S.groupWidth k tail age+k ∧ L.cut=S.groupWidth k tail (age+1)+k ∧
    2^(L.high+L.low)=L.groups*L.blocks ∧ 2^L.low=L.gatherLanes*L.blocks ∧
    L.cut≤L.high+L.low ∧ L.donors=2^k ∧ L.matrixLanes=L.gatherLanes ∧
    L.matrixLanes*L.donors=2^L.low ∧ L.grouped=S.groupCount (age+1)*L.blocks :=
  retainedGeometry S G k tail drift degree p age h oldLanes base radix inRange

/-- A narrower predecessor, including the original seed, uses the same conservative
lane exponent and the same in-word lookup budget as the fixed epoch capacity. -/
theorem previousWidth (k tail drift degree p age h oldNodes oldArgs oldLanes : ℕ)
    (ns : oldNodes≤(retainedNodes S)) (args : oldArgs≤S.retainedArgumentsAt G drift)
    (base : S.baseGroups=2^tail) (radix : S.radix=2^k) (inRange : age<S.length) :
    let L:=retainedFromPrevious S G k tail drift degree p age h oldNodes oldArgs oldLanes
    L.wholeWord≤retainedWidth S G k tail drift degree p ∧
    L.siteWord+L.stripWord≤retainedWidth S G k tail drift degree p :=by
  let L:=retainedFromPrevious S G k tail drift degree p age h oldNodes oldArgs oldLanes
  let s:=DescentOperandWidth.recordBits G S k tail drift degree p
  have d : L.donors=2^k:=(previousGeometry S G k tail drift degree p age h oldNodes oldArgs oldLanes base radix inRange).2.2.2.2.2.1
  have wg : L.wholeWord≤ s*(retainedNodes S):=Nat.mul_le_mul_left _ ns
  have sg : L.siteWord+L.stripWord≤(s*2^k)*((2+7*(S.retainedArgumentsAt G drift))*(retainedNodes S))+s*2^k:=by
    change (s*L.donors)*((2+7*oldArgs)*oldNodes)+s*L.donors≤_
    rw [d];gcongr
  exact ⟨wg.trans ((Nat.le_max_left ..).trans (Nat.le_max_right ..)),
    sg.trans ((Nat.le_max_left ..).trans ((Nat.le_max_right ..).trans ((Nat.le_max_right ..).trans (Nat.le_max_right ..))))⟩

/-- Each streamed stripe is filtered and sorted by the entire true original donor directory. -/
theorem selector_width (k tail drift degree p age h oldNodes oldArgs oldLanes : ℕ)
    (base : S.baseGroups=2^tail) (radix : S.radix=2^k) (inRange : age<S.length) :
    let L:=retainedFromPrevious S G k tail drift degree p age h oldNodes oldArgs oldLanes
    L.stripWord+L.donors*Nat.clog 2 (L.donors+1)≤retainedWidth S G k tail drift degree p:=by
  intro L
  have d:= (previousGeometry S G k tail drift degree p age h oldNodes oldArgs oldLanes base radix inRange).2.2.2.2.2.1
  change L.bits*L.donors+L.donors*Nat.clog 2 (L.donors+1)≤_
  rw [show L.donors=2^k from d]
  exact (Nat.le_max_right ..).trans ((Nat.le_max_right ..).trans ((Nat.le_max_right ..).trans (Nat.le_max_right ..)))

end AtomSchedule
end
end Hierarchy.DescentSixParty
namespace Hierarchy.DescentCompiler.AtomSchedule
export Hierarchy.DescentSixParty.AtomSchedule
  (retainedNodes capacities_scale capacities_at_scale retainedWidth retainedExponent retainedCalendar
    retainedGeometry retainedFromPrevious previousGeometry previousWidth selector_width)
end Hierarchy.DescentCompiler.AtomSchedule

end OAI
