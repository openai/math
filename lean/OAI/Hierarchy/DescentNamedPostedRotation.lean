open DescentPacking.PackedMatch.Local.Stage DescentSixParty.Chronology
include accepted in
theorem DateInputs.fromNamed_posted_rotation (degreeAt : venue.degree=D) (ready : (u).Ready) (padDate : Chronology.NativePhase w) (calendar : ℕ→DateCode w) (boot : Memory w)
    (run : (u).FinalInputs) (fitted : run.Room)
    (gr : z=S.grainAt G.b p (age+1)) (fee : wire=S.epochPower^S.priceExponent)
    (capAt : input.placement.cap=cap) (history : hist=S.firstWidth G.b p) (branch : G.b≤2^S.capGain)
    (seen : stageVenue input input.valid.host io (v).funded.oldLanes (v).funded.precision floor
      (input.venueRoster input.valid.host) (padDate.image (DateCode.history calendar boot age))) (popFit : count.Fits w floor)
    (popRead : padDate.image (DateCode.history calendar boot age) count.base=(Fintype.card input.V:Word w))
    (wireRoom : ∀(x:DescentColonies.Block k)(j:Fin (2*input.placement.cap)),(io.wire x.val j.val).Fits w floor ∧
      HH*chunks (S.groupCount age) (v).funded.oldLanes≤(io.wire x.val j.val).size)
    (oldPos : 0<(v).funded.oldLanes) (oldWidth : (v).funded.precision=S.censusBits p)
    (entryFits : start<2^w) (low : k≤(E).low)
    (score : 3*(E).dim+((E).precision+Nat.clog 2 (E).hosts)+2≤w)
    (live : 0 < amp) (degreePos : 0 < 32*Nat.clog 2 (2*venue.degree))
    (headerBits : Nat.clog 2 ((E).dim+2)+((E).dim+S.censusBits p) ≤ w) (hostBits : HH < 2^w)
    (ranksFit : venue.degree*2^Ht < 2^w)
    (namesFit : DescentFallbackShapeTable.actorWordBits k (32*Nat.clog 2 (2*venue.degree)) g n ≤ w)
    (degFit : venue.degree+1 < 2^w) (laneRoom : 2^e ≤ w)
    (posted : calendar age=DateCode.withPriorArchive padDate (PhysicalReset.enterCode (a).ingress floor (u) run io))
    (padded : padDate.Runs (DateCode.history calendar boot age))
    (hubFit : io.hubs.Fits w floor)
    (atomFit : ∀x:Fin (2^(a).ingress.k),(io.atoms x.val).Fits w floor)
    (wireFit : ∀j:(a).ingress.signed.Slot,(io.wire j.1.val j.2.val).Fits w floor) :
    DateCode.history calendar boot (age+1) ((NativeDate.reset (F:=F) («P» := Unit) (a)).saved floor)=
      ((DescentExterior.matrixCode B.frame.basis).val:Word w) :=by
  let before:=DateCode.history calendar boot age
  let afterPad:=padDate.image before
  have authentic:=DateInputs.fromNamed_rotation_receipt accepted drift degree payload e previous M nextM
    oldLanes primitiveLanes printedBits venue io floor w fitsStencil fitsSigned fitsCut count previousMeta
    previousArguments initial prepared sceneRoom degreeAt ready afterPad gr fee capAt history branch seen popFit
    popRead wireRoom oldPos oldWidth entryFits low score live degreePos headerBits hostBits ranksFit namesFit degFit laneRoom
  obtain ⟨ingress,_⟩:=(a).ingress.any floor io.hubs (fun x=>io.atoms x.val) (fun j=>io.wire j.1.val j.2.val)
    afterPad hubFit atomFit wireFit entryFits
  obtain ⟨out,valid,_,_⟩:=PhysicalReset.date_any run ready fitted ((entry₀).image afterPad)
  have assembled : (DateCode.withPriorArchive padDate (PhysicalReset.enterCode (a).ingress floor (u) run io)).Runs before out := by
    intro P₀ R₀ K₀ machine
    exact Procedure.Exec.then padded (Procedure.Exec.then ingress valid) machine
  have whole : (calendar age).Runs before out := posted.symm ▸ assembled
  have last : DateCode.history calendar boot (age+1)=out:=(calendar age).nextMemory_eq whole
  rw [last]
  exact PhysicalReset.date_saved_basis (F:=F) (Pin:=Unit) run rfl ready fitted valid B.frame.basis (sh).dimension.symm authentic

end
