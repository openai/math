import OAI.LinearAlgebra.SpectralBooks.PortGraph.PlanarAssemblyIncidence
import OAI.LinearAlgebra.SpectralBooks.PortGraph.ReplacementEncoder
import OAI.LinearAlgebra.SpectralBooks.PortGraph.ReplacementUniform
import OAI.LinearAlgebra.SpectralBooks.PortGraph.RecordReplacementSmallShape

/-! # The rooted numbered map of a forward replacement

Number each assembled port by its position at its template role. The
local-to-global port equivalence preserves both internal darts and named
stubs. Consequently the forward decoration passes exactly the tests used
to read role tables, and its numbers are the numbers used by reconstruction.
-/

namespace OAI
namespace LinearAlgebra
namespace SpectralBooks

open OAI.MatrixMultiplication

noncomputable section
open scoped Classical

namespace PortGraph.ReplacementTemplate.Forward

universe u
variable {O J I : Type u} {T : J → ReplacementTemplate.{u,u,u}}
    [∀ j, Fintype (T j).Role] [∀ j, Fintype (T j).Wire] [∀ j, Fintype (T j).Stub]
    (tag : O ↪ J) (C : StubPairing (fun i => (T (tag i)).Stub))

/-- The consecutive numbering selected on every catalogue term, before
choosing the occurrences in a map. -/
abbrev PortOrder (T : J → ReplacementTemplate.{u,u,u})
    [∀ j, Fintype (T j).Wire] [∀ j, Fintype (T j).Stub] :=
  ∀ j (v : (T j).Role), LocalPort (T j) v ≃ Fin (Fintype.card (LocalPort (T j) v))

variable (num3 : PortOrder T) (degree : ∀ j v, Fintype.card (LocalPort (T j) v) ≤ 3)

/-- The four-slot lookup generated by the catalogue's consecutive numbers. -/
def slotOfOrders : Numbering T :=
  catalogueNumbering T fun a => (num3 a.1 a.2).toEmbedding.trans
    (Fin.castLEEmb ((degree a.1 a.2).trans (by decide : 3 ≤ 4)))

/-- Use the catalogue port orders in each selected occurrence. -/
def pieceNumbering : StubPairing.PieceNumbering (pieces (T := T) tag) :=
  fun i v => num3 (tag i) v

omit [∀ j, Fintype (T j).Stub] in
/-- Reading an actual port with the decoder's end names gives its internal
dart or named stub in the piece's local port equivalence. -/
theorem localPortEquiv_portRole (i : O) (v : (T (tag i)).Role) (p : (graph tag C).Port ⟨i,v⟩) :
    localPortEquiv T ⟨tag i,v⟩ (portRole tag C ⟨i,v⟩ p) =
      C.portEquiv (pieces (T := T) tag) i v p := by
  let P := pieces (T := T) tag
  let name : (Σ i, StubPairing.PieceDart P i) → End T
    | ⟨i,.inl (e,b)⟩ => .inl (⟨tag i,e⟩,b)
    | ⟨i,.inr s⟩ => .inr ⟨tag i,s⟩
  have hn (q : C.Edge P × Bool) : namedEnd tag C q = name (C.dartEquiv P q) := by
    rcases q with ⟨e | ⟨j,d⟩,b⟩ <;> rfl
  have readLocal (a : LocalPort (T (tag i)) v) :
      name ⟨i,StubPairing.piecePorts P i ⟨v,a⟩⟩ = (tagPort T (tag i) v a).val := by
    cases a <;> rfl
  have he : portRole tag C ⟨i,v⟩ p =
      (localPortEquiv T ⟨tag i,v⟩).symm (C.portEquiv P i v p) := by
    apply Subtype.ext
    exact (hn p.val).trans ((congrArg name (C.dartEquiv_port P i v p)).trans (readLocal _))
  exact (congrArg (localPortEquiv T ⟨tag i,v⟩) he).trans ((localPortEquiv T ⟨tag i,v⟩).apply_symm_apply _)

/-- The catalogue assembly rotation, using the incidence coordinates. -/
abbrev assemblyRotation [Fintype O] :=
  (C.assembleNumbering (pieces (T := T) tag) (pieceNumbering tag num3)).rotation

variable [Fintype O] [dec : DecidableEq (StubPairing.Vertex (pieces (T := T) tag))]
    (root : StubPairing.Vertex (pieces (T := T) tag))
    (reach : C.occurrenceGraph.ConnectedFrom root.1)

/-- The root is the marked role of the old root occurrence. The tree
structure of each catalogue term supplies its internal connectivity. -/
def asMap : RootedMap (StubPairing.Vertex (pieces (T := T) tag)) (C.Edge (pieces tag)) where
  graph := graph tag C
  root := root
  num := fun ⟨i,v⟩ => ((C.portEquiv (pieces tag) i v).trans (num3 (tag i) v)).trans
    (finCongr (Fintype.card_congr (C.portEquiv (pieces tag) i v)).symm)
  degree := fun ⟨i,v⟩ => (Fintype.card_congr (C.portEquiv (pieces tag) i v)).le.trans
    ((degree (tag i) v).trans (by decide))
  connected := C.assemble_connected (pieces tag) root.2 reach
    (fun i => ⟨(T (tag i)).root,(T (tag i)).tree.connected⟩)

local notation "M" => asMap tag C num3 degree root reach
local notation "L" => label (T := T) tag
local notation "slots" => slotOfOrders num3 degree

/-- The turn permutation is the one used by the assembly sphericity theorem,
independently of the implementation of vertex equality. -/
theorem asMap_turn : (M).num.turn = (assemblyRotation tag C num3).turn := by
  let fixed : DecidableEq (StubPairing.Vertex (pieces (T := T) tag)) :=
    @Sigma.instDecidableEqSigma O (fun i => (pieces (T := T) tag i).Vertex)
      (fun _ _ => Classical.propDecidable _) (fun _ _ _ => Classical.propDecidable _)
  obtain rfl : dec = fixed := Subsingleton.elim _ _
  rfl

theorem asMap_spherical [DecidableEq (C.Edge (pieces (T := T) tag))] (h : (assemblyRotation tag C num3).picture.GenusZero) :
    (M).Spherical := by
  have he : (M).num.rotation = assemblyRotation tag C num3 := by
    cases hrot : (M).num.rotation with
    | mk a ha =>
      cases hold : assemblyRotation tag C num3 with
      | mk b hb =>
        have ht := asMap_turn tag C num3 degree root reach
        change (M).num.rotation.turn = _ at ht
        rw [hrot,hold] at ht
        cases ht
        rfl
  change (M).num.rotation.picture.GenusZero
  rw [he]
  exact h

theorem asMap_slot_val (v : StubPairing.Vertex (pieces (T := T) tag)) (p : (graph tag C).Port v) :
    ((M).num v p).val = (slots _ (portRole tag C v p)).val := by
  obtain ⟨i,v⟩ := v
  change ((num3 (tag i) v) (C.portEquiv (pieces (T := T) tag) i v p)).val =
    ((num3 (tag i) v) (localPortEquiv T ⟨tag i,v⟩ (portRole tag C ⟨i,v⟩ p))).val
  exact congrArg (fun x : LocalPort (T (tag i)) v => (num3 (tag i) v x).val)
    (localPortEquiv_portRole tag C i v p).symm

theorem actualSlots_asMap : actualSlots (M) = numbering tag C slots := by
  funext v
  apply Function.Embedding.ext
  intro p
  exact Fin.ext (asMap_slot_val tag C num3 degree root reach v p)

/-- Both sides of every wire use the number of the actual named template end. -/
theorem asMap_portNumber (e : C.Edge (pieces (T := T) tag)) (b : Bool) :
    (M).portNumber e b = (endNumber slots (namedEnd tag C (e,b))).val := by
  let p : (graph tag C).Port ((graph tag C).vertex e b) := ⟨(e,b),rfl⟩
  have number {a : RoleLabel T} (u : RolePort T a) : slots a u = endNumber slots u.val := by
    obtain ⟨u,rfl⟩ := u
    rfl
  exact (asMap_slot_val tag C num3 degree root reach _ p).trans
    (congrArg Fin.val (number (portRole tag C _ p)))

/-- The concrete smaller map with its forward assignment of roles passes
the same vertex, root and paired-wire tests used by the uniform tables. -/
theorem asMap_accepts (R : LocalRules (I := I) T) (hslot : R.slot = slots)
    (records : ∀ i, R.recordOK (tag i)) (mark : ∀ v, R.marked (L v) ↔ v = root)
    (orient : ∀ e b, (T (tag (C.ends (e,b)).1)).direction (C.ends (e,b)).2 = b)
    (distinct : Function.Injective (R.patchId ∘ tag))
    (old : ∀ e : C.Wire, R.oldEdge (liftTag tag _ (C.ends (e,false))) (liftTag tag _ (C.ends (e,true)))) :
    R.Accepts (M) L := by
  refine ⟨fun v => records v.1,mark,?_⟩
  have eqNum : actualSlots (M) = numbering tag C R.slot := by rw [hslot,actualSlots_asMap]
  change ∃ hv : ∀ v, VertexTest T (actualSlots (M)) R.slot L v,
    ∀ e, PairTest R.patchId R.oldEdge (readEnd hv e false) (readEnd hv e true)
  rw [eqNum]
  exact ⟨vertexTests tag C R.slot orient,edgeTests tag C R.slot orient R.patchId R.oldEdge distinct old⟩

end PortGraph.ReplacementTemplate.Forward

end

end SpectralBooks
end LinearAlgebra
end OAI
