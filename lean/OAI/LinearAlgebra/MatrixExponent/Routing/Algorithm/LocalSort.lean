import OAI.LinearAlgebra.MatrixExponent.Routing.Algorithm

/-!
# The local sorting protocol with charged advice

The manuscript fixes the finite field, geometric dimensions, a finite
collection of core generators, local price tests and replacement
tables. Its permutation functions are generated by single programs
across all heights. Here the group also admits fixed permutations
specified separately at each height. The proof stores the packing
charts, constant permutations, dummy matching labels and finite local
decisions as literals and instructions of a height-dependent program.
The input-independent group list is also charged. The same evaluator
runs this advice for every selector, valid tag list and record width.
No bound on generating the advice or countability assertion for this
larger group is used. The field-valued entries of the local trivalent
networks are separate from the controller.
-/

noncomputable section
namespace OAI.LinearAlgebra.MatrixExponent.Routing.Algorithm
open Coloring Transport
open scoped Classical

/-- Advice, working memory and word operations are bounded uniformly
in the payload width. Inactive selectors may be omitted by
`permutation_sum`. -/
theorem deterministic_protocol (F : Type) [Field F] [Finite F] (hs : omega F < 9 / 4)
    (τ : ℝ) (ht : 0 < τ) :
    ∃ (m p q l r c D b : ℕ) (gen : B p → Fin r),
      2 ≤ m ∧ (∀ h : ℕ, (↑(h / m) : ℝ) ≤ τ * h) ∧
      ∀ᶠ h in Filter.atTop,
        ∃ (code : Program h p q l) (group : Port h p → ℕ)
          (step : Equiv.Perm (B h) → Fin r → Equiv.Perm (Site h)),
        (∀ i, group i < 2 ^ (h + 2)) ∧
        (∀ i, (Finset.univ.filter (fun k => group k = i)).card ≤ 2 ^ (h / m + b)) ∧
        max (3 * (h + 1) + 10) (max l (max q p)) ≤ (2 * c + 10) * h ∧
        code.time + 2 ^ (h + 1) * (64 + 32 * 2 ^ p) ≤ 2 ^ h * (100 + h) ^ c ∧
        code.advice + code.scratch + 2 ^ (h + 1) * (64 + 32 * 2 ^ p) ≤ 2 ^ h * (100 + h) ^ c ∧
        2 ^ h * (100 + h) ^ c ≤ 2 ^ ((2 * c + 10) * h) ∧
        (∀ (σ : Equiv.Perm (B h)) (z : Site h → B q) (i : Port h p),
          let a := commands (code.eval (σ, z))
          let j := (a i).2.2
          i ∈ Enabled a → gen i.2 = gen j.2 ∧
            (step σ (gen i.2) i.1 = j.1 ∨ (step σ (gen i.2)).symm i.1 = j.1)) ∧
        ∀ w ≥ h, ∃ (n : ℕ) (f : Kernel F p l w n),
          0 < n ∧ n ≤ 2 * w ∧
          let S := network code group f
          S.selector.width = 2 ^ (h + 1) * q ∧ S.Correct 9624 ∧
            Install.Weight F S.localWeight (w * (100 + Nat.clog 2 w) ^ D) := by
  obtain ⟨m, T, s, P, c, D, hm, rate, all⟩ := protocol_of_saving hs τ ht
  let e := Fintype.equivFin ↥T.params.core
  let gen := e ∘ s.bank.generator T.params.unit
  refine ⟨m, s.p, s.clock.bits, P.l, _, c, D, T.overhead + s.p, gen, hm, rate, ?_⟩
  filter_upwards [all] with h H
  obtain ⟨A⟩ := H
  let step (σ : Equiv.Perm (B h)) (j : Fin (Fintype.card ↥T.params.core)) : Equiv.Perm (Site h) :=
    letI := T.action h σ
    MulAction.toPerm (e.symm j).val
  refine ⟨A.code, A.group, step, A.group_word, ?_, A.words, A.time, A.memory, A.addresses, ?_, ?_⟩
  · simpa only [Nat.add_assoc] using A.capacity
  · intro σ z i a j hi
    obtain ⟨he, hg⟩ := A.resolves.hop σ z i hi
    refine ⟨congrArg e he, ?_⟩
    simp only [step, gen, Function.comp_apply, Equiv.symm_apply_apply]
    exact hg
  · intro w hw
    obtain ⟨j, _, _, bound, ok, hsize⟩ := A.widths w hw
    let S := (systemOf T s P A.code.eval A.group j).pad w
    have hu : 2 ^ j ≤ s.clock.width * 2 ^ j := Nat.le_mul_of_pos_left _ (by have := s.clock.wide; omega)
    exact ⟨2 ^ j, S.kernel, by positivity, hu.trans bound, selector_bits T s h, ok, hsize⟩

end OAI.LinearAlgebra.MatrixExponent.Routing.Algorithm
