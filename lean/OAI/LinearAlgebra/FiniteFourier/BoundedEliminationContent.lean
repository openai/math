import OAI.LinearAlgebra.FiniteFourier.ProtectedRationals
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Data.Matrix.Basic

/-! # Primitive part of an integral matrix

The ideal of entries of a nonzero matrix over a PID has a generator. Dividing
out this common factor leaves entries which generate the unit ideal. -/

namespace OAI
namespace LinearAlgebra
namespace FiniteFourier

/-- Divide a finite nonzero matrix over a PID by a generator of its ideal of entries. -/
theorem exists_primitive_matrix_part {R I J : Type*} [CommRing R] [IsDomain R]
    [IsPrincipalIdealRing R] [Fintype I] [Fintype J] (M : Matrix I J R) (hM : M ≠ 0) :
    ∃ (a : R) (N : Matrix I J R), M = a • N ∧
      Ideal.span (Set.range (fun ij : I × J => N ij.1 ij.2)) = ⊤ := by
  classical
  let f (ij : I × J) := M ij.1 ij.2
  let K := Ideal.span (Set.range f)
  let a := Submodule.IsPrincipal.generator K
  have hd (ij : I × J) : a ∣ f ij :=
    (Submodule.IsPrincipal.mem_iff_generator_dvd K).mp (Ideal.subset_span ⟨ij, rfl⟩)
  choose q hq using hd
  let N : Matrix I J R := fun i j => q (i, j)
  have he : M = a • N := Matrix.ext fun i j => hq (i,j)
  have ha : a ≠ 0 := by
    intro h
    exact hM (by simpa [h] using he)
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp (Submodule.IsPrincipal.generator_mem K)
  refine ⟨a, N, he, (Ideal.eq_top_iff_one _).mpr (Ideal.mem_span_range_iff_exists_fun.mpr ⟨c, ?_⟩)⟩
  apply mul_left_cancel₀ ha
  rw [mul_one, Finset.mul_sum]
  calc
    _ = ∑ i, c i * f i := Finset.sum_congr rfl fun i _ => by rw [hq i]; dsimp [N]; ring
    _ = a := hc

/-- An ideal of protected rationals is generated by the generator of its
contraction to the integers. Each reduced denominator is a unit. -/
theorem isPrincipalIdealRing_protectedRationals (L : Finset ℕ) :
    IsPrincipalIdealRing (protectedRationals L) where
  principal I := by
    let A := protectedRationals L
    let J := I.comap (Int.castRingHom A)
    let z := Submodule.IsPrincipal.generator J
    have hz : (z : A) ∈ I := Submodule.IsPrincipal.generator_mem J
    refine ⟨(z : A), le_antisymm (fun x hx => ?_) ((Ideal.span_singleton_le_iff_mem _).mpr hz)⟩
    have hx' : x * ((x : ℚ).den : A) = ((x : ℚ).num : A) :=
      Subtype.ext (Rat.mul_den_eq_num x.val)
    have hnum : (x : ℚ).num ∈ J := by
      change ((x : ℚ).num : A) ∈ I
      rw [← hx']
      exact I.mul_mem_right _ hx
    obtain ⟨k, hk⟩ := (Submodule.IsPrincipal.mem_iff_generator_dvd J).mp hnum
    apply ((Ideal.span {(z : A)}).mul_unit_mem_iff_mem
      (isUnit_natCast_protectedRationals (Rat.den_ne_zero _) x.property)).mp
    rw [hx', Ideal.mem_span_singleton, hk, Int.cast_mul]
    exact dvd_mul_right ..

end FiniteFourier
end LinearAlgebra
end OAI
