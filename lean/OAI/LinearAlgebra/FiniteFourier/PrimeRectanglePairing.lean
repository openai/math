import OAI.LinearAlgebra.FiniteFourier.PrimeBitRectangles
import Mathlib.LinearAlgebra.Matrix.BilinearForm
import Mathlib.LinearAlgebra.BilinearForm.Orthogonal

/-! # The finite pairing and target spaces for bit rectangles

Each label determines a unit-norm vector. On a rectangle of distance
nonzero modulo the routing prime, all source vectors annihilate the span of
the target vectors. The orthogonal complement of that span is annihilated
by every target vector.
-/

namespace OAI
namespace LinearAlgebra
namespace FiniteFourier

noncomputable section
section

/-- A finite-dimensional realization of the routing Gram matrix over the prime field. -/
structure BitRoutingGeometry (ℓ L b : ℕ) [Fact ℓ.Prime] where
  D : ℕ
  dim_bound : D ≤ 1 + (1 + L * 2 ^ b) ^ (ℓ - 1)
  form : LinearMap.BilinForm (ZMod ℓ) (Fin D → ZMod ℓ)
  symm : form.IsSymm
  nondegenerate : form.Nondegenerate
  vector : BitLabel L b → Fin D → ZMod ℓ
  pair (v w : BitLabel L b) :
    form (vector v) (vector w) =
      routingGram ℓ L (2 ^ b) (bitLabelIndex L b v) (bitLabelIndex L b w)

/-- The feature expansion gives a symmetric nondegenerate form of the stated dimension. -/
def bitRoutingGeometry (ℓ L b : ℕ) [Fact ℓ.Prime] : BitRoutingGeometry ℓ L b :=
  Classical.choice <| by
    obtain ⟨D, hD, a, d, _, hpair, hsep⟩ := exists_routing_gram_vectors ℓ L (2 ^ b)
    let B := Matrix.toBilin' (Matrix.diagonal a)
    have eval (x y : Fin D → ZMod ℓ) : B x y = ∑ i, a i * x i * y i := by
      simp [B, Matrix.toBilin'_apply', dotProduct, Matrix.mulVec_diagonal,
        mul_assoc, mul_left_comm]
    have symm : B.IsSymm := ⟨fun x y => by simp [eval, mul_right_comm]⟩
    have sep : B.SeparatingLeft := fun x hx => hsep x fun y => (eval x y).symm.trans (hx y)
    exact ⟨⟨D, hD, B, symm, ⟨sep, fun y hy => sep y fun x => (symm.eq y x).trans (hy x)⟩,
      fun v => d (bitLabelIndex L b v), fun v w => (eval _ _).trans (hpair _ _)⟩⟩

namespace BitRoutingGeometry

variable {ℓ L b : ℕ} [Fact ℓ.Prime] (G : BitRoutingGeometry ℓ L b)

@[simp] theorem vector_self (v : BitLabel L b) : G.form (G.vector v) (G.vector v) = 1 := by
  rw [G.pair, routingGram_self]

/-- The subspace generated by the target vectors of a rectangle. -/
def targetSpan (R : BitRectangle L b) : Submodule (ZMod ℓ) (Fin G.D → ZMod ℓ) :=
  Submodule.span (ZMod ℓ) (G.vector '' bitTargets R)

theorem target_mem_targetSpan {R : BitRectangle L b} {w : BitLabel L b} (ht : w ∈ bitTargets R) :
    G.vector w ∈ G.targetSpan R :=
  Submodule.subset_span ⟨w, ht, rfl⟩

/-- Source functionals vanish on the target span for free rectangles. -/
theorem targetSpan_le_sourceKer (R : BitRectangle L b) (hd : ¬ℓ ∣ bitCutDistance R.1)
    {v : BitLabel L b} (hs : v ∈ bitSources R) :
    G.targetSpan R ≤ LinearMap.ker (G.form (G.vector v)) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨w, ht, rfl⟩
  exact (G.pair v w).trans (routingGram_bitRectangle_eq_zero R hd hs ht)

/-- Each target functional vanishes on the orthogonal complement of the target span. -/
theorem orthogonal_targetSpan_le_targetKer (R : BitRectangle L b)
    {w : BitLabel L b} (ht : w ∈ bitTargets R) :
    (G.targetSpan R).orthogonalBilin G.form ≤ LinearMap.ker (G.form (G.vector w)) :=
  fun _ hx => hx _ (G.target_mem_targetSpan ht)

end BitRoutingGeometry
end

end

end FiniteFourier
end LinearAlgebra
end OAI
