import OAI.Optimization.LinearProgramming.PriceGame.MomentTrial
import OAI.Optimization.LinearProgramming.PriceGame.MomentGroups

/-! ## Section 5, the exponential moment of a recursive trial -/

namespace OAI
namespace Optimization
namespace LinearProgramming
namespace PriceGame
namespace Moment

open Finset

def sigmaQ : ℚ := 1 / 2 ^ 272
def scaleQ : ℚ := 2 / sigmaQ

@[simp] theorem sigmaQ_cast : (sigmaQ : ℝ) = sigma := by
  simp [sigmaQ, sigma]

@[simp] theorem scaleQ_cast : (scaleQ : ℝ) = scale := by
  simp [scaleQ, scale]

/-- The exponential moment of Section 5 (equation (5.4)). This covers every adaptive
transcript, including one generated by
inconsistent labels. Replaying the rational gains and every child's scores gives the
same integer output as the ceiling in the manuscript. -/
theorem Trial.moment {E : Type*} [Fintype E] (tr : Trial E probes) (w : E → ℝ)
    (hw : ∀ e, 0 ≤ w e) (ha : tr.Admissible scaleQ sigmaQ eta w) :
    (∑ e, w e * (2 : ℝ) ^ tr.score scaleQ sigmaQ e) ≤ (2 : ℝ) ^ tau * ∑ e, w e := by
  apply Trial.moment_of_groups scaleQ sigmaQ eta tau tau_pos.le _ _ tr w hw ha
  · intro w g hw hg hbal
    simpa only [scaleQ_cast, sigmaQ_cast] using local_rounded_moment w g hw hg hbal
  · intro w s hw hstep
    simpa only [scaleQ_cast, sigmaQ_cast, Nat.cast_mul, Nat.cast_ofNat] using
      deep_rounded_moment w s hw hstep

/-- At an internal node market balance on each coordinate gives score admissibility
for arbitrary signs reported by the label oracle, including arbitrary ties. -/
theorem Trial.node_admissible_of_allocation {E I : Type*} [Fintype E] [Fintype I] {r : ℕ}
    (C σ : ℚ) (η : ℝ) (mask : E → Bool) (w : E → ℝ)
    (gain : Fin r → E → ℚ) (children : Fin (2 * r) → Trial E r)
    (allocation : Fin r → E → I → ℝ) (sign : E → ℝ) (label : Fin r → I → ℝ)
    (hsign : ∀ e, |sign e| = 1) (hlabel : ∀ t i, |label t i| = 1)
    (hnn : ∀ t e i, 0 ≤ allocation t e i)
    (hmass : ∀ t e, ∑ i, allocation t e i ≤ 1)
    (hgain : ∀ t : Fin r, ∀ e, (gain t e : ℝ) = allocationGain (allocation t) sign (label t) e)
    (hbal : ∀ t : Fin r, ∀ i, ∑ e, localWeight η (localPart mask w) (gainAt gain) t e *
      sign e * allocation t e i = 0)
    (hchildren : ∀ t : Fin (2 * r), (children t).Admissible C σ η
      (deepWeight (deepPart mask w) (childScoreAt C σ children) t)) :
    (Trial.node mask gain children).Admissible C σ η w := by
  refine ⟨?_, ?_, hchildren⟩
  · intro t ht e
    let k : Fin r := ⟨t, ht⟩
    have he : gainAt gain t e = allocationGain (allocation k) sign (label k) e := by
      simpa only [gainAt, probeAt, dite_eq_left ht, k] using hgain k e
    rw [he]
    exact allocationGain_abs_le_one e (hnn k e) (hsign e) (hlabel k) (hmass k e)
  · intro t ht
    let k : Fin r := ⟨t, ht⟩
    have he (e : E) : gainAt gain t e = allocationGain (allocation k) sign (label k) e := by
      simpa only [gainAt, probeAt, dite_eq_left ht, k] using hgain k e
    simp_rw [he]
    exact allocationGain_balanced _ (allocation k) sign (label k) (hbal k)

end Moment
end PriceGame
end LinearProgramming
end Optimization
end OAI
